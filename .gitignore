# out-of-source build directories
build-linux/
build-*/
/Testing/
build-macos/
build-macos-rel/
build-mcp/
build-tsan/
# the second, UNSANITIZED configure the scene-graph benchmark's numbers must be
# taken in (tests/benchmarks/baseline-linux.json's `config` block names it)
build-bench/
build-media/
build/

# macOS packaging output (scripts/make-macos-bundle.sh)
dist/

# local tooling
compile_commands.json
.clangd

# clangd index — never track
.cache/

# Claude Code local state (agents/ may be shared deliberately later; local files never)
.claude/settings.local.json

# runtime output when the binary is run from the tree
jahsettings.ini
jahshaka-ogre.log
*.log
build-web/
/.claude/worktrees/
/.claude/scratch/
__pycache__/

# an agent's Xvfb pidfile lives in the worktree root (the rig law): never dirt, never committed
*.pid
# A SCREENSHOT AT THE TREE'S ROOT (PHOTON-7 stage 11, measured: an app run by hand from the root - its cwd - wrote
# editor.screenshot's relative PNGs there, the build stamped DIRTY at its next BUILT_FROM, and every spec.sh record of the
# next 2.5 h of card time was dropped as a dirty build's): never dirt, never committed. No tracked file is a root PNG.
/*.png

# THE DEMO SCENES (owner 2026-10-12): Bistro, San Miguel, Namaqualand are PROJECTS built into a data root from
# ~/Downloads/demo-scenes (3 GB of ORCA / Poly Haven sources) — never in the tree, never on GitHub; the tracked
# scenes/tools/make_demo_*.js + prep tools are the only demo-scene files the repo holds
/scenes/*[Bb]istro*
/scenes/*[Ss]an*[Mm]iguel*
/scenes/*[Nn]amaqualand*
/samples/*[Bb]istro*
Bistro_v5_2/
demo-scenes/
demo-prepared/
