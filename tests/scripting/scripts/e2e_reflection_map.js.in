// scripting.e2e.reflection_map — the PER-MATERIAL REFLECTION CUBEMAP
// (MATERIAL_GAPS_SPEC ADDENDUM A-5).
//
// The scene's reflection is global: one cube bound to every PBS material at
// once. This row overrides it for ONE material. So the test is a two-sphere
// one, as the spec describes it — bind the override on the hero, leave the
// control alone, and assert the hero's pixel MOVED while the control's did
// not. Absolute colours are deliberately not asserted (the image is a
// photograph of a sky); "this material stopped sampling the global cube and
// started sampling mine" is the whole claim.
//
// AND THE FENCE, which is the reason A-5 is one function and not two: while
// automatic PCC is bound (the VCT+Probes hybrid — the DEFAULT of a new
// project), the renderer's single environment slot holds a cube ARRAY and a
// manual cubemap makes the generated shader uncompilable. The override must go
// DARK with the global one, silently and without a shader failure. That is
// asserted here by switching the hybrid on with the override bound.
//
// Engine UP (no --headless): a document assertion cannot tell whether the
// renderer bound anything.

function assert(cond, msg) {
    if (!cond) throw new Error("assert failed: " + msg);
    console.log("ok: " + msg);
}
function mustThrow(fn, msg) {
    var threw = false;
    try { fn(); } catch (e) { threw = true; }
    assert(threw, msg);
}
function show(tag, c) { return tag + " (" + c.r + "," + c.g + "," + c.b + ")"; }
function dist(a, b) {
    return Math.abs(a.r - b.r) + Math.abs(a.g - b.g) + Math.abs(a.b - b.b);
}

var equirect = "@SOURCE_DIR@/app/content/skies/vp_sky_v3_047.jpg";
var guid = project.create("Reflection Map " + Date.now());
assert(guid.length > 10, "project.create");

// GI OFF FIRST. A new project is on the VCT+Probes hybrid, where NO manual
// cubemap can be bound at all — the global one included. The fence at the end
// of this file turns it back on and asserts exactly that.
assert(world.gi({ mode: "off" }) === true, "GI off (a manual cubemap needs the probe slot free)");
assert(world.giStatus().pccBound === false, "and PCC is not bound");

// AN ENCLOSURE, BECAUSE THE FENCE AT THE END NEEDS A PROBE GRID (owner probe
// rule, 2026-09-13): the renderer measures the enclosure out of the scene's own
// LAYOUT and builds no probes in a scene it reads as open. This suite used to
// say where the space was by PINNING the lit volume, and that pin is gone
// (owner decision D8), so the two spheres stand in a room for real. It is
// invisible to everything before the fence — with GI off a metal sphere samples
// the environment cube, not the walls — and the walls are neutral, so the
// fence's blue-cast comparison is untouched.
(function buildRoom(half, height) {
    var ids = scene.nodes();
    for (var i = 0; i < ids.length; ++i)
        if (ids[i].name === "Ground") node.setProperty(ids[i].id, "visible", false);
    function slab(name, px, py, pz, sx, sy, sz) {
        var id = scene.addPrimitive("cube", { position: { x: px, y: py, z: pz } });
        node.setProperty(id, "name", name);
        node.transform(id, { scale: { x: sx / 2, y: sy / 2, z: sz / 2 } });
    }
    var w = half * 2;
    slab("Floor", 0, -0.25, 0, w, 0.5, w);
    slab("Roof",  0, height + 0.25, 0, w, 0.5, w);
    slab("WallW", -half, height / 2, 0, 0.5, height, w);
    slab("WallE",  half, height / 2, 0, 0.5, height, w);
    slab("WallS", 0, height / 2, -half, w, height, 0.5);
    slab("WallN", 0, height / 2,  half, w, height, 0.5);
})(8, 6);

// Two spheres, each with its OWN material instance (a primitive gets a fresh
// one), mirror-smooth metal so what they draw IS the reflection.
var hero    = scene.addPrimitive("sphere", { position: { x: -1.5, y: 1, z: 0 } });
var control = scene.addPrimitive("sphere", { position: { x:  1.5, y: 1, z: 0 } });
var both = [hero, control];
for (var i = 0; i < both.length; ++i)
    assert(material.set(both[i], { metallic: 1, roughness: 0.05 }) === true,
           "a mirror-smooth metal sphere");

// ---- the row exists and is writable ------------------------------------
assert(material.properties(hero).writableKeys.indexOf("reflectionMap") >= 0,
       "reflectionMap is a writable key");
var row = null;
var rows = material.properties(hero).rows;
for (var r = 0; r < rows.length; ++r) if (rows[r].name === "reflectionMap") row = rows[r];
assert(row !== null && row.type === "texture",
       "the panel gets a texture row for it, like every other map");
assert(material.get(hero).reflectionMap === "",
       "and it is EMPTY by default (the material samples the scene's global cube)");

// ONE SPHERE PER SHOT, each framed the same way, so the probe lands on the
// same part of the same shape every time and the two are directly comparable.
// y = 0.35 is the sphere's upper half — where a sky reflection lives; the
// centre pixel reflects the ground and is black in either case.
//
// EVERY SHOT IS SETTLED, AND THAT IS THE WHOLE POINT OF THIS FUNCTION.
// A screenshot is the editor's own picture (SS1): it is graded at the
// VIEWPORT'S MEASURED EXPOSURE, and that measurement is an adaptation history
// which moves for as long as the picture is moving. This scene is re-framed
// onto a different sphere before every probe, so the history is always
// travelling when the shot is taken — and it advances by FRAMES, not by wall
// clock (the engine runs Ogre's controllers in frame-delay mode at a fixed
// 1/60 s, Engine::kDefaultFrameDelta). A fixed `editor.frame(4)` therefore
// bought four frames of adaptation on a quiet box and four frames on a loaded
// one, but the shot it fed was compared against shots taken from a different
// distance away — which is why the "blue cast (sanity)" threshold below redded
// in every gate on 2026-09-11 and passed 3/3 solo.
//
// So the shot is repeated until the PROBE ITSELF HOLDS STILL. Two consecutive
// reads within `settledWithin` levels is converged; the loop is capped so a
// genuinely unstable picture fails an assertion instead of hanging. On a quiet
// box this costs one extra iteration.
var settledWithin = 2;   // summed |dr|+|dg|+|db|, out of 255 per channel
var settleTries   = 20;
function probeOf(node, name) {
    editor.select(null);
    editor.frameNode(node, { yaw: 0, pitch: 10, distance: 3 });
    var previous = null, probe = null;
    for (var t = 0; t < settleTries; ++t) {
        editor.frame(4);
        probe = editor.screenshot(name, 256, 256, [{ x: 0.5, y: 0.35 }]).probes[0];
        if (previous !== null && dist(previous, probe) <= settledWithin) {
            if (t > 1) console.log("    (" + name + " settled after " + ((t + 1) * 4) + " frames)");
            return probe;
        }
        previous = probe;
    }
    console.log("    WARNING: " + name + " never settled in " +
                (settleTries * 4) + " frames — last " + show("probe", probe));
    return probe;
}

var h0 = probeOf(hero, "reflection_hero_before.png");
var c0 = probeOf(control, "reflection_control_before.png");
console.log("    " + show("HERO before", h0) + " " + show("CONTROL before", c0));
assert(dist(h0, c0) <= 6, "the two spheres start identical (" + dist(h0, c0) + ")");

// ---- bind the override --------------------------------------------------
assert(material.set(hero, { reflectionMap: equirect }) === true,
       "material.set({reflectionMap: <equirect image>})");
assert(material.get(hero).reflectionMap === equirect, "the row holds the image");

var h1 = probeOf(hero, "reflection_hero_after.png");
var c1 = probeOf(control, "reflection_control_after.png");
console.log("    " + show("HERO after", h1) + " " + show("CONTROL after", c1));
assert(dist(h0, h1) > 12,
       "the HERO sphere's reflection changed (" + dist(h0, h1) + ")");
assert(dist(c0, c1) <= 6,
       "the CONTROL sphere is untouched — the override is PER MATERIAL (" +
       dist(c0, c1) + ")");

// ---- clearing it goes back to the global cube ---------------------------
assert(material.set(hero, { reflectionMap: "" }) === true, "clear the override");
var h2 = probeOf(hero, "reflection_hero_cleared.png");
console.log("    " + show("HERO cleared", h2));
assert(dist(h2, h0) <= 6, "clearing it puts the global reflection back (" + dist(h2, h0) + ")");

// ---- refusals -----------------------------------------------------------
mustThrow(function () { material.set(hero, { reflectionMap: "/no/such/image.jpg" }); },
          "a path that is not a file and not an asset is refused");

// ---- THE PCC FENCE ------------------------------------------------------
assert(material.set(hero, { reflectionMap: equirect }) === true, "bind it again");
var lit = probeOf(hero, "reflection_hero_rebound.png");
assert(dist(lit, h0) > 12, "and it is on screen again");

app.engineErrors(true);   // reset the pump: what follows must add nothing
// The hybrid builds its probe grid because the scene above is a ROOM: the
// enclosure comes out of the layout, and there is no pin to state it with.
// ...AND BECAUSE THE SCENE'S RAYS ARE OFF: a new project is Epic, which builds
// no grid at all where it traces (PHOTON-F12-PCC) — the fence needs the grid.
assert(world.rayTracing("off") === "off", "the scene's rays off (the grid tier)");
assert(world.gi({ mode: "vct_pcc_hybrid" }) === true, "switch the VCT+Probes hybrid ON");
// The hybrid binds over several frames (voxelize, solve, capture the probes),
// so this waits for the BINDING rather than assuming it landed in one.
for (var w = 0; w < 12 && world.giStatus().pccBound !== true; ++w) editor.frame(5);
assert(world.giStatus().pccBound === true, "PCC is bound");
var h3 = probeOf(hero, "reflection_hero_pcc.png");
var c3 = probeOf(control, "reflection_control_pcc.png");
console.log("    " + show("HERO pcc", h3) + " " + show("CONTROL pcc", c3));
// THE HUE, not the brightness: two probe-lit spheres at different positions
// sample different probes and are legitimately a few levels apart, but the
// override is a blue SKY and its signature is a blue cast. With the override
// suppressed the hero must be as neutral as the control is.
var heroCast = h3.b - h3.r, controlCast = c3.b - c3.r;
console.log("    casts hero=" + heroCast + " control=" + controlCast +
            " (with the override live it was " + (h1.b - h1.r) + ")");
assert(h1.b - h1.r > 20, "the override's signature IS a blue cast (sanity)");
assert(Math.abs(heroCast - controlCast) <= 8,
       "under the hybrid the override went DARK with the global cube — the hero carries no " +
       "more of the sky than the control does (" + heroCast + " vs " + controlCast + ")");
assert(app.engineErrors().recorded === 0,
       "and nothing failed: no shader error, no engine complaint");
assert(material.get(hero).reflectionMap === equirect,
       "the DOCUMENT still holds the override — it is suppressed, not thrown away");

// ---- THE SKY LIGHT GATE DOES NOT TOUCH AN AUTHORED MAP -------------------
// SMOKE-ENGINE-1 item 2, round 2, the lead's decision. The sky's specular IBL
// is scaled by the Sky Light — hide it and the sky reflects nothing — and that
// scale rides `ambientUpperHemi.w`, which HlmsPbs applies to EVERY
// PBSM_REFLECTION texture in the pass. An authored reflection map is not the
// sky: it is the material's own environment, and the sky's gain has no business
// dimming it. The renderer gates the SKY CUBE by not BINDING it (binding is per
// material) and leaves the pass scale at 1.0 while any authored map is live.
//
// The fixture is already exactly right for this: HERO carries the override,
// CONTROL takes the global cube. So hide the Sky Light and watch them part.
assert(world.gi({ mode: "off" }) === true, "GI off again for the Sky Light case");
for (var w2 = 0; w2 < 12 && world.giStatus().pccBound !== false; ++w2) editor.frame(5);
assert(material.set(hero, { reflectionMap: equirect }) === true, "hero keeps its own map");
var hLit = probeOf(hero, "reflection_hero_skylight_on.png");
var cLit = probeOf(control, "reflection_control_skylight_on.png");
console.log("    " + show("HERO skylight on", hLit) + " " + show("CONTROL skylight on", cLit));

var sky = world.skyLight();
assert(sky.light, "the scene has a Sky Light to hide");
// `light` is the node id; `name` is what the hierarchy shows.
assert(node.setProperty(sky.light, "visible", false) === true, "hide the Sky Light");
var hOff = probeOf(hero, "reflection_hero_skylight_off.png");
var cOff = probeOf(control, "reflection_control_skylight_off.png");
console.log("    " + show("HERO skylight off", hOff) + " " + show("CONTROL skylight off", cOff));

function lum(p) { return (p.r + p.g + p.b) / 3; }
console.log("    luminance: hero " + lum(hLit).toFixed(1) + " -> " + lum(hOff).toFixed(1) +
            ", control " + lum(cLit).toFixed(1) + " -> " + lum(cOff).toFixed(1));
// The CONTROL reflects the sky, and the sky is a light: it goes out.
assert(lum(cOff) < lum(cLit) * 0.5,
       "the CONTROL sphere, which reflects the SKY, goes dark with the Sky Light (" +
       lum(cLit).toFixed(1) + " -> " + lum(cOff).toFixed(1) + ")");
// The HERO reflects its OWN map, which is not the sky and is not a light the
// scene owns. It keeps it. (Not "identical": the sphere is metal 1 with a 0.05
// roughness, so a sliver of the ambient still reaches it and the Sky Light is
// the ambient — the claim is that the MAP survives, not that nothing moved.)
assert(lum(hOff) > lum(hLit) * 0.6,
       "the HERO sphere KEEPS its authored reflection map with the Sky Light hidden (" +
       lum(hLit).toFixed(1) + " -> " + lum(hOff).toFixed(1) + ")");
assert(hOff.b - hOff.r > 20,
       "and it is still the MAP: the blue cast of the override is intact (" +
       (hOff.b - hOff.r) + ")");
assert(node.setProperty(sky.light, "visible", true) === true, "show the Sky Light again");
var cBack = probeOf(control, "reflection_control_skylight_back.png");
assert(lum(cBack) > lum(cLit) * 0.8,
       "and showing it brings the sky's reflection back (" + lum(cBack).toFixed(1) + ")");

// ---- save / close / open ------------------------------------------------
assert(project.save() === true, "project.save");
assert(project.close() === true, "project.close");
assert(project.open(guid) === true, "project.open");
editor.frame(3);
assert(material.get(hero).reflectionMap !== "",
       "the reflection cubemap survived the round trip");

console.log("e2e reflection map: all assertions passed");
