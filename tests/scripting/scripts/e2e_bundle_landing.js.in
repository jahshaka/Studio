// assets_import.bundle_landing — THE LANDING OF AN IMPORT'S BAKE, case by case (STAGE-CLOSE-TRIAGE-1
// fix round 3). A cross-library paste returns before its bake commits (MeshBakeStore::bakeLandedAsync);
// the commit is HELD (assets.holdBakes) so every placement below is made before its landing.
//
//   P1  a SKINNED model with no clip, pasted and left 40 frames (past the mirror's static settle),
//       then landed: no engine error (Ogre's "Object is static while Node isn't"), the rig attached.
//   P1b a reimport that turns a settled static model SKINNED: no engine error, the rig attached.
//   F4  paste -> UNDO before the landing -> land -> REDO: the node comes back WITH its geometry.
//   F1  a cross-library paste: no geometry while held, geometry after the landing.

function assert(cond, msg) {
    if (!cond) throw new Error("assert failed: " + msg);
    console.log("ok: " + msg);
}
function J(x) { return JSON.stringify(x); }
// EACH CASE ITS OWN CONTENT, used by no other arm of this pool: a bake is keyed on the content, and a
// row of an earlier arm (in a project this arm cannot see from the store scope) holding a fresh bake of
// the same bytes would make the paste find it fresh and bake nothing.
var RIG = "@SOURCE_DIR@/tests/skeletal/fixtures/mixamo_tpose.fbx";   // skinned, NO clip in the file
var RIG_TINY = "@SOURCE_DIR@/tests/avatar/fixtures/rig2_tiny.glb";
var QUAD = "@SOURCE_DIR@/tests/importer/fixtures/scaled_two_meshes.glb";

/// Every store row whose content is `oid` goes, and the store's unreferenced bytes: the library no
/// longer holds the model, so a paste of it imports rows and must BAKE.
function forgetContent(oid) {
    assets.list({ scope: "store" }).forEach(function (row) {
        var o = null;
        try { o = assets.importSettings(row.guid).sourceOid; } catch (e) { }
        if (o === oid) assets.remove(row.guid, { keepShared: false, force: true });
    });
    assets.gc({ dryRun: false });
}
function engineErrors() { return app.engineErrors(true).recorded; }
function geometry(id) { return scene.bounds({ nodes: [id] }).nodes; }
function land() {
    assets.holdBakes(false);
    var guard = 0;
    while (assets.pendingBakes() > 0 && guard++ < 600) editor.frame(1, 1 / 60);
    assert(assets.pendingBakes() === 0, "the bake landed after " + guard + " frame(s)");
    editor.frame(3, 1 / 60);
}
/// Copies a placed model, takes its content out of the library, and pastes it back with the bake held.
function pasteForeign(placed) {
    var oid = assets.importSettings(placed.assetGuid).sourceOid;
    assert(clipboard.copy(placed.nodeId).items === 1, "the placed model is copied");
    node.remove(placed.nodeId);
    forgetContent(oid);
    assert(assets.holdBakes(true) === true, "the bake commit is held");
    var pasted = clipboard.paste();
    assert(pasted.pasted.length === 1 && pasted.imported.length >= 1,
           "the paste lands its rows from the payload: " + J({ pasted: pasted.pasted, imported: pasted.imported }));
    assert(assets.pendingBakes() > 0, "and returns with its bake pending (" + assets.pendingBakes() + ")");
    return pasted.pasted[0];
}

/// Imports `path` under `options` and places it: {assetGuid, nodeId}.
function importAndPlace(path, options) {
    var guid = assets.import(path, options || {});
    assert(guid && guid.length > 10, "assets.import(" + path.split("/").pop() + ", " + J(options || {}) + ") -> " + guid);
    var id = assets.addToScene(guid, { position: { x: 0, y: 0, z: 0 } });
    assert(id && id.length > 10, "placed -> " + id);
    return { assetGuid: guid, nodeId: id };
}

project.create("bundle landing " + Date.now());
engineErrors();

// ---- P1: a skinned model with no clip, placed before its bake lands --------------------------
var rig = importAndPlace(RIG);
assert(rig.nodeId && rig.assetGuid, "a skinned model with no clip placed: " + J(rig));
editor.frame(2, 1 / 60);
var rigNode = pasteForeign(rig);
assert(geometry(rigNode) === 0, "the pasted rig has no geometry while its bake is held");
editor.frame(40, 1 / 60);   // past kStaticSettleFrames: a meshless node is not static-eligible (P1a)
land();
assert(geometry(rigNode) >= 1, "the landing gave the rig its geometry");
assert(scene.rigStats().rigged >= 1, "and its skinned item is ATTACHED (rigged " + scene.rigStats().rigged + ")");
assert(engineErrors() === 0, "no engine error at the landing (the static/dynamic attach refusal)");

// ---- P1b: a reimport that turns a settled static model skinned -------------------------------
var flat = importAndPlace(RIG_TINY, { skeleton: false, clips: false });
assert(flat.nodeId, "rig2.glb placed WITHOUT its skeleton: " + J(flat));
editor.frame(40, 1 / 60);   // settled: a static mesh is static
var rigged0 = scene.rigStats().rigged;
var re = assets.reimport(flat.assetGuid, { skeleton: true, clips: false });
assert(re.swappedNodes >= 1, "the reimport swapped the skinned mesh into the placed node: " + J(re));
editor.frame(3, 1 / 60);
assert(scene.rigStats().rigged > rigged0, "its skinned item is ATTACHED (" + rigged0 + " -> " + scene.rigStats().rigged + ")");
assert(engineErrors() === 0, "no engine error when a static node turned skinned");

// ---- F4 + F1: paste -> undo before the landing -> land -> redo ----------------------------------
var quad = importAndPlace(QUAD);
assert(quad.nodeId, "a static model placed: " + J(quad));
var quadNode = pasteForeign(quad);
assert(geometry(quadNode) === 0, "F1: the pasted node stands with NO geometry while its bake is held");
assert(editor.undo() === true, "the paste is undone before the landing");
land();
assert(editor.redo() === true, "the paste is redone after the landing");
editor.frame(3, 1 / 60);
var redone = null;
scene.nodes().forEach(function (n) { if (n.id === quadNode) redone = n.id; });
assert(redone !== null, "the redone node is the pasted one");
assert(geometry(quadNode) >= 1, "F4: the redone node has the geometry that landed while it was undone");
assert(engineErrors() === 0, "no engine error");
console.log("bundle_landing: ALL OK");
