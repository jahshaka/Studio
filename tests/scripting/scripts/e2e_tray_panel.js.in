// scripting.e2e.tray_panel — THE ASSET TRAY SHOWS EVERY ASSET A SCENE USES,
// ONCE, and the tray PANEL and assets.list({tray: true}) are one listing
// (owner, 2026-09-12: "the demo scenes — shouldn't all the assets in the scene
// be in the asset drawer? For all the scenes? None of them are in the asset
// drawer." Lane L13; the rule is services/assettray.h).
//
// What was wrong, and what each section pins down:
//   * the tray hid every asset something DEPENDED on, and the editor records
//     USE as a dependency — an applied material, a texture on a node's slot —
//     so a used asset left the tray the moment it was used (section 2);
//   * the panel skipped the built-in primitives' rows, which in the samples
//     held the closure, so Showroom and Mirror Room trays were empty; and the
//     panel and the verb ran different rules (every section compares them:
//     editor.trayAssets() reads the WIDGET);
//   * a pin made through a verb left the panel stale until a click (section 1);
//   * the samples shipped junk rows the old filter happened to hide, and two
//     shipped Tile.png rows with no bytes (section 3 — the sample CRUD);
//   * the samples' checker row was not marked as the PLATFORM's, so an opened
//     sample showed a tile for a texture the user never added (section 3, the
//     Tile.png assertions — CONTENT-1 re-exported the archives with the stamp).
//
// SECTION 3 IS THE OWNER'S QUESTION, per shipped sample: import it the way the
// sample dialog does, open it, and the tray must be EXACTLY the scene's asset
// closure — computed here from the DOCUMENT (node.serialize of every top-level
// node + world.get), not from the catalog edges the tray itself reads: every
// model, texture and material a node uses, once; a mesh counts as the model
// that owns it; a built-in primitive's, an emitter's or a decal's own row is
// the node itself, never an asset.
//
// Engine-up (the tray is a widget): needs the rig's display.

var SCENES = "@SOURCE_DIR@/scenes";
var FIXTURES = "@SOURCE_DIR@/tests/scripting/fixtures";
var SAMPLES = ["Matcaps", "Mirror Room", "Particles", "Physics", "Showroom", "Showroom 2",
               "Skeletal Animation", "World Background"];

function assert(cond, msg) {
    if (!cond) throw new Error("assert failed: " + msg);
    console.log("ok: " + msg);
}
function J(x) { return JSON.stringify(x); }
function guidsOf(rows) { return rows.map(function (r) { return r.guid; }); }
function verbRows() { return assets.list({ scope: "project", tray: true }); }
function panelRows() { return editor.trayAssets().filter(function (t) { return !t.folder; }); }
function sorted(a) { return a.slice().sort(); }
function sameSet(a, b) { return J(sorted(a)) === J(sorted(b)); }
function minus(a, b) { return a.filter(function (x) { return b.indexOf(x) < 0; }); }

// THE PANEL IS THE VERB: the widget's asset tiles and the verb's rows are the
// same set, and every tile appears ONCE.
function agree(tag) {
    var panel = guidsOf(panelRows());
    var verb = guidsOf(verbRows());
    assert(sameSet(panel, verb),
           tag + ": the tray panel shows exactly assets.list({tray:true}) (" + panel.length +
           " tiles; panel-only " + J(minus(panel, verb)) + ", verb-only " + J(minus(verb, panel)) + ")");
    var seen = {}, twice = [];
    panel.forEach(function (g) { if (seen[g]) twice.push(g); seen[g] = true; });
    assert(twice.length === 0, tag + ": every tile appears once");
}

function companionOf(textureGuid) {
    var mats = assets.list({ scope: "project", type: "material" });
    for (var m = 0; m < mats.length; ++m)
        if (assets.dependencies(mats[m].guid).indexOf(textureGuid) >= 0) return mats[m].guid;
    return "";
}

// The asset closure of the OPEN scene, read off the document.
function sceneClosure() {
    var rows = assets.list({ scope: "project" });
    var byGuid = {};
    rows.forEach(function (r) { byGuid[r.guid] = r; });
    var meshOwner = {};
    rows.forEach(function (r) {
        if (r.type !== "object") return;
        assets.dependencies(r.guid).forEach(function (d) {
            if (byGuid[d] && byGuid[d].type === "mesh") meshOwner[d] = r.guid;
        });
    });
    var root = scene.root();
    var tops = scene.nodes({ depth: 1 }).filter(function (r) { return r.id !== root; });
    var trees = tops.map(function (t) { return node.serialize(t.id).node; });

    // Pass 1: the nodes whose own row is the NODE (not an asset), and the
    // PLATFORM FURNITURE they stand on. The DEFAULT FLOOR's shipped checker is
    // a real library texture the scene really uses, but the editor pinned it by
    // itself for a node the user never added, so its row is stamped
    // `{"type": "platform"}` and the tray drops it by rule 4
    // (services/shippedassets.h Ownership::Platform, services/assettray.h); the
    // shipped archives carry that stamp since CONTENT-1 re-exported them, which
    // is why six of the eight samples now show nothing at all.
    //
    // THE STAMP IS NOT IN THE DOCUMENT — it is a property of the catalog row —
    // so this closure, which is deliberately computed from the document alone,
    // names the one row the platform pins: the project's "Tile.png", and only
    // when the scene's default floor actually wears it. A floor wearing a
    // texture the user chose (World Background's metal plate) is an ordinary
    // dependency and stays in the closure, exactly as the tray keeps it.
    var checker = assets.list({ scope: "project", type: "texture", query: "Tile.png" })[0];
    var nodeOnly = {}, platform = {};
    function mark(n) {
        var builtinMesh = n.type === "mesh" && typeof n.mesh === "string" && n.mesh.charAt(0) === ":";
        if (n.type !== "mesh" || builtinMesh) nodeOnly[n.guid] = true;
        if (n.defaultFloor === true && n.material && n.material.values && checker
            && n.material.values.baseColorMap === checker.guid)
            platform[checker.guid] = true;
        (n.children || []).forEach(mark);
    }
    trees.forEach(mark);

    // Pass 2: every row guid a node (or the world) names.
    var used = {};
    function use(guid) {
        var row = byGuid[guid];
        if (!row || nodeOnly[guid] || platform[guid]) return;
        if (row.type === "mesh") { if (meshOwner[guid]) used[meshOwner[guid]] = true; return; }
        used[guid] = true;
    }
    function sweep(value) {
        if (typeof value === "string") { use(value); return; }
        if (value && typeof value === "object")
            for (var k in value) if (k !== "children") sweep(value[k]);
    }
    function walk(n) {
        sweep(n);                                   // its own guid, mesh, maps, images, targets
        (n.children || []).forEach(walk);
    }
    trees.forEach(walk);
    sweep(world.get());                             // the sky's images, the ambient music
    return Object.keys(used).map(function (g) {
        return { guid: g, name: byGuid[g].name, type: byGuid[g].type };
    });
}

// ---- 1. a verb's pin reaches the panel with no click -----------------------

project.create("tray panel");
agree("a fresh project");
// A FRESH PROJECT SHOWS NOTHING (owner, 2026-09-13, lane BAR-1: "the project
// asset tray should only show assets and items added to the project"). The
// default scene is platform furniture from end to end: the Ground's own row is
// a node's row, and the shipped checker it stands on is a PLATFORM-owned
// library texture the editor pins by itself — both dropped by rule 4.
var tileRow = assets.list({ scope: "project", type: "texture", query: "Tile.png" })[0];
assert(tileRow && guidsOf(panelRows()).indexOf(tileRow.guid) < 0,
       "the default ground's shipped checker is NOT a tile in the panel");
assert(guidsOf(panelRows()).indexOf(scene.find("Ground")) < 0,
       "... the Ground itself is not either");
assert(panelRows().length === 0, "... so a fresh project's panel is empty");

var tinyTex = assets.importFile(FIXTURES + "/tiny.png");
assert(assets.addToProject(tinyTex) === tinyTex, "assets.addToProject(tiny.png) — a VERB's pin");
var tinyMat = companionOf(tinyTex);
assert(guidsOf(panelRows()).indexOf(tinyMat) >= 0,
       "the panel shows the image's material tile without a click (it repopulates on pin changes)");
agree("after a verb's add");

// ---- 2. a USE never hides anything -----------------------------------------

var cube = scene.addPrimitive("cube", { position: { x: 4, y: 0, z: 4 } });
assert(material.apply(cube, tinyMat) === true, "material.apply(cube, its material)");
assert(guidsOf(panelRows()).indexOf(tinyMat) >= 0,
       "an APPLIED material stays in the panel (the old dependee filter hid it here)");
var plane = scene.addImagePlane(tinyTex, { position: { x: -4, y: 1, z: 4 } });
assert(plane && plane.length > 10, "scene.addImagePlane(tiny.png)");
assert(guidsOf(panelRows()).indexOf(tinyTex) >= 0,
       "an image a node USES is a tile in the panel (the old filter hid it — the plane depends on it)");
assert(guidsOf(panelRows()).indexOf(plane) < 0, "... the image plane's own row is not");
agree("after the uses");
assert(project.close(), "closed");

// ---- 2b. AN EXISTING LIBRARY'S PRESET MAPS FOLD (SEED-RESTAMP-1) -----------
//
// THE OWNER'S #56 SMOKE FINDING: "my project tray doesn't have bundles — it has
// the presets and their textures; the textures should be inside the bundles."
// His library was reset on build #53 and the STAMPING seed (SEED-STAMP-1)
// shipped in #54: the seed writes the member stamp as it MINTS each map and is
// idempotent, so thirty-five maps minted by the older build carried none for
// ever and stood in his tray as loose tiles beside the seven bundles they came
// in through. `assets.restampSeed()` is the repair, and a person's launch runs
// it beside the seed (services/presetrestamp.h).
//
// THE #53 SHAPE, BUILT HERE: apply a preset with three maps — that seeds the
// bundle and pins its closure — and then import each of those three pictures
// as the USER, which takes the stamp off the row it lands on (IMPORT-INTENT-1).
// That is the only door a script has to the state an older seed left behind,
// and it leaves exactly it: the bundle, its three maps pinned, none stamped.
var BRICK = "00000000-0000-0000-0000-000000002014";   // Brick PBR: three maps
var BRICK_MAPS = [
    "@SOURCE_DIR@/app/content/materials/presets/brick_ground/Brick_Ground_01_UV_H_CM_1_COLOR.png",
    "@SOURCE_DIR@/app/content/materials/presets/brick_ground/Brick_Ground_01_UV_H_CM_1_NRM.png",
    "@SOURCE_DIR@/app/content/materials/presets/brick_ground/Brick_Ground_01_UV_H_CM_1_SPEC.png"];

project.create("tray restamp");
var painted = scene.addPrimitive("cube", { position: { x: 0, y: 0, z: 6 } });
assert(material.apply(painted, "Brick PBR") === true,
       "restamp: a preset with three maps is applied — it seeds the bundle and pins its closure");
var mapRows = materials.members(BRICK);
assert(mapRows.length === 3, "restamp: the bundle names its three maps " + J(mapRows.length));
var mapGuids = guidsOf(mapRows);
mapGuids.forEach(function (g) {
    assert(assets.pins(g).length > 0, "restamp: …and the project pins each of them");
});

BRICK_MAPS.forEach(function (path) {
    assert(!!assets.importFile(path), "restamp: the user imports that picture themselves");
});
mapGuids.forEach(function (g) {
    assert(assets.metadata(g).member !== true,
           "restamp: …so the row carries no stamp — the library a #53 seed left");
});

// THE SYMPTOM: the maps are tiles in the tray, beside the bundle's own tile.
//
// A user import taking a stamp OFF is not a pin change and not a seeder pass, so
// it still does not repopulate the panel on its own (a residual of TRAY-REPOP-1,
// reported): one pin change brings the panel up to date here, which is what
// makes the re-stamp's fold visible IN THE PANEL below.
assert(assets.addToProject(tinyTex) === tinyTex, "restamp: a pin change repopulates the panel");
var loose = guidsOf(verbRows());
mapGuids.forEach(function (g) {
    assert(loose.indexOf(g) >= 0, "restamp: the map stands in the tray as a LOOSE TILE");
});
assert(loose.indexOf(BRICK) >= 0, "restamp: …beside the preset's own tile, which is the complaint");
agree("before the re-stamp (the panel shows the loose maps too)");
mapGuids.forEach(function (g) {
    assert(guidsOf(panelRows()).indexOf(g) >= 0, "restamp: the PANEL shows the map as a loose tile");
});

// THE REPAIR.
var report = assets.restampSeed();
assert(report.ran === true, "assets.restampSeed() had something to repair " + J(report));
assert(report.stamped === 3,
       "restamp: THREE MAPS STAMPED — the preset's, matched by content (" + report.stamped + ")");
assert(report.presets === 1, "restamp: …across the one bundle " + J(report));
mapGuids.forEach(function (g) {
    var meta = assets.metadata(g);
    assert(meta.member === true && meta.memberOf === BRICK,
           "restamp: …each naming the preset it came in through");
});

// AND THE TRAY IS WHAT THE OWNER ASKED FOR: one tile, the material.
var folded = guidsOf(verbRows());
mapGuids.forEach(function (g) {
    assert(folded.indexOf(g) < 0, "restamp: the map is folded into the bundle's tile");
});
assert(folded.indexOf(BRICK) >= 0, "restamp: …and the PRESET is still the tile that is there");
mapGuids.forEach(function (g) {
    assert(assets.pins(g).length > 0, "restamp: …with its pin untouched (a fold is not an unpin)");
});
// THE PANEL FOLDS TOO, WITH NO CLICK (TRAY-REPOP-1): the re-stamp is a pass of
// the preset seeder, and its `finished` is what the tray panel repopulates on. Before
// that it only heard pin changes, and a stamp is not one — the panel kept the
// loose map tiles until something else repopulated it.
mapGuids.forEach(function (g) {
    assert(guidsOf(panelRows()).indexOf(g) < 0,
           "restamp: the PANEL folds the map into the bundle's tile, with no click");
});
assert(guidsOf(assets.list({ scope: "project", tray: true, type: "texture", members: true }))
           .indexOf(mapGuids[0]) >= 0,
       "restamp: …and 'Show member textures' still lists it");
agree("after the re-stamp");

// IDEMPOTENT: the same launch route, run twice, writes nothing.
var again = assets.restampSeed();
assert(again.stamped === 0 && again.presets === 0,
       "assets.restampSeed() a second time writes nothing " + J(again));
assert(again.skipped >= 1, "restamp: …because the preset now shows a stamping seed's work");
assert(project.close(), "restamp: closed");

// ---- 3. every shipped sample: the tray is the scene's asset closure --------

for (var i = 0; i < SAMPLES.length; ++i) {
    var name = SAMPLES[i];
    var imported = project.importArchive(SCENES + "/" + name + ".zip");
    assert(imported && imported.guid, name + ": imported (" + imported.assets + " rows, " +
           imported.objects + " stored objects)");
    assert(project.open(imported.guid) === true, name + ": opened");

    var closure = sceneClosure();
    var tray = verbRows();
    console.log(name + " closure: " + J(closure.map(function (r) { return r.type + ":" + r.name; }).sort()));
    console.log(name + " tray:    " + J(tray.map(function (r) { return r.type + ":" + r.name; }).sort()));
    var want = guidsOf(closure), got = guidsOf(tray);
    var nameOf = {};
    closure.concat(tray).forEach(function (r) { nameOf[r.guid] = r.type + ":" + r.name; });
    assert(sameSet(got, want),
           name + ": THE TRAY IS THE SCENE'S ASSET CLOSURE (" + got.length + " tiles; missing " +
           J(minus(want, got).map(function (g) { return nameOf[g]; })) + ", junk " +
           J(minus(got, want).map(function (g) { return nameOf[g]; })) + ")");
    assert(tray.filter(function (r) { return r.type === "mesh"; }).length === 0,
           name + ": no mesh row is a tile");
    // THE SHIPPED CHECKER IS NOT A TILE (BAR-1's rule, reaching the archives in
    // CONTENT-1): the sample's own Tile.png row carries the platform stamp, so
    // an opened sample never shows it — while the floor still WEARS it, on a
    // library that has never seen this scene before (this suite's home is
    // fresh and every sample is imported into it).
    assert(tray.filter(function (r) {
               return ("" + r.name).toLowerCase() === "tile.png";
           }).length === 0,
           name + ": the shipped checker is not a tray tile");
    var floor = scene.find("Ground");
    if (floor) {
        var floorMap = "" + material.get(floor).baseColorMap;
        assert(floorMap.length > 0 && floorMap.indexOf("objects/") >= 0,
               name + ": ... and the ground still wears it from the store (" + floorMap + ")");
    }
    agree(name);
    var folders = editor.trayAssets().filter(function (t) { return t.folder; });
    assert(folders.length === 0,
           name + ": none of the editor's own hidden folders is a tile " + J(folders));
    assert(project.close(), name + ": closed");
}

// ---- 4. FOLDERS, MOVES AND CREATE MATERIAL (DRAWERS-1) ---------------------
//
// The owner's item 10: "folders + a move verb + internal drop in the drawer,
// materials.create (right-click > Create Material), the two project drawers as
// ONE list." The drag itself is a gesture this suite cannot perform; what it
// pins down is everything under it — the verbs the drop calls, the tile the
// folder becomes in the PANEL, and the two drawers agreeing without a click.

project.create("tray folders");
assert(panelRows().length === 0, "folders: a fresh project's panel is empty");
assert(assets.folders().length === 0, "... and it has no folders");

var props = assets.createFolder("Props");
assert(props && props.length > 10, "assets.createFolder('Props') -> a guid");
var folderTiles = editor.trayAssets().filter(function (t) { return t.folder; });
assert(folderTiles.length === 1 && folderTiles[0].guid === props,
       "the folder is a TILE in the tray panel " + J(folderTiles));
assert(assets.folders()[0].name === "Props", "assets.folders() lists it");

// Two pinned library assets, moved in ONE call — what the internal drop of a
// multi-selection onto the folder tile does. (Adding an IMAGE directly mints
// its companion material, and the material is the image's tile — rule 5 — so
// the tiles to move are the companions.)
var texA = assets.importFile(FIXTURES + "/tiny.png");
var texB = assets.importFile(FIXTURES + "/implane_wide.png");
assets.addToProject(texA);
assets.addToProject(texB);
var matA = companionOf(texA), matB = companionOf(texB);
assert(matA && matB && matA !== matB, "two library materials in the project");
assert(guidsOf(panelRows()).indexOf(matA) >= 0 && guidsOf(panelRows()).indexOf(matB) >= 0,
       "both are tiles at the ROOT");
// THE GESTURE ITSELF, not just the verb it calls: real QDragEnter/QDragMove/
// QDrop events at the CENTRE of the folder's tile in the tray, carrying the
// one asset payload with BOTH guids in it (editor.dragAssetToTray). This is
// what a person's drag of a multi-selection onto a folder does.
assert(editor.dragAssetToTray([matA, matB], props) === true,
       "the tray takes a DROP of a two-tile selection on the folder tile");
assert(guidsOf(panelRows()).indexOf(matA) < 0 && guidsOf(panelRows()).indexOf(matB) < 0,
       "... and neither is at the ROOT any more");
assert(assets.folders()[0].count === 2, "... the folder holds two tiles");
agree("after a multi-move");

// A drop on an ASSET tile is not a move (only a folder takes one).
var stray = materials.create("Not A Folder", { folder: "" });
assert(editor.dragAssetToTray([matA], stray) === false,
       "a drop on an ASSET tile is refused: " + app.lastError());
assert(assets.folders()[0].count === 2, "... and nothing moved");

// The verb the drop calls, on its own — one row, back to the ROOT.
assert(assets.moveToFolder(matB, null) === 1,
       "assets.moveToFolder(guid, null) brings one row back to the root");
assert(guidsOf(panelRows()).indexOf(matB) >= 0, "... and it is a root tile again");
assert(assets.moveToFolder([matB], props) === 1, "... and back in");

// The refusals a drop can hit, as the verb answers them.
try {
    assets.moveToFolder([matA], "not-a-folder-guid");
    assert(false, "moving into an unknown folder should be refused");
} catch (e) {
    assert(("" + e).indexOf("no folder") >= 0, "an unknown target folder is refused: " + e);
}

// ---- Create Material, and the two project drawers as ONE list -------------

var made = materials.create("Tray Made", { folder: "" });
assert(made && made.length > 10, "materials.create(name, {folder}) -> a guid");
assert(guidsOf(panelRows()).indexOf(made) >= 0,
       "the new material is a tile in the EDITOR's tray with no click");
function drawerGuids() { return guidsOf(materials.projectDrawer()); }
assert(drawerGuids().indexOf(made) >= 0,
       "... and in the MATERIALS module's project drawer " + J(materials.projectDrawer()));

// The other direction (the owner: "adding a material to the project should add
// it to the project assets").
var libraryOnly = materials.create("Library Only");
assert(guidsOf(panelRows()).indexOf(libraryOnly) < 0,
       "a material created with NO folder is a library bundle, not a project tile");
assert(drawerGuids().indexOf(libraryOnly) < 0, "... and not in the module's drawer either");
assert(assets.addToProject(libraryOnly) === libraryOnly, "assets.addToProject(it)");
assert(guidsOf(panelRows()).indexOf(libraryOnly) >= 0, "... now it is a tray tile");
assert(drawerGuids().indexOf(libraryOnly) >= 0, "... and a module-drawer tile");

// A material FILED IN A FOLDER is not at the tray root — and IS in the module's
// drawer, which is flat by design: it has no breadcrumb to navigate a folder
// with, so it shows the project's materials wherever they are filed.
var filed = materials.create("Filed Material", { folder: props });
assert(guidsOf(panelRows()).indexOf(filed) < 0,
       "a material created INTO a folder is not a root tile");
assert(drawerGuids().indexOf(filed) >= 0,
       "... but the module's project drawer still shows it " + J(materials.projectDrawer()));
// ---- a pin that leaves by ANY door closes its Materials tab ---------------
//
// The drawer's own Delete told the page (MATERIALS-TABS-1 F1); every other
// door — this verb, the tray's Delete, assets.deleteFolder({keepContents:
// false}), a project close — did not, and a '(project)' tab whose pin has gone
// is editing nothing. The page listens to the one announcement they all make.

// WITH A GRAPH: the node editor opens a graph, and a values-only bundle has
// none — `materials.open` refuses one, which is the page.s own rule.
//
// CREATED AND OPENED IN ONE BREATH, with no drawer read in between
// (TABS-SMALL-1). DRAWERS-1 left a `materials.projectDrawer()` call here with
// a comment calling it load-bearing — "the open asks the drawer whether it
// holds the guid" — and it is not: an open is not gated on a tile, it refills
// the view and carries on (EffectsPage::openDocument), which is what this arm
// holds it to. The drawer is read AFTER the open instead, where it proves what
// it is actually for: the new material has a tile without anybody asking.
var tabbed = materials.create("Tabbed Material", { graph: true, folder: "" });
var opened = materials.open(tabbed, { scope: "project" });
assert(opened && opened.guid === tabbed && opened.scope === "project",
       "a project copy opens as a tab, created in the breath before " + J(opened));
assert(drawerGuids().indexOf(tabbed) >= 0,
       "... and the module's drawer has its tile " + J(materials.projectDrawer()));
function tabGuids() { return materials.tabs().map(function (t) { return t.guid; }); }
assert(tabGuids().indexOf(tabbed) >= 0, "... and it is in materials.tabs()");
assert(assets.removeFromProject(tabbed) === true,
       "assets.removeFromProject(it) — a door the drawer's Delete is not");
assert(tabGuids().indexOf(tabbed) < 0,
       "... the tab closed with the pin " + J(materials.tabs()));

assert(project.close(), "folders: closed");

console.log("e2e_tray_panel: all sections passed");
