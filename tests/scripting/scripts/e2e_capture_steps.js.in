// app.capture_steps — A CAPTURE STEPS NOTHING (CLOSE-SHOT-2 fix round 2).
//
// The tile's clean picture is the view's chain drawn a second time in the
// capturing frame (View::requestFrameCapture). That second draw must not move
// ANY of the view's temporal state — the ray tier's reflection ping-pong and
// mover counters, the screen-probe gather's history and age, the hit
// write-back, the Atom cull's occlusion history and stats, the SSR
// reprojection, the exposure history — or the frames the user sees AFTER a
// save would differ from the frames they would have seen without one.
//
// THE COUNTERFACTUAL IS A REPLAY: the same saved world is opened, played and
// stepped through the same frames three times in this one process — a moving
// mover (a keyed property track) and a skinned character playing its clip,
// both in play mode at a fixed dt — and on frame K the three runs differ only
// in that frame:
//   A  a plain frame at dt 0;
//   B  the clean capture's frame at dt 0 (the save's door, editor.presentedFrame);
//   A2 a plain frame again — the replay's own determinism, the guard that makes
//      A against B mean something.
// (A warm-up run W goes first and is not compared.) The next FIVE presented frames (the window's own bytes, read without a
// capture of the clean kind) must match A to A2 and A to B: byte-identical on a
// quiet box; the bar is the replay's own measured floor (see the assertion).

function assert(cond, msg) {
    if (!cond) throw new Error("assert failed: " + msg);
    console.log("ok: " + msg);
}
function J(x) { return JSON.stringify(x); }

var guid = project.create("Capture Steps " + Date.now());
assert(guid.length > 10, "project.create");
var mover = scene.addPrimitive("cube", { position: { x: -3, y: 1, z: 0 } });
assert(anim.create(mover, "slide").length > 0, "anim.create on the mover");
assert(anim.keyframe(mover, "position", 0, { x: -3, y: 1, z: 0 }) === true, "key at t=0");
assert(anim.keyframe(mover, "position", 4, { x: 3, y: 2, z: -2 }) === true, "key at t=4");
assert(anim.setLooping(mover, false) === true, "the track holds its last key");
var rig = assets.import("@SOURCE_DIR@/tests/avatar/fixtures/rig2.glb");
assert(rig.length > 10, "assets.import rig2.glb");
assert(assets.addToProject(rig) === rig, "assets.addToProject");
var rigRoot = assets.addToScene(rig, { position: { x: 1.5, y: 0, z: 1 } });
assert(rigRoot && rigRoot.length > 10, "the character is in the scene");
editor.frame(4, 1 / 60);
assert(project.save() === true, "the world is saved (every run opens this)");
project.close();

var K = 40;
function run(tag, capture) {
    assert(project.open(guid) === true, tag + ": project.open");
    editor.frame(120, 0);                 // the world's first lighting, at rest
    assert(editor.play() === true, tag + ": play");
    for (var i = 0; i < K; ++i) editor.frame(1, 1 / 60);
    if (capture) editor.presentedFrame(tag + "_clean.png");   // the capture's frame, dt 0
    else editor.frame(1, 0);                                   // the same frame, no capture
    var shots = [];
    for (var j = 0; j < 5; ++j) {
        editor.frame(1, 1 / 60);
        shots.push(editor.presentedFrame(tag + "_after" + j + ".png", { helpers: true }).path);
    }
    project.close();
    return shots;
}
// THE FIRST OPEN OF A WORLD IS NOT A REPLAY of the later ones (measured: one
// code on 981 px of the first run against every later one — a first-open
// cache), so a discarded warm-up run goes first.
run("W", false);
var A = run("A", false);
var B = run("B", true);
var A2 = run("A2", false);
var moved = app.compareImages(A[0], A[4], 0);
console.log("the world moves across the five frames: " + J(moved));
assert(moved.over > 100, "the mover and the character move between the frames (" + moved.over + " px)");
for (var j = 0; j < 5; ++j) {
    var rep = app.compareImages(A[j], A2[j], 0);
    var cap = app.compareImages(A[j], B[j], 0);
    console.log("frame +" + (j + 1) + ": replay " + J(rep) + "  capture " + J(cap));
    // THE REPLAY'S OWN FLOOR, MEASURED: quiet it is byte-exact (0 px on every frame,
    // A to A2 and A to B); inside the full -j4 gate one run of the three differed
    // from the other two by ONE code on 9 px of frame +1 — the replay itself (A2
    // against A), not the capture. A capture that steps the view's state is not
    // that: the ray tier's double step moved frame +1 by 42,798 px, up to 17 codes
    // (the guard removed, measured). So the bar is the floor, stated: at most 64
    // pixels, at most one code — for the replay and for the capture alike.
    assert(rep.over <= 64 && rep.maxDelta <= 1,
           "frame +" + (j + 1) + ": the replay holds (" + rep.over + " px, max " + rep.maxDelta + ")");
    assert(cap.over <= 64 && cap.maxDelta <= 1,
           "frame +" + (j + 1) + ": a capture changed nothing presented after it beyond the replay's floor (" +
           cap.over + " px, max " + cap.maxDelta + ")");
}
