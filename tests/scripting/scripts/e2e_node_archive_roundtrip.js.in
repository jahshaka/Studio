// assets_import.node_archive_roundtrip — A NODE'S ARCHIVE RE-IMPORTS INTO AN EMPTY LIBRARY
// AND RENDERS (ARCHIVE-ROUNDTRIP, D7; the owner's portability rule: every archive is
// self-contained for an empty library).
//
// What was broken: node.exportArchive wrote the legacy .jaf — a catalog snapshot built by
// walking NODE guids as ASSET guids (so a placed model's snapshot held no rows at all) and a
// `.manifest` the zip writer dropped as a dot-file (so the importer refused the file). It
// writes the share file now (assetshare::exportNode, the assets.exportBundle format): the
// node as an Object row plus its whole closure, every byte inline.
//
// THE CLAIM, in one process: export a placed textured model; take EVERYTHING it came from
// out of the library — the model and its members force-deleted, the source project removed,
// the store's unreferenced bytes collected — so the library is empty of it; import the file
// into a new project: the rows come back, the node is one tile, it places, and its surface
// samples the fixture's GREEN texel (the base-colour map bound from the file's own bytes —
// not grey, not white, not sky). Fixture: tests/importer/fixtures/textured_pbr_quad.glb
// (+Z quad, top-left texture quadrant RED, the rest GREEN).

function assert(cond, msg) {
    if (!cond) throw new Error("assert failed: " + msg);
    console.log("ok: " + msg);
}
function J(x) { return JSON.stringify(x); }
function gone(guid) { try { assets.metadata(guid); return false; } catch (e) { return true; } }

var FIXTURE = "@SOURCE_DIR@/tests/importer/fixtures/textured_pbr_quad.glb";
var file = app.dataRoot().root + "/node_archive_roundtrip.jbundle";

// ---- the source: a placed textured model --------------------------------------------
var source = project.create("archive source " + Date.now());
var placed = assets.importAndPlace(FIXTURE);
assert(placed.nodeId && placed.assetGuid, "a textured model placed: " + J(placed));
// (its source CONTENT, read while the row exists — the sweep below removes every holder of it)
var sourceOid = assets.importSettings(placed.assetGuid).sourceOid;
assert(typeof sourceOid === "string" && sourceOid.length > 10, "the model's source content: " + sourceOid);
var sourceRows = assets.list({ scope: "project" }).filter(function (r) {
    return r.type !== "object" || r.guid === placed.assetGuid;
}).filter(function (r) { return r.name !== "Tile.png"; });
var textures = sourceRows.filter(function (r) { return r.type === "texture"; });
assert(textures.length >= 1, "the model brought its textures: "
       + J(textures.map(function (r) { return r.name; })));

var r = node.exportArchive(placed.nodeId, file);
console.log("exportArchive -> " + J(r));
assert(r.path === file && r.type === "object" && r.bytes > 0, "the archive was written");
assert(r.assets >= textures.length + 2,
       "it carries the node's row, its mesh and every texture (" + r.assets + " rows)");

// ---- an EMPTY library: everything the node came from is gone ------------------------
project.close();
assert(project.remove(source), "the source project is removed");
assert(assets.remove(placed.assetGuid, { keepShared: false, force: true }),
       "the library model is force-deleted with its members");
sourceRows.forEach(function (row) {
    if (!gone(row.guid)) assets.remove(row.guid, { keepShared: false, force: true });
});
sourceRows.forEach(function (row) {
    assert(gone(row.guid), "the library no longer holds " + row.type + " '" + row.name + "'");
});
// THE LIBRARY IS EMPTY OF THE CONTENT, not only of this arm's rows (TC2-BUNDLE-NO-BAKE): a mesh
// bake is keyed on the CONTENT and its import settings, so ANY other library row over the same
// .glb — an earlier arm of this pool imported the same fixture — keeps a fresh bake in the store
// and a re-import that baked nothing still placed with geometry. That is how the pool hid the
// defect (red 3/3 solo, green in the pool). Every row whose source is this content goes too.
function holdersOfContent() {
    return assets.list({ scope: "store", type: "object" }).filter(function (row) {
        try { return assets.importSettings(row.guid).sourceOid === sourceOid; } catch (e) { return false; }
    });
}
holdersOfContent().forEach(function (row) {
    assets.remove(row.guid, { keepShared: false, force: true });
});
assert(holdersOfContent().length === 0, "no library row holds the model's content any more");
var gc = assets.gc({ dryRun: false });
console.log("gc -> " + J(gc).slice(0, 400));

// ---- the import: the node's assets and the node come back ---------------------------
project.create("archive target " + Date.now());
// THE IMPORT BAKES WHAT IT BROUGHT — THIS row's own bake (assets.bakeState), never a library-wide
// count: a count's delta reads 0 when the sweep commits some other stale row meanwhile (-1 +1).
// THE IMPORT DOES NOT WAIT FOR ITS BAKE (STAGE-CLOSE-TRIAGE-1 F3) and the node is placed at once:
// its geometry arrives when the bake LANDS (SceneEditService's landed listener -> refreshAssetMeshes).
// The commit is HELD (assets.holdBakes) so the placement is made before the landing on every box
// (addToScene pumps this thread, and an unheld bake of this small model lands inside it).
assert(assets.holdBakes(true) === true, "the bake commit is held");
/// Every row the library lists, the store's and the open project's.
function everyRow() {
    var seen = {}, out = [];
    ["store", "project"].forEach(function (scope) {
        assets.list({ scope: scope }).forEach(function (r) { if (!seen[r.guid]) { seen[r.guid] = true; out.push(r); } });
    });
    return out;
}
var rowsBefore = {};
everyRow().forEach(function (r) { rowsBefore[r.guid] = true; });
var guid = assets.import(file);
// THE MODEL ROWS THIS IMPORT LANDED — each one's OWN bake is the claim (assets.bakeState), never a
// library-wide count. (The object tile names its model through a member row of its own.)
var modelRows = everyRow().filter(function (r) {
    return !rowsBefore[r.guid] && assets.bakeState(r.guid).source !== "";
});
assert(modelRows.length >= 1, "the import landed its model row(s): " + J(modelRows.map(function (r) { return r.type + " " + r.name; })));
modelRows.forEach(function (r) {
    assert(assets.bakeState(r.guid).pending === true, "the " + r.type + " row '" + r.name + "' has its bake pending (held)");
});
assert(guid && guid.length > 10, "assets.import(the node's archive) -> " + guid);
assert(assets.pendingBakes() > 0, "the import returned before its model's bake (" + assets.pendingBakes() + " in flight)");
var meta = assets.metadata(guid);
assert(meta.type === "object", "the file lands as ONE object tile (" + meta.type + ")");
textures.forEach(function (t) {
    assert(!gone(t.guid), "texture '" + t.name + "' is back in the library, from the file");
});

var nodeId = assets.addToScene(guid, { position: { x: -2, y: 3, z: 0 } });
assert(nodeId && nodeId.length > 10, "assets.addToScene(the imported tile) -> " + nodeId);
editor.frame(3, 1 / 60);
assert(assets.pendingBakes() > 0, "the bake is still pending (held)");
var heldBounds = scene.bounds({ nodes: [nodeId] });
assert(heldBounds.nodes === 0, "the node stands with NO geometry before the landing: " + J(heldBounds));
assets.holdBakes(false);
var landGuard = 0;
while (assets.pendingBakes() > 0 && landGuard++ < 600) editor.frame(1, 1 / 60);
assert(assets.pendingBakes() === 0, "the import's bake landed (" + assets.pendingBakes() + " still in flight)");
var landedBounds = scene.bounds({ nodes: [nodeId] });
assert(landedBounds.nodes >= 1, "the landing swapped the geometry into the PLACED node: " + J(landedBounds));
modelRows.forEach(function (r) {
    var state = assets.bakeState(r.guid);
    assert(state.fresh === true && state.pending === false,
           "the import baked the model it brought (the " + r.type + " row '" + r.name + "': " + J(state) + ")");
});
var meshId = null;
scene.nodes().forEach(function (n) {
    if (meshId === null && n.type === "mesh" && (n.id === nodeId || n.parent === nodeId)) meshId = n.id;
});
assert(meshId !== null, "the imported node carries its mesh");
var mat = material.get(meshId);
assert(typeof mat.baseColorMap === "string" && mat.baseColorMap.indexOf("/") >= 0,
       "its base-colour map resolves to a stored file: " + mat.baseColorMap);

// THE FRAMING IS STATED, NOT INHERITED (TESTING-CLEANUP-2 H8d). The quad (2 m, scaled 4) at
// (-2, 3) spans x -6..2, y -1..7; a camera on the axis through (0, 5) puts the centre pixel at
// uv (0.75, 0.25), the GREEN region. This arm used to say editor.setView("front") and rely on
// that view's centre being (0, 5) — true only after an earlier arm of the pool had left the
// editor camera there: SOLO, in a fresh process, the front view sat at (0, 0) (measured:
// position (0, 0, 14.87), orthographic). That was ONE of the two things the pool's order hid;
// the other is a product defect this arm now reports solo (see the commit: the bundle's model
// lands with no mesh bake once the library's own copy is collected).
node.transform(nodeId, { scale: { x: 4, y: 4, z: 4 } });
editor.select(null);
editor.setCamera({ position: { x: 0, y: 5, z: 15 }, lookAt: { x: 0, y: 5, z: 0 } });
editor.frame(5);
var shot = editor.screenshot("node_archive_roundtrip.png", 512, 512);
console.log("centre pixel " + J(shot.center));
assert(shot.center.g > 40, "the re-imported surface renders (not black/sky): g=" + shot.center.g);
assert(shot.center.g > shot.center.r + 20 && shot.center.g > shot.center.b + 20,
       "it samples the GREEN texel region — the map came with the file");

console.log("node_archive_roundtrip: ALL OK");
