// scripting.e2e.ssr_mirror — THE DUAL IMAGE ON A CURVED MIRROR (lane SSR-2;
// the owner's push #35 smoke, rig evidence spikes/smoke-2026-09-15/reportB,
// ledger §321).
//
// WHAT WENT WRONG. With screen-space reflections on, the Mirror Room's chrome
// sphere showed a STIPPLED ghost of the room painted over the probe's smooth
// image; with them off, one image, correctly placed. The cause was the
// composite: the screen's answer was LERPED over the probe's by a per-ray
// confidence, and the two are not two samples of one thing on a mirror — the
// probe is parallax-corrected onto the room's box and captured from a grid
// point, the trace is at the true position and from this frame, so they are the
// same objects in two PLACES. A fraction of two places is both of them, and a
// fraction that changes from pixel to pixel is a dither.
//
// WHY THIS SUITE EXISTS AND NOT A 256x256 ENGINE FIXTURE (tests/ssr §16 says
// the same thing from the other side): the defect needs a PARALLAX-CORRECTED
// PROBE GRID whose answer DISAGREES with the screen's. Every fixture in the
// engine suite falls back to the analytic sky — the same sky the trace is
// looking at — so the two sources agree there and the defect cannot appear.
// The Mirror Room is the scene the owner photographed: 18 probes, a chrome
// sphere at roughness 0.03, a mirror panel, a gold torus and a teapot.
//
// THE MEASUREMENT is SSR on minus SSR off, IN THE SAME OPEN. That matters: the
// sample's GI is not open-to-open deterministic (probe capture order, the VCT
// re-solve), and a cross-open comparison of this scene carries a noise floor of
// about 23 levels. Within one open, everything except the reflections is the
// same frame, so what is left IS the effect.
//
// THE GRADE IS "viewport", deliberately:
//   * "plain" has NO post chain at all by construction (the offscreen
//     determinism law) — hq and off are bit-identical through it, which is
//     what the rig measured and read as "screenshots have no SSR";
//   * "scene" needs an on-screen view that has CONVERGED its exposure, which a
//     script driving frames cannot guarantee;
//   * "viewport" is the whole chain with its own exposure re-seeded from the
//     description — repeatable, and it carries SSR.
//
// THE BAND is the sphere's left limb, where the reflected rays fan fastest and
// the trace is least able to answer: the region the rig photographed. Measured
// at 1600x900 on the owner's pose: 7.58 % of it moved by 10/255 or more before
// the fix, 0.58 % after, so the budget is 2.5 % — about 3x headroom either way.
//
// LANE SSR-3 ADDED A SECOND SUBJECT at the end of the script, on the same open
// and with the same difference-against-SSR-off measure: the World panel's
// "Roughness Cutoff" row now drives the screen-space march as well as the
// traced ray, and closing it has to shrink the marched footprint. See the block
// comment there.

function assert(cond, msg) {
    if (!cond) throw new Error("assert failed: " + msg);
    console.log("ok: " + msg);
}

// @SOURCE_DIR@ is substituted by CMake, the way tests/samples does it: a
// committed script never hardcodes a tree path.
var ZIPS = "@SOURCE_DIR@/scenes/";

var imported = project.importArchive(ZIPS + "Mirror Room.zip");
assert(imported && imported.guid && imported.guid.length > 10, "imported the Mirror Room sample");
assert(project.open(imported.guid) === true, "opened it");
editor.frame(120);

// THE OWNER'S POSE: the teapot large in the foreground, the chrome sphere
// filling the middle, the mirror panel to the left — the framing of
// screenshot4.png, which is where the ghost was photographed.
editor.setCamera({ position: { x: 0.55, y: 1.05, z: 3.30 },
                   lookAt:   { x: 2.10, y: 1.35, z: -0.20 }, fov: 45 });
editor.select(null);
editor.setOverlays({ lightWires: false });
editor.gameView(true);          // no editor furniture in the picture
editor.frame(180);

var W = 1600, H = 900;
// The limb band in pixels at this size: x 390..530, y 240..450. Sampled on a
// grid rather than read whole, because a screenshot verb returns probes.
var PROBES = [];
var NX = 36, NY = 48;
for (var iy = 0; iy < NY; ++iy)
    for (var ix = 0; ix < NX; ++ix)
        PROBES.push({ x: (390 + (140 * ix) / (NX - 1)) / W,
                      y: (240 + (210 * iy) / (NY - 1)) / H });
assert(PROBES.length === NX * NY, "the limb band is sampled at " + PROBES.length + " points");

function shoot(tag) {
    editor.frame(60);
    var r = editor.screenshot("ssr-mirror-" + tag + ".png", W, H, PROBES, "viewport");
    assert(r && r.probes && r.probes.length === PROBES.length,
           tag + ": the shot came back with every probe");
    return r.probes;
}

world.override({ id: "ssr", value: "hq" });
editor.frame(120);
var on = shoot("hq");
world.override({ id: "ssr", value: "off" });
editor.frame(120);
var off = shoot("off");
world.clearOverride({ id: "ssr" });

var moved = 0, worst = 0;
for (var i = 0; i < on.length; ++i) {
    var d = Math.max(Math.abs(on[i].r - off[i].r),
                     Math.abs(on[i].g - off[i].g),
                     Math.abs(on[i].b - off[i].b));
    if (d > worst) worst = d;
    if (d >= 10) ++moved;
}
var pct = (100 * moved) / on.length;
console.log("   limb band: " + moved + " of " + on.length + " samples moved by >= 10/255 (" +
            pct.toFixed(3) + " %), worst " + worst);

// THE ASSERTION. Not "SSR does nothing here" — it still answers wherever the
// trace is well sampled, and the sphere's face-on middle is outside this band
// anyway. What must not come back is the SCREEN OVERRULING THE PROBE ACROSS
// THE LIMB, which is the ghost.
assert(pct < 2.5,
       "the screen does not overrule the probe across the sphere's limb (" +
       pct.toFixed(3) + " % of the band moved, budget 2.5 %; 7.58 % before the rule)");

// ...and the picture is still a picture: SSR must be IN the shot somewhere, or
// the assertion above would pass on a binary that had simply lost the feature.
var FLOOR = [];
for (var fy = 0; fy < 12; ++fy)
    for (var fx = 0; fx < 16; ++fx)
        FLOOR.push({ x: 0.10 + (fx * 0.8) / 15, y: 0.55 + (fy * 0.4) / 11 });
world.override({ id: "ssr", value: "hq" });
editor.frame(120);
var fOn = editor.screenshot("ssr-mirror-floor-hq.png", W, H, FLOOR, "viewport").probes;
world.override({ id: "ssr", value: "off" });
editor.frame(120);
var fOff = editor.screenshot("ssr-mirror-floor-off.png", W, H, FLOOR, "viewport").probes;
world.clearOverride({ id: "ssr" });
var fWorst = 0;
for (var j = 0; j < fOn.length; ++j)
    fWorst = Math.max(fWorst, Math.abs(fOn[j].r - fOff[j].r),
                      Math.abs(fOn[j].g - fOff[j].g), Math.abs(fOn[j].b - fOff[j].b));
console.log("   the rest of the frame: worst SSR delta " + fWorst);
// RE-ANCHORED BY LANE SSR-3, with the verdict: this bar was 10 and the band
// measured 20. The march used to decode the G-buffer's GGX alpha with the
// pre-ogre-patch-0043 range and never square-root it, so its cutoff of 0.35
// was a band on PERCEPTUAL roughness 0.581; it is now the World row's 0.40, in
// the perceptual number the row is stated in. This sample's GreenTeapot is
// authored at exactly 0.40 — comfortably inside the old band, exactly ON the
// new cutoff — so it has stopped contributing a screen reflection and the
// band's worst fell 20 -> 11, measured, with a noise floor of ZERO between two
// shots of one open (spikes/ssr-3/). The bar is 8: still a statement that the
// feature is in the picture, with the headroom the old 10 no longer had.
assert(fWorst >= 8,
       "screen-space reflections are still IN this picture (worst delta " + fWorst + ")");

// ---- THE MARCH TAKES THE WORLD ROW (lane SSR-3) ---------------------------
//
// "Roughness Cutoff" (worldmodes reflectionRoughnessCutoff -> Scene::
// rayReflectRoughness -> PostFxDesc::rayReflectRoughness) used to drive the
// TRACED reflections only; the screen-space march carried a second cutoff of
// its own that nothing in the document could write, and its tooltip could not
// honestly say the word "marched". It can now, and this is the proof from the
// outside: the row moves the SCREEN's picture, in the direction physics
// requires.
//
// THE MEASUREMENT AVOIDS THE SAMPLE'S OPEN-TO-OPEN NOISE the same way the band
// above does — everything is one open, and every number is a difference
// against the SSR-OFF shot taken in it, so the GI, the probes and the exposure
// cancel. This suite runs with JAHSHAKA_NO_RAY_QUERY=1, so the only thing that
// can answer below the cutoff here is the march.
//
// THE DIRECTION IS THE ASSERTION, not a magnitude: closing the cutoff can only
// take surfaces OUT of the marched set (nothing in the composite grows when a
// gate closes), so the footprint at the BOTTOM of the row must be a fraction of
// the one at the TOP of it. The two ends are used rather than the default and
// the bottom because this sample's surfaces sit at 0.02, 0.03, 0.25, 0.40 and
// 0.80 roughness: the default already excludes the walls, so the default and
// the minimum differ by little, while the two ends differ by all of it.
function footprint(tag, probes, off) {
    var mass = 0, far = 0;
    for (var i = 0; i < probes.length; ++i) {
        var d = Math.max(Math.abs(probes[i].r - off[i].r),
                         Math.abs(probes[i].g - off[i].g),
                         Math.abs(probes[i].b - off[i].b));
        mass += d;
        if (d >= 10) ++far;
    }
    console.log("   " + tag + ": mass " + mass + " over " + probes.length +
                " samples, " + far + " of them past 10/255");
    return { mass: mass, far: far };
}

// A grid over the whole frame, so the count is the effect's whole footprint and
// not one surface's.
var ALL = [];
for (var ay = 0; ay < 48; ++ay)
    for (var ax = 0; ax < 64; ++ax)
        ALL.push({ x: 0.01 + (ax * 0.98) / 63, y: 0.01 + (ay * 0.98) / 47 });

world.override({ id: "ssr", value: "off" });
editor.frame(120);
var allOff = editor.screenshot("ssr-cutoff-off.png", W, H, ALL, "viewport").probes;

world.override({ id: "ssr", value: "hq" });
world.override({ id: "reflectionRoughnessCutoff", value: 100 });
editor.frame(120);
var allWide = editor.screenshot("ssr-cutoff-100.png", W, H, ALL, "viewport").probes;
var wide = footprint("cutoff 100 % (the row's maximum)", allWide, allOff);

world.override({ id: "reflectionRoughnessCutoff", value: 5 });
editor.frame(120);
var allTight = editor.screenshot("ssr-cutoff-05.png", W, H, ALL, "viewport").probes;
var tight = footprint("cutoff 5 % (the row's minimum)", allTight, allOff);

world.clearOverride({ id: "reflectionRoughnessCutoff" });
world.clearOverride({ id: "ssr" });

// THE TWO ENDS OF THE ROW, and the row's own physics as the assertion: closing
// the cutoff can only take surfaces OUT of the marched set, so the footprint at
// 5 % must be a fraction of the one at 100 %. Measured on this sample at the
// owner's pose (spikes/ssr-3/): mass 929 at 100 %, 481 at 5 %, 507 at the
// default 40 %; 12 samples past 10/255 against 1. The room's walls are authored
// at roughness 0.8 and its GreenTeapot at 0.40, which is what the top of the
// row reaches and the bottom does not. A march that ignored the row would
// return the same two numbers.
assert(wide.mass > 0 && wide.far > 0,
       "SSR has a footprint at the top of the row (mass " + wide.mass + ", " +
       wide.far + " samples past 10/255)");
assert(tight.mass * 13 < wide.mass * 10,
       "the WORLD ROW drives the screen-space march: closing the cutoff from 100 % to 5 % " +
       "shrinks the marched footprint from mass " + wide.mass + " to " + tight.mass +
       " (budget: the tight one under 0.77 of the wide one)");
assert(tight.far + 4 <= wide.far,
       "...and it removes whole SAMPLES, not just amplitude: " + wide.far + " samples past " +
       "10/255 at 100 %, " + tight.far + " at 5 %");

console.log("scripting.e2e.ssr_mirror complete");
