// assets_import.bundle_pending_clips — A SKINNED NODE PLACED BEFORE ITS BAKE LANDS KEEPS ITS CLIPS
// (STAGE-CLOSE-TRIAGE-1 fix round 3). A share-file import returns before its model's bake commits
// (MeshBakeStore::bakeLandedAsync); a node placed in that window used to read its skeletal clips as
// missing — bind pose, and the {guid, name} references dropped from the next save. Now the reader
// keeps each reference as a placeholder clip and the landing binds the real one in its place.
//
// THE CLAIM: export a placed rigged model (rig2.glb, named clips); take every holder of its content
// out of the library so the import must bake; with the bake HELD (assets.holdBakes) import the file,
// place it, and SAVE while its bake is still pending; release the hold: the live node's clips are the
// real ones (keys, a length); reopen the saved world: the clips are there and they PLAY (the mirror
// pushes them). Fixture: tests/avatar/fixtures/rig2.glb.

function assert(cond, msg) {
    if (!cond) throw new Error("assert failed: " + msg);
    console.log("ok: " + msg);
}
function J(x) { return JSON.stringify(x); }
function gone(guid) { try { assets.metadata(guid); return false; } catch (e) { return true; } }
var FIXTURE = "@SOURCE_DIR@/tests/avatar/fixtures/rig2.glb";
var file = app.dataRoot().root + "/bundle_pending_clips.jbundle";

/// Every skeletal clip in the scene, by name, with its length (the document's view).
function skeletalClips() {
    var out = {};
    scene.nodes().forEach(function (n) {
        anim.list(n.id).forEach(function (a) {
            if (a.skeletal) out[a.name] = Math.max(out[a.name] || 0, a.length);
        });
    });
    return out;
}

// ---- the source: a placed rigged model with clips -------------------------------------
var source = project.create("pending clips source " + Date.now());
var placed = assets.importAndPlace(FIXTURE);
assert(placed.nodeId && placed.assetGuid, "a rigged model placed: " + J(placed));
editor.frame(2, 1 / 60);
var sourceClips = skeletalClips();
var clipNames = Object.keys(sourceClips);
assert(clipNames.length >= 1, "the placed model carries skeletal clips: " + J(sourceClips));
var sourceOid = assets.importSettings(placed.assetGuid).sourceOid;
var r = node.exportArchive(placed.nodeId, file);
assert(r.path === file && r.bytes > 0, "the share file was written: " + J(r));

// ---- an EMPTY library for that content (the import must bake) -------------------------
project.close();
assert(project.remove(source), "the source project is removed");
assets.remove(placed.assetGuid, { keepShared: false, force: true });
assets.list({ scope: "store", type: "object" }).forEach(function (row) {
    var oid = null;
    try { oid = assets.importSettings(row.guid).sourceOid; } catch (e) { }
    if (oid === sourceOid) assets.remove(row.guid, { keepShared: false, force: true });
});
assets.gc({ dryRun: false });

// ---- import, place and SAVE while the bake is held ------------------------------------
var target = project.create("pending clips target " + Date.now());
assert(assets.holdBakes(true) === true, "the bake commit is held");
var guid = assets.import(file);
assert(guid && guid.length > 10, "assets.import(the share file) -> " + guid);
assert(assets.pendingBakes() > 0, "its model's bake is pending (" + assets.pendingBakes() + ")");
var nodeId = assets.addToScene(guid, { position: { x: 0, y: 0, z: 0 } });
assert(nodeId && nodeId.length > 10, "placed while the bake is pending -> " + nodeId);
editor.frame(40, 1 / 60);   // past the mirror's static settle (30 quiet frames)
assert(assets.pendingBakes() > 0, "still pending after 40 frames (the hold)");
var waiting = skeletalClips();
clipNames.forEach(function (name) {
    assert(name in waiting, "the clip '" + name + "' is kept on the node while its bake is pending: " + J(waiting));
});
assert(project.save() === true, "the world is SAVED before the landing");

// ---- the landing: the real clips are bound ---------------------------------------------
assets.holdBakes(false);
var guard = 0;
while (assets.pendingBakes() > 0 && guard++ < 600) editor.frame(1, 1 / 60);
assert(assets.pendingBakes() === 0, "the bake landed after " + guard + " frame(s)");
editor.frame(2, 1 / 60);
var landed = skeletalClips();
clipNames.forEach(function (name) {
    assert(landed[name] > 0, "the landing bound the real clip '" + name + "' (length " + landed[name] + ")");
});
console.log("engine errors after the landing: " + J(app.engineErrors(true).recorded));

// ---- reopen the world saved BEFORE the landing: the clips are there and play ------------
project.close();
assert(project.open(target) === true, "the saved world reopens");
editor.frame(4, 1 / 60);
var reopened = skeletalClips();
clipNames.forEach(function (name) {
    assert(reopened[name] > 0, "the reopened world carries the clip '" + name + "' (length " + reopened[name] + ")");
});
var before = scene.rigStats();
assert(before.rigged >= 1, "the character is rigged in the reopened world: " + J(before));
assert(editor.play() === true, "play");
editor.frame(30, 1 / 60);
var after = scene.rigStats();
editor.stop();
assert(after.clipPushes > before.clipPushes,
       "its clips PLAY: the mirror pushed them (" + before.clipPushes + " -> " + after.clipPushes + ")");
console.log("bundle_pending_clips: ALL OK");
