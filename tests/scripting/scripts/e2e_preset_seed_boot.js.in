// scripting.e2e.preset_seed_boot — THE ROUTE A PERSON TAKES (SEED-STAMP-1).
//
// `scripting.e2e.preset_apply` seeds through `materials.seedPresets()`, which
// mints each map inside `MaterialPresetAssets::definitionFor` and stamps it
// there. NOBODY TAKES THAT ROUTE AT A FIRST LAUNCH: the app starts
// `MaterialPresetSeeder`, which imports the maps AHEAD of the row pass (off
// the thread that draws — services/materialpresetseeder.h), so by the time
// `definitionFor` looks, every map is an existing row found by content, its
// `minted` is false, and the stamp never fired. Measured on this route before
// the fix: 31 member maps, 0 stamped, and 34 texture tiles standing in the
// tray and on the Assets page as if the user had imported them — the owner's
// R10.2 complaint, alive on the only route he uses.
//
// THIS ROW RUNS THAT SEED FOR REAL: a window (the seeder is started from
// MainWindow), a fresh data root, and JAHSHAKA_SEED_PRESETS=1 — the env that
// lets a driven session take the launch seed. Nothing here calls
// `seedPresets()`: that verb would stand the seeder down and do the work
// itself, which is precisely the route this test is not about.
//
// Arm 1 (e2e_preset_seed_user.js) has already imported ONE of the maps as the
// user, into this same data root.

function assert(cond, msg) {
    if (!cond) throw new Error("assert failed: " + msg);
    console.log("ok: " + msg);
}

var PRESET_MAP = "@SOURCE_DIR@/app/content/materials/presets/wood/wood_planks_03_1_COLOR.png";
var userMapName = PRESET_MAP.split("/").pop();

// ---- wait for the LAUNCH seed, by polling a verb -------------------------
// The script runs on its own thread and the UI thread is free between verbs
// (that is what makes the seeder progress at all), so a poll is a wait. The
// budget is generous because this is a real import of 31 pictures through the
// pipeline, on whatever device the store is on.
//
// AND WITH A PAUSE IN IT (SEED-SMALL-1). A bare poll is not a wait: every verb
// is a posted blocking-queued event, Qt serves posted events before
// zero-timers, and the seeder advances on a `QTimer::singleShot(0)` per preset
// — so a tight loop competes with the turns it is waiting for. `sleep(ms)` is
// the host global that parks THIS thread and leaves the UI thread alone
// (docs/SCRIPTING.md preamble; `editor.frame(1)` would do as well here, but
// not in the headless arms that share these assertions).
//
// HOW MANY BUNDLES is the shipped TABLE, read live, never a literal: the one
// place in the tree that names its size is tests/libraryreset/reset.js.
var EXPECTED_BUNDLES = materials.presets().length;
var deadline = Date.now() + 120000;
var mats = [];
while (Date.now() < deadline) {
    mats = assets.list({ scope: "store", type: "material" });
    if (mats.length >= EXPECTED_BUNDLES) break;
    sleep(50);
}
assert(mats.length === EXPECTED_BUNDLES,
       "the LAUNCH seed put every shipped preset bundle in the library ("
       + mats.length + " of " + EXPECTED_BUNDLES + ")");

// ---- every map is a MEMBER, stamped with the preset it came in through ----
var members = {};          // guid -> name
var memberCount = 0;
var userGuid = "";
for (var i = 0; i < mats.length; ++i) {
    var list = materials.members(mats[i].guid);
    for (var j = 0; j < list.length; ++j) {
        var m = list[j];
        if (!members.hasOwnProperty(m.guid)) { members[m.guid] = m.name; memberCount++; }
        if (m.name === userMapName) userGuid = m.guid;
    }
}
// THE RULE, NOT THE NUMBER: the census is whatever the shipped table names,
// and every assertion below is stated against THAT (SEED-SMALL-1). Printed so
// a change in the content is readable in the log without being a failure.
console.log("MAP_COUNT=" + memberCount);
assert(memberCount > 0, "they name map textures between them (" + memberCount + ")");
assert(userGuid.length > 10, "…including the one the user imported first (" + userMapName + ")");

var presetGuids = {};
for (var p = 0; p < mats.length; ++p) presetGuids[mats[p].guid] = true;

var stamped = 0, unstamped = [];
for (var guid in members) {
    if (!members.hasOwnProperty(guid)) continue;
    var meta = assets.metadata(guid);
    if (meta.member === true) {
        stamped++;
        assert(presetGuids.hasOwnProperty(meta.memberOf),
               "…" + members[guid] + " names a shipped preset as its origin (" + meta.memberOf + ")");
    } else {
        unstamped.push(members[guid] + " " + guid);
    }
}
// EVERY MAP BUT THE USER'S OWN ONE — the rule the count 30-of-31 used to
// spell out, now stated so a twenty-first preset cannot red it.
assert(stamped === memberCount - 1,
       "THE LAUNCH SEED STAMPED EVERY MAP IT MINTED (" + stamped + " of " + memberCount
       + ", the one it did not mint being the user's)");
assert(unstamped.length === 1 && unstamped[0].indexOf(userMapName) === 0,
       "…and exactly one is unstamped: the picture the USER imported before the seed ("
       + unstamped.join(", ") + ")");

// A SEED MAY NOT QUIETLY HIDE A ROW THE USER ALREADY HAD (V-2's other half):
// the preset uses their row — one picture, one object, one guid — and it is
// still their tile.
var userMeta = assets.metadata(userGuid);
assert(userMeta.member !== true, "the user's own row was NOT stamped by the seed");
assert(userMeta.memberOf === undefined, "…and carries no origin");

// ---- and so they are not tiles -------------------------------------------
var tiles = assets.list({ scope: "store", type: "texture" });
assert(tiles.length === 1 && tiles[0].guid === userGuid,
       "THE ASSETS PAGE LISTS NO PRESET MAP — only the user's own picture ("
       + tiles.length + " texture tile(s))");

var withMembers = assets.list({ scope: "store", type: "texture", members: true });
// ONE ROW PER PICTURE. The seed asks the library "do you have these bytes"
// BEFORE it imports anything, so two shipped spellings of one file used to
// answer "no" twice and mint two rows — and the second, named by no
// definition, could never be stamped and stood in the tray for ever (3 of the
// 34 rows this route used to leave). Equality here is that guard: every
// texture row in the library is a map some bundle names, or the user's own.
assert(withMembers.length === memberCount,
       "…'Show member textures' finds each of them ONCE and nothing else — the seed "
       + "minted no row no bundle names (" + withMembers.length + " rows, "
       + memberCount + " members)");

// ---- the editor tray says the same thing ---------------------------------
var made = project.create("Seed Boot Tray");
assert(made.length > 10, "a project opens for the tray listing");
var tray = assets.list({ scope: "project", tray: true, type: "texture" });
var leaked = [];
for (var t = 0; t < tray.length; ++t)
    if (members.hasOwnProperty(tray[t].guid) && tray[t].guid !== userGuid)
        leaked.push(tray[t].name);
assert(leaked.length === 0, "THE TRAY CARRIES NO PRESET MAP (" + leaked.join(", ") + ")");

console.log("ALL PASS");
