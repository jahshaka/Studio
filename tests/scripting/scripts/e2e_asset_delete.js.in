// scripting.e2e.asset_delete — assets.remove tells the truth.
//
// The defect this guards (2026-09-03): every library delete in a live session
// no-opped and reported success. Database::deleteAsset ran three statements
// (assets / asset_files / project_assets) and returned only the last one's
// result while ignoring the other two, and assets.remove threw that result
// away entirely and returned true unconditionally. The DB errors were logged
// at [info] as the SQLite driver's misleading "Parameter count mismatch".
//
// Runs the real binary with --script --headless (every verb here is a document
// verb) against a scratch HOME — a fresh JahLibrary.db, never the user's.

function assert(cond, msg) {
    if (!cond) throw new Error("assert failed: " + msg);
    console.log("ok: " + msg);
}
function assetByGuid(guid) {
    var all = assets.list({ scope: "store" });
    for (var i = 0; i < all.length; i++) if (all[i].guid === guid) return all[i];
    return null;
}
function mustThrow(fn, msg) {
    var threw = false;
    try { fn(); } catch (e) { threw = true; }
    assert(threw, msg);
}
// The suite's library DB is NOT wiped between ctest runs, and importing
// content that matches an UNLISTED row re-lists that row instead of making a
// duplicate (library-delete law). So an interrupted earlier run could hand us
// a row that already carries a pin: take the leftover out for good and import
// again, so every assertion below starts from a genuinely fresh row.
function freshImport(path) {
    var guid = assets.importFile(path);
    if (assets.pins(guid).length > 0) {
        assets.remove(guid, { force: true });
        guid = assets.importFile(path);
    }
    return guid;
}

project.create("asset_delete_" + Date.now());

// ---- a real library row, with stored content and a project pin ------------
var png = freshImport("@SOURCE_DIR@/tests/scripting/fixtures/tiny.png");
assert(png.length > 10, "assets.importFile(png) -> " + png);
assert(assetByGuid(png) !== null, "the imported asset is listed in the library");

// ---- remove, and the row is REALLY gone ----------------------------------
assert(assets.remove(png) === true, "assets.remove reports success");
assert(assetByGuid(png) === null, "the asset is no longer listed");

// A second remove of the same guid must NOT claim success: there is no row.
mustThrow(function () { assets.remove(png); },
          "assets.remove of an already-deleted guid fails instead of lying");
mustThrow(function () { assets.remove("no-such-guid-at-all"); },
          "assets.remove of an unknown guid fails");

// ---- the deep variant takes the dependency rows with it ------------------
var wav = freshImport("@SOURCE_DIR@/tests/scripting/fixtures/tiny.wav");
assert(wav.length > 10, "assets.importFile(wav) -> " + wav);
assert(assets.remove(wav, { keepShared: false }) === true,
       "assets.remove(keepShared:false) reports success");
assert(assetByGuid(wav) === null, "the deep-removed asset is gone too");

// ==========================================================================
// LIBRARY DELETE KEEPS PROJECT PINS (owner law, 2026-09-09)
// ==========================================================================
// "Deleting an asset from the LIBRARY should not delete it from a project."
// A delete of a PINNED asset unlists it: gone from the library listing,
// present for every project that pinned it, its content still REFERENCED.

function pinnedListing(guid) {
    return assets.pins(guid).map(function (p) { return p.name; });
}
function gcObjectIds() {
    // the classes block of the sweep report; `id` of an unreferenced object is
    // its content id (oid)
    return assets.gc({ dryRun: true }).classes.unreferencedObjects.items
                 .map(function (i) { return i.id; });
}

var stamp = Date.now();
var projA = project.create("libdel_A_" + stamp);
assert(projA.length > 10, "project A created -> " + projA);

var clip = freshImport("@SOURCE_DIR@/tests/scripting/fixtures/tiny.wav");
assert(clip.length > 10, "a second library asset imported -> " + clip);
var clipOid = assets.importSettings(clip).sourceOid;
assert(clipOid.length === 64, "its stored content id is known: " + clipOid);
assert(assetByGuid(clip) !== null, "it is listed in the library");
assert(assets.pins(clip).length === 0, "nothing pins it yet");
assert(assets.metadata(clip).listed === true, "assets.metadata reports it listed");
assert(assets.metadata(clip).pinCount === 0, "... with a pin count of 0");

// ---- pin it into project A ------------------------------------------------
assert(assets.addToProject(clip) === clip, "assets.addToProject pins it (same guid)");
assert(assets.pins(clip).length === 1, "assets.pins sees exactly one project");
assert(pinnedListing(clip)[0] === "libdel_A_" + stamp,
       "... named: " + pinnedListing(clip).join(", "));

// ---- the library delete: an UNLIST ---------------------------------------
var errorBefore = app.lastError();   // sticky: the mustThrow calls above set one
assert(assets.remove(clip) === true, "assets.remove of a PINNED asset reports success");
assert(app.lastError() === errorBefore,
       "... and records NO new error (an unlist is a success, not a refusal)");
assert(assetByGuid(clip) === null, "the library listing no longer shows it");
assert(assets.metadata(clip).listed === false, "assets.metadata reports listed: false");
assert(assets.metadata(clip).pinCount === 1, "... and pinCount 1");
assert(pinnedListing(clip)[0] === "libdel_A_" + stamp,
       "assets.pins STILL names project A — the pin survived the library delete");
assert(gcObjectIds().indexOf(clipOid) === -1,
       "assets.gc reports its content as REFERENCED, not reclaimable");

// ---- and project A still resolves it --------------------------------------
var projB = project.create("libdel_B_" + stamp);
assert(project.open(projA) === true, "project A reopened");
var inProject = assets.list({ scope: "project" }).filter(function (a) { return a.guid === clip; });
assert(inProject.length === 1, "the unlisted asset is still a member of project A");
assert(assets.metadata(clip).guid === clip, "and still resolves by guid");

// ---- re-importing the same content RE-LISTS the same row ------------------
var again = assets.importFile("@SOURCE_DIR@/tests/scripting/fixtures/tiny.wav");
assert(again === clip, "re-importing the same content re-lists the SAME row, no duplicate");
assert(assetByGuid(clip) !== null, "... and the library tile is back");
assert(assets.metadata(clip).listed === true, "... listed again");
assert(assets.pins(clip).length === 1, "... with its pin untouched");

// ---- force: the hard delete ----------------------------------------------
mustThrow(function () { assets.remove(clip, { everywhere: true }); },
          "assets.remove refuses an unknown option instead of ignoring it");
assert(assets.remove(clip, { force: true }) === true, "assets.remove(force) reports success");
assert(assetByGuid(clip) === null, "the asset is gone from the library");
mustThrow(function () { assets.pins(clip); }, "assets.pins of a deleted asset fails");
assert(project.open(projA) === true, "project A reopened after the hard delete");
assert(assets.list({ scope: "project" }).filter(function (a) { return a.guid === clip; }).length === 0,
       "the hard delete DID take it out of the project");
assert(gcObjectIds().indexOf(clipOid) !== -1,
       "and its content is now reclaimable by assets.gc");

// ---- the PROJECT-side remove (code review 2026-09-10) ----------------------
// The project panel's Delete is assets.removeFromProject: the pin goes, the
// library row stays listed; a row already removed from the library that loses
// its last pin is reaped.
// (an AUDIO fixture: adding an IMAGE to a project also mints its companion
// image material, which then hides the texture from the library grid as a
// dependee — a separate question, MASTER_QUEUE §26.)
var pr = freshImport("@SOURCE_DIR@/tests/scripting/fixtures/tiny.wav");
assert(pr.length > 10, "a fresh import for the project-side remove");
assert(project.create("Delete E " + Date.now()).length > 10, "project E");
var prIn = assets.addToProject(pr);
assert(prIn.length > 10 && assets.pins(pr).length === 1, "pinned by project E");
assert(assets.removeFromProject(pr) === true, "assets.removeFromProject");
assert(assets.pins(pr).length === 0, "the pin is gone");
assert(assets.metadata(pr).listed === true, "the library row is still LISTED");
assert(assets.list({ scope: "project" }).filter(function (a) { return a.guid === pr; }).length === 0,
       "and the project no longer lists it");
assert(assets.list({ scope: "store" }).filter(function (a) { return a.guid === pr; }).length === 1,
       "while the library still does");
// unlisted + last pin dropped = reaped
assert(assets.addToProject(pr).length > 10, "pinned again");
assert(assets.remove(pr) === true && assets.metadata(pr).listed === false, "removed from the library (unlisted, pinned)");
assert(assets.removeFromProject(pr) === true, "then removed from its last project");
mustThrow(function () { assets.metadata(pr); }, "the orphaned unlisted row was reaped");
mustThrow(function () { assets.removeFromProject("no-such-guid"); }, "unknown guid refused");

// ==========================================================================
// THE CODE-REVIEW FOLLOW-UPS (MASTER_QUEUE §26 item 5b)
// ==========================================================================

// ---- re-listing files a DRAWER, and never resurrects a hidden DEPENDEE -----
//
// (1) A re-list is this import's answer, so it must land where the import
// asked: a drop into a drawer that happened to match an unlisted row used to
// file nothing at all.
var drawerId = assets.createDrawer("Relist Target " + Date.now());
assert(drawerId > 0, "a drawer to re-list into -> " + drawerId);
var dr = freshImport("@SOURCE_DIR@/tests/scripting/fixtures/tiny.wav");
assert(assets.addToProject(dr) === dr, "pinned, so the library delete unlists it");
assert(assets.remove(dr) === true && assets.metadata(dr).listed === false,
       "removed from the library (unlisted, pinned)");
var relisted = assets.importFile("@SOURCE_DIR@/tests/scripting/fixtures/tiny.wav", drawerId);
assert(relisted === dr, "the re-import re-listed the SAME row");
assert(assets.metadata(dr).listed === true, "... and it is a library tile again");
assert(assets.list({ scope: "store", drawer: drawerId })
             .filter(function (a) { return a.guid === dr; }).length === 1,
       "... FILED IN THE DRAWER the import named");
assert(assets.remove(dr, { force: true }) === true, "cleaned up");

// (2) A MEMBER row (a model's texture) is hidden from every listing as a
// dependee, so re-listing it would answer the import with a row the user can
// never see. It must get its own, visible row instead — sharing the same CAS
// object, so it costs no bytes.
var GLB = "@SOURCE_DIR@/tests/importer/fixtures/textured_pbr_quad.glb";
var model = assets.importFile(GLB);
assert(model.length > 10, "the textured model imported -> " + model);
var textures = assets.dependencies(model).filter(function (g) {
    return g !== model && assets.metadata(g).type === "texture";
});
assert(textures.length >= 1, "it carries texture MEMBER rows: " + textures.length);
var member = textures[0];
var memberName = assets.metadata(member).name;
assert(assets.list({ scope: "store" }).filter(function (a) { return a.guid === member; }).length === 0,
       "a member row is hidden from the library listing (a dependee)");

var raw = assets.exportRaw(model, "libdel-relist-raw");
assert(raw.files.indexOf(memberName) >= 0,
       "the member's bytes are on disk under their own name: " + memberName);
assert(assets.addToProject(model) === model, "the model is pinned into the project with its closure");
// The member is pinned now (add-to-project pins the whole closure), so a
// library delete of the member row UNLISTS it — the exact state the fix
// guards: an unlisted row that no listing shows, holding this content id.
assert(assets.remove(member) === true, "the library delete of the pinned member reports success");
assert(assets.metadata(member).listed === false, "the texture MEMBER is UNLISTED");

var standalone = assets.importFile(raw.dir + "/" + memberName);
assert(standalone.length > 10, "the same texture imported standalone -> " + standalone);
assert(standalone !== member,
       "THE FIX: the hidden dependee was NOT resurrected as the answer");
assert(assets.metadata(standalone).listed === true, "the new row is listed");
assert(assets.list({ scope: "store" }).filter(function (a) { return a.guid === standalone; }).length === 1,
       "... and it really IS a library tile the user can see");
assert(assets.metadata(member).listed === false, "... while the member stays unlisted");
assert(assets.remove(standalone, { force: true }) === true, "cleaned up");
// AND THE MODEL GOES TOO. This suite's library HOME survives between ctest
// runs, so anything left pinned accumulates a set of rows per run — and an
// unlisted member is a row nothing lists and nothing else would ever clean up.
// force + keepShared:false takes the model, its members and their pins.
assert(assets.remove(model, { keepShared: false, force: true }) === true,
       "the model and its members are removed for good (this home is reused)");
assert(assets.list({ scope: "project" }).filter(function (a) { return a.guid === model; }).length === 0,
       "... and the project no longer pins it");

// ---- removeFromProject takes the AUTO-MINTED COMPANION with the image ------
//
// Adding an IMAGE to a project mints a companion PBR material for it and pins
// that too (IMAGE_PLANE_SPEC §8.1). Removing the image while leaving the
// material left a material tile in the bin for a picture no longer in the
// project. The add created it; the remove takes it back out. The LIBRARY row
// is never touched.
function companionsOf(textureGuid) {
    return assets.list({ scope: "store", type: "material" }).filter(function (m) {
        var deps = assets.dependencies(m.guid);   // the asset plus its closure
        return deps.length === 2 && deps.indexOf(textureGuid) >= 0;
    }).map(function (m) { return m.guid; });
}
var PNG = "@SOURCE_DIR@/tests/scripting/fixtures/implane_wide.png";
{
    // Scrub whatever an earlier run left: a companion that already exists
    // stops a fresh one from being minted (the idempotence guard).
    var stale = assets.importFile(PNG);
    companionsOf(stale).forEach(function (c) { assets.remove(c, { force: true }); });
    assets.remove(stale, { force: true });
}
assert(project.create("libdel_companion_" + Date.now()).length > 10, "a project for the image");
var image = assets.importFile(PNG);
assert(image.length > 10, "the image imported -> " + image);
assert(companionsOf(image).length === 0, "no companion material exists yet");
assert(assets.addToProject(image) === image, "the image is added to the project");
var companions = companionsOf(image);
assert(companions.length === 1, "the add minted exactly one companion material");
var companion = companions[0];
assert(assets.pins(companion).length === 1, "the companion is pinned into the project");
assert(assets.list({ scope: "project", type: "material" })
             .filter(function (m) { return m.guid === companion; }).length === 1,
       "... and shows in the project's materials");

assert(assets.removeFromProject(image) === true, "assets.removeFromProject(image)");
assert(assets.pins(image).length === 0, "the image's pin is gone");
assert(assets.pins(companion).length === 0,
       "THE DECISION: the auto-minted companion left the project with it");
assert(assets.list({ scope: "project", type: "material" })
             .filter(function (m) { return m.guid === companion; }).length === 0,
       "... so the project's materials no longer show it");
assert(assets.metadata(companion).listed === true,
       "... while its LIBRARY row is untouched (this is a project-side remove)");
assert(assets.metadata(image).listed === true, "... and so is the image's");
assets.remove(companion, { force: true });
assert(assets.remove(image, { force: true }) === true, "cleaned up");

console.log("asset delete e2e passed");
