// scripting.e2e.ogre_ports — THE PORTS THEMSELVES (SPECS/OGRE_SAMPLES_TAB_SPEC.md
// §3): the thirteen archives the Ogre-Samples tab opens, imported into a virgin
// home, opened, rendered and measured.
//
// The companion suite scripting.e2e.ogre_samples is the VERB half (the curated
// inventory and the launch refusal, headless, with no display). This is the
// CONTENT half: each port archive really imports, really opens and really
// renders a picture that is neither black nor blown out, with the lights, the
// world settings and the materials its authoring script put there.
//
// ONE SESSION, THIRTEEN ARCHIVES, on purpose: eight of the ports share one base
// scene and three share the room, so importing them back to back into one
// library is also the cross-archive dedup case — and it costs a thirteenth of
// what thirteen app launches would.
//
// WHAT IS *NOT* ASSERTED, deliberately:
//   * exact pixels. Several of these scenes carry GI, refraction or planar
//     reflections and none of those is open-to-open deterministic (the
//     mesh-bake facts: Showroom's centre pixel swings +-80 between identical
//     opens). The pixel claim here is the WIDE one — colour, not blackness, not
//     white-out.
//   * that reflection probes were PLACED in the room ports. They are refused
//     today by the enclosure rule (a wall made of four panels reads as open —
//     the lane's engine finding), and a test that asserted the refusal would
//     turn red on the day the rule is fixed. The suite asserts what the SCENE
//     asks for, which does not move.

var SOURCE = "@SOURCE_DIR@";

function assert(cond, msg) {
    if (!cond) throw new Error("assert failed: " + msg);
    console.log("ok: " + msg);
}
function J(x) { return JSON.stringify(x); }

// name, the nodes it must carry, how many lights of its own, the GI mode its
// authoring script left behind, and any per-port check.
var PORTS = [
    { name: "PbsMaterials", nodes: 85, lights: 4, gi: "off",
      names: ["Floor", "Sun", "Sky Light", "Warm Spot", "Cold Spot",
              "GridSphere0", "Palette_r0_f0", "Palette_r7_f7"],
      check: function () {
          var lo = material.get(scene.find("Palette_r0_f0"));
          var hi = material.get(scene.find("Palette_r7_f7"));
          assert(lo.workflow === 1 && hi.workflow === 1,
                 "PbsMaterials: the palette is on the Specular workflow");
          assert(Math.abs(lo.roughness - 0.02) < 1e-3 && Math.abs(hi.roughness - 1.0) < 1e-3,
                 "PbsMaterials: the roughness axis survived (" + lo.roughness + " -> " + hi.roughness + ")");
          assert(lo.fresnelColor === "#000000" && hi.fresnelColor === "#ffffff",
                 "PbsMaterials: the fresnel axis survived (" + lo.fresnelColor + " -> " + hi.fresnelColor + ")");
          // THE PORTABILITY LAW, as a test: the floor's maps must resolve to
          // real files inside THIS home, which they can only do if the archive
          // carried their bytes.
          var floor = material.get(scene.find("Floor"));
          assert(floor.baseColorMap.length > 0 && floor.normalMap.length > 0,
                 "PbsMaterials: the floor's maps travelled inside the archive");
      } },
    { name: "LocalCubemaps", nodes: 28, lights: 4, gi: "vct_pcc_hybrid",
      names: ["Sun", "Sky Light", "Warm Spot", "Cold Spot", "Room00_Cream", "Room22_Red"],
      check: function () {
          var g = world.get().gi;
          assert(g.pccGrid.x === 1 && g.pccGrid.y === 1 && g.pccGrid.z === 3,
                 "LocalCubemaps: the 1 x 1 x 3 probe grid survived the round trip");
          var st = world.giStatus();
          console.log("LocalCubemaps probes: " + st.probeCount +
                      " dropped=" + st.probesDropped);
      } },
    { name: "Refractions", nodes: 86, lights: 4, gi: "off",
      names: ["Floor", "Glass Wall", "Sun", "Sky Light", "Glass_r0_f0", "Glass_r7_f7"],
      check: function () {
          assert(world.settings().refractions.valueId === "on",
                 "Refractions: the refraction pass is pinned on");
          var glass = material.get(scene.find("Glass_r3_f3"));
          assert(glass.alphaMode === 6, "Refractions: the palette is refractive (alphaMode 6)");
          assert(Math.abs(glass.alpha - 0.15) < 1e-3,
                 "Refractions: at their 15% transparency (" + glass.alpha + ")");
      } },
    { name: "Hdr", nodes: 85, lights: 4, gi: "off",
      names: ["Floor", "Sun", "Sky Light", "Palette_r0_f0"],
      check: function () {
          var fx = world.get().postFx;
          assert(Math.abs(fx.exposureMin + 1.0) < 1e-3 && Math.abs(fx.exposureMax - 2.5) < 1e-3,
                 "Hdr: their bright-day exposure window survived (" +
                 fx.exposureMin + " .. " + fx.exposureMax + ")");
          var sun = node.property(world.sun().light, "intensity");
          assert(Math.abs(sun - 97.0 / Math.PI) < 1e-2,
                 "Hdr: the sun still carries their 97.0 power scale (" + sun.toFixed(3) + ")");
          assert(material.get(scene.find("Palette_r0_f0")).brdf === 3,
                 "Hdr: their DefaultHasDiffuseFresnel BRDF survived");
      } },
    { name: "AreaApproxLights", nodes: 85, lights: 4, gi: "off",
      names: ["Floor", "Sun", "Sky Light", "Warm Area", "Cold Area"],
      check: function () {
          var w = scene.find("Warm Area");
          assert(Math.abs(node.property(w, "rectWidth") - 15) < 1e-3,
                 "AreaApproxLights: the warm light is still 15 m wide");
          assert(node.lightTexture(w).applies === true,
                 "AreaApproxLights: its mask still applies (approximate, not accurate)");
      } },
    { name: "IesProfiles", nodes: 9, lights: 6, gi: "off",
      names: ["Floor", "Wall", "No Profile", "Narrow Beam", "Wide Flood", "Batwing"],
      check: function () {
          ["Narrow Beam", "Wide Flood", "Batwing"].forEach(function (n) {
              var p = node.lightProfile(scene.find(n));
              assert(p.guid.length > 10 && p.applies === true,
                     "IesProfiles: '" + n + "' still wears its profile (" + p.normalisation + ")");
          });
          assert(node.lightProfile(scene.find("No Profile")).guid === "",
                 "IesProfiles: the control light still has none");
      } },
    { name: "ShadowMapFromCode", nodes: 22, lights: 6, gi: "off",
      names: ["Floor", "Sun", "Red Point", "Green Point"],
      check: function () {
          assert(world.shadowResolution() === 2048, "ShadowMapFromCode: still at their 2048");
          var sh = world.shadowStatus();
          assert(sh.sun && sh.sun.length > 0, "ShadowMapFromCode: the sun casts the directional shadow");
          assert(sh.maps >= 4, "ShadowMapFromCode: four lamps hold a map (" + sh.maps + ")");
      } },
    { name: "PlanarReflections", nodes: 22, lights: 4, gi: "off",
      names: ["Floor", "Mirror", "Rough Mirror"],
      check: function () {
          assert(node.planarReflector(scene.find("Mirror")) === true,
                 "PlanarReflections: the perfect mirror is still a reflection plane");
          assert(node.planarReflector(scene.find("Rough Mirror")) === true,
                 "PlanarReflections: the rough mirror is still one");
          assert(world.planarReflections().budget === 2,
                 "PlanarReflections: the budget of two survived");
      } },
    { name: "ScreenSpaceReflections", nodes: 28, lights: 4, gi: "vct_pcc_hybrid",
      names: ["Room00_Cream", "Room22_Red", "Warm Spot"],
      check: function () {
          assert(world.settings().ssr.valueId === "hq",
                 "SSR: still pinned to full-res rays");
          var r = material.get(scene.find("Room22_Red"));
          assert(Math.abs(r.roughness - 0.02) < 1e-3,
                 "SSR: the room is still polished at 0.02 (" + r.roughness + ")");
      } },
    { name: "Tutorial_SSAO", nodes: 68, lights: 4, gi: "off",
      names: ["Floor", "Ball_r0_f0", "Ball_r7_f7"],
      check: function () {
          assert(world.settings().ssao.valueId === "half", "SSAO: the pass is still on at half res");
          var fx = world.get().postFx;
          assert(Math.abs(fx.ssaoRadius - 2.0) < 1e-3 && Math.abs(fx.ssaoPower - 1.5) < 1e-3,
                 "SSAO: reach 2 m at power 1.5 survived");
      } },
    { name: "Tutorial_SMAA", nodes: 20, lights: 4, gi: "off",
      names: ["Floor", "GridCube1", "Sun"],
      check: function () {
          assert(world.settings().smaa.valueId === "ultra", "SMAA: still Ultra");
          assert(world.antiAliasing() === 1, "SMAA: MSAA is still off, so SMAA is the whole budget");
      } },
    { name: "Decals", nodes: 21, lights: 4, gi: "off",
      names: ["Floor", "Decal", "Sun"],
      check: function () {
          var maps = node.decalMaps(scene.find("Decal"));
          assert(maps.diffuse.guid.length > 10 && maps.normal.guid.length > 10,
                 "Decals: both projected maps survived the round trip");
          assert(maps.diffuse.path.length > 0 && maps.normal.path.length > 0,
                 "Decals: and their bytes travelled inside the archive");
          assert(Math.abs(node.property(scene.find("Decal"), "depth") - 10) < 1e-3,
                 "Decals: their 10 m projection depth survived");
      } },
    { name: "ImageVoxelizer", nodes: 35, lights: 5, gi: "vct",
      names: ["Room00_Cream", "Cornell Red Wall", "Cornell Green Wall",
              "Cornell Tall Block", "Cornell Lamp"],
      check: function () {
          var st = world.giStatus();
          assert(st.mode === "vct", "Voxelizer: still cone-tracing voxels (" + st.mode + ")");
          assert(st.voxelMetres > 0, "Voxelizer: a voxel size was resolved (" + st.voxelMetres + " m)");
          // The Cornell box IS the substitution: its two coloured walls are
          // what makes the bounce readable, so they are named in the document.
          var red = material.get(scene.find("Cornell Red Wall"));
          assert(red.baseColor === "#cc1111", "Voxelizer: the red wall is still red");
      } }
];

function renderSanity(tag) {
    editor.frame(60, 1.0 / 60.0);
    var pts = [];
    for (var y = 0; y < 5; y++) for (var x = 0; x < 5; x++)
        pts.push({ x: 0.1 + x * 0.2, y: 0.1 + y * 0.2 });
    var shot = editor.screenshot("ogre_port_" + tag + ".png", 640, 360, pts);
    var black = 0, mean = 0, spread = 0;
    for (var i = 0; i < shot.probes.length; i++) {
        var p = shot.probes[i], b = (p.r + p.g + p.b) / 3;
        mean += b;
        if (b < 2) black++;
        spread = Math.max(spread, Math.abs(p.r - p.b), Math.abs(p.g - p.b));
    }
    mean /= shot.probes.length;
    console.log(tag + " pixels: mean=" + Math.round(mean) + " black=" + black +
                " maxChannelSpread=" + spread);
    assert(black <= 14, tag + ": the frame is not mostly black (" + black + "/25 probes)");
    assert(mean > 2 && mean < 250, tag + ": usable exposure (mean " + Math.round(mean) + ")");
    return shot;
}

for (var pi = 0; pi < PORTS.length; ++pi) {
    var port = PORTS[pi];
    var zip = SOURCE + "/scenes/ogre/" + port.name + ".zip";

    var imported = project.importArchive(zip);
    assert(imported && imported.guid && imported.guid.length > 10,
           port.name + ": importArchive -> " + (imported ? imported.guid : "null"));
    assert(project.open(imported.guid) === true, port.name + ": project.open");

    // ---- the document ----
    var nodes = scene.nodes();
    assert(nodes.length >= port.nodes,
           port.name + ": " + nodes.length + " nodes (>= " + port.nodes + ")");
    for (var n = 0; n < port.names.length; ++n)
        assert(!!scene.find(port.names[n]), port.name + ": carries '" + port.names[n] + "'");

    var lights = 0;
    for (var k = 0; k < nodes.length; ++k) if (nodes[k].type === "light") ++lights;
    assert(lights === port.lights,
           port.name + ": " + lights + " lights, exactly the ones it authored");

    // THE SUN IS A ROLE: the first directional light. Every port aims it where
    // their sample aims its directional light, so the resolver must find one.
    var sun = world.sun();
    assert(sun.light && sun.name === "Sun", port.name + ": the sun resolves to 'Sun'");
    // AMBIENT IS A LIGHT: a port with no Sky Light would open with no ambient.
    var sky = world.skyLight();
    assert(sky.light && sky.intensity > 0, port.name + ": a Sky Light lights it (" + sky.intensity + ")");

    // ---- the world the port authored ----
    assert(world.get().gi.mode === port.gi,
           port.name + ": GI mode " + world.get().gi.mode + " (authored " + port.gi + ")");
    if (port.check) port.check();

    // ---- the picture ----
    renderSanity(port.name);

    // The renderer swallows its failures by design; the pump is the truth.
    var e = app.engineErrors(true);
    assert(e.entries.length === 0, port.name + ": no engine errors (" + J(e.entries) + ")");
}

console.log("ogre ports: " + PORTS.length + " OK");
