// scripting.e2e.avatar — AVATAR_MODULE_SPEC PART 0, S8: the Avatar page's
// whole surface driven from OUTSIDE the app, through the same verbs the
// buttons call. Runs inside the real binary (--script, engine viewport up,
// scratch HOME), which is the only way a script — or an MCP session — can
// prove the skeleton-only view.
//
// Part 0 (the viewer half, everything down to "---- clear ----") creates no
// PROJECT and touches no scene, but it does import: every load is an import
// now (AVATAR_ASSET_SPEC §4 D7 — loadPreview/history/forget are gone), so the
// character arrives as an AVATAR ASSET in a scratch library and the page opens
// it. The AVATAR_LOCOMOTION Stage 2 section at the bottom adds a real project,
// a real pin and a real save/reopen to prove the serialization.
//
// THE SCRATCH STORE, and why there is no setStoreRoot call: the store's
// default root is AppDataLocation/AssetStore, and AppDataLocation follows
// $HOME — so the throwaway HOME this suite runs on ALREADY isolates the
// content store as well as the database. Re-pointing it with the verb would
// write `assets/storeRoot` into jahsettings.ini, which in a QT_DEBUG build
// lives beside the binary and is shared with every other run in this build
// directory (CLAUDE.md). The assertion below proves the isolation instead of
// arranging it.

function assert(cond, msg) {
    if (!cond) throw new Error("assert failed: " + msg);
    console.log("ok: " + msg);
}
function isGreen(c) { return c.g > 110 && c.g > c.r * 1.8 && c.g > c.b * 1.8; }
function isRed(c) { return c.r > 40 && c.r > c.g * 1.8 && c.r > c.b * 1.8; }

var RIG = "@SOURCE_DIR@/tests/avatar/fixtures/rig2.glb";
var WALK = "@SOURCE_DIR@/tests/avatar/fixtures/rig2_walk_anim.glb";
var MISMATCH = "@SOURCE_DIR@/tests/avatar/fixtures/rig_mismatch_anim.glb";
var PIVOT_FBX = "@SOURCE_DIR@/tests/skeletal/fixtures/pivot_rig.fbx";
// rig2.glb rewritten at 17.25 m — the Dreyar case (fixtures/make_scaled_rigs.py).
var GIANT = "@SOURCE_DIR@/tests/avatar/fixtures/rig2_giant.glb";

// ---- the space exists and the window switches to it ----
assert(app.space("avatar"), "app.space('avatar')");
// This suite asserts ANIMATION pixels (centre-pixel deltas on snapshots).
// Pin the space to Grid: the Modern room (the default) puts a WHITE WALL
// behind the tiny synthetic rig, and the centre pixel reads wall at every
// timestamp — delta 0, false red (2026-09-05).
assert(avatar.spaceMode("grid") === "grid", "pin the space to Grid for pixel probes");

// ---- the scratch store: nothing here may touch the real library ----------
var storeRoot = assets.storeStatus().root;
console.log("store root: " + storeRoot);
assert(storeRoot.indexOf("e2e-home-avatar") >= 0,
       "the content store is inside this suite's throwaway HOME, not the real library");

// EVERY LOAD IS AN IMPORT (D7). The character becomes an avatar ASSET and the
// module opens it; there is no session-file path left, which is the point.
// A second import of the same file re-uses nothing on purpose — each call
// mints its own row, so the checks below never share state.
function loadRig(path) {
    var r = avatar.importAvatar(path);
    assert(!!r && r.avatar, "avatar.importAvatar(" + path.split("/").pop() + ")");
    return avatar.preview();
}

// ---- load, with no project open at all ----
assert(!avatar.preview(), "nothing is loaded to begin with");
var info = loadRig(RIG);
assert(!!info, "the imported avatar is open in the preview -> " + JSON.stringify(info));
assert(info.bones === 2, "the rig reports 2 bones");
assert(info.meshes === 1, "one mesh (the single-mesh path ITEM ZERO fixed)");
assert(info.influences === 4, "4 influences per vertex");
assert(info.clips.length === 2, "two clips");

// ---- display names: every Mixamo clip is called "mixamo.com" ----
var junk = null;
for (var i = 0; i < info.clips.length; ++i)
    if (info.clips[i].rawName === "mixamo.com") junk = info.clips[i];
assert(junk !== null, "the fixture carries a clip named 'mixamo.com'");
assert(junk.name === "rig2", "a junk clip name displays as the file's base name");

// ---- the pose reaches the document (ITEM ZERO, from a script) ----
assert(avatar.setClip("Idle"), "avatar.setClip('Idle')");
avatar.setTime(0);
var tip0 = avatar.bones()[1];
assert(tip0.name === "jointTip" && tip0.parent === "jointRoot",
       "avatar.bones() reports the nearest-bone-ancestor link");
avatar.setTime(0.5);
var tipHalf = avatar.bones()[1];
var moved = Math.abs(tipHalf.position.x - tip0.position.x) +
            Math.abs(tipHalf.position.y - tip0.position.y);
assert(moved > 0.05, "the bone moved between t=0 and t=0.5 (moved " + moved.toFixed(3) + ")");
avatar.setTime(0);

// ---- the four toggle combinations, at the pixel level ----
assert(avatar.setMeshVisible(true) && avatar.setSkeletonVisible(false), "mesh only");
var meshShot = avatar.snapshot("avatar_mesh.png", 160, 160, [{ x: 0.5, y: 0.5 }]);
console.log("mesh-only centre: " + JSON.stringify(meshShot.center));
assert(isRed(meshShot.center), "mesh on / skeleton off -> the mesh at the centre");

assert(avatar.setMeshVisible(false) && avatar.setSkeletonVisible(true), "skeleton only");
var boneShot = avatar.snapshot("avatar_skeleton.png", 160, 160, [{ x: 0.5, y: 0.5 }]);
console.log("skeleton-only centre: " + JSON.stringify(boneShot.center));
assert(isGreen(boneShot.center), "mesh off / skeleton on -> the bone overlay at the centre");
assert(!isRed(boneShot.center), "... and no mesh there");

assert(avatar.setSkeletonVisible(false), "neither");
var emptyShot = avatar.snapshot("avatar_none.png", 160, 160, []);
console.log("neither centre: " + JSON.stringify(emptyShot.center));
assert(!isRed(emptyShot.center) && !isGreen(emptyShot.center),
       "neither toggle -> background only");

// ---- transport ----
assert(avatar.playClip("Idle"), "avatar.playClip('Idle')");
assert(avatar.preview().playing === true, "the transport is running");
assert(avatar.pause(), "avatar.pause()");
assert(avatar.preview().playing === false, "paused");
avatar.setTime(0.4);
assert(avatar.stop(), "avatar.stop()");
assert(avatar.time() === 0, "stop rewinds to 0");

// ---- cross-file clips: the Mixamo workflow, from a script ----
// The character is already loaded; WALK is an ANIMATION-ONLY file (zero
// meshes) for the same rig, MISMATCH one for a different rig.
var clipsBefore = avatar.clips().length;
// {asset:false} — INSPECTION. This fixture is an animation-only .glb (zero
// meshes), which the mesh import pipeline refuses; the ASSET route is proved
// against an importable clip by scripting.e2e.avatar_assets and by
// avatar.loadClip in avatar_verbs. The option is explicit for exactly that
// reason: the limitation is visible here rather than hidden in a fallback.
var added = avatar.loadAnimation(WALK, { asset: false });
assert(!!added && added.added === 1, "avatar.loadAnimation added one clip -> " + JSON.stringify(added.match));
assert(added.match.matched === added.match.boneChannels && added.match.matched > 0,
       "every bone channel of the clip matched the loaded rig");
var clipsAfter = avatar.clips();
assert(clipsAfter.length === clipsBefore + 1, "the clip list ACCUMULATED");
var external = clipsAfter[clipsAfter.length - 1];
assert(external.external === true && external.name === "rig2_walk_anim",
       "the new clip is named after the ANIMATION file, and knows it is external");
assert(avatar.preview().activeClip !== external.name,
       "loading an animation does not switch what is playing");

assert(avatar.setClip(external.name), "avatar.setClip(<cross-file clip>)");
avatar.setTime(0);
var xr = avatar.bones()[1].position;
avatar.setTime(0.25);
var xm = avatar.bones()[1].position;
var xMoved = Math.abs(xm.x - xr.x) + Math.abs(xm.y - xr.y);
assert(xMoved > 0.05, "the FOREIGN clip moves the character's bones (moved " + xMoved.toFixed(3) + ")");

// the switch keeps the transport coherent
assert(avatar.playClip(), "playing the cross-file clip");
assert(avatar.setClip("Idle") && avatar.preview().playing === true && avatar.time() === 0,
       "switching while playing keeps playing, from t=0");
assert(avatar.stop(), "stop");

// a clip for a DIFFERENT rig is refused by name, not silently loaded
var refusedRig = "";
try { avatar.loadAnimation(MISMATCH, { asset: false }); } catch (e) { refusedRig = String(e); }
assert(refusedRig.indexOf("hips") >= 0, "a foreign rig is refused, naming the bone: " + refusedRig);
assert(avatar.clips().length === clipsBefore + 1, "... and nothing was added");

// root motion is a preview policy, and it is OFF by default
assert(avatar.preview().rootMotion === false, "root motion is off by default (walk in place)");
assert(avatar.setRootMotion(true) && avatar.preview().rootMotion === true, "avatar.setRootMotion(true)");
assert(avatar.setRootMotion(false) && avatar.preview().rootMotion === false, "avatar.setRootMotion(false)");

// THE LEFT COLUMN, after D7: the library's avatar assets, not a session file
// list. Everything loaded above is a real row, which is the whole change.
var library = avatar.library({ scope: "library" });
assert(library.length >= 1, "avatar.library() lists the imported avatars (" + library.length + ")");
var openNow = avatar.asset();
assert(!!openNow && openNow.scope === "library",
       "avatar.asset() reports what is open, and from which scope");
assert(library.filter(function (a) { return a.guid === openNow.guid; }).length === 1,
       "... and the open avatar is one of the library's rows");
assert(openNow.definition.rig.bones === 2, "... carrying the rig it was minted from");

// ---- refusals are clean errors, never crashes ----
var refusedBadClip = false;
try { avatar.setClip("no such clip"); } catch (e) { refusedBadClip = true; }
assert(refusedBadClip, "avatar.setClip refuses an unknown clip");
var refusedBadFile = false;
try { avatar.importAvatar("/nowhere/at/all.fbx"); } catch (e) { refusedBadFile = true; }
assert(refusedBadFile, "avatar.importAvatar refuses a missing file");
var refusedRetired = false;
try { avatar.loadPreview(RIG); } catch (e) { refusedRetired = true; }
assert(refusedRetired, "avatar.loadPreview is GONE — there is no second way to load a character");

// ---- THE PIVOT-PRESERVING FBX, all the way to pixels ----------------------
// ANIMATION_ENGINE_MIGRATION_SPEC R1, end to end and from outside the app.
// Every other rigged fixture here is glTF and has NO pivot nodes; in an FBX a
// bone's motion lives on its `$AssimpFbx$` ancestors, and a clip translation
// that does not compose that chain produces a frozen character while passing
// every glTF test in the tree.
{
    var fbx = loadRig(PIVOT_FBX);
    assert(!!fbx && fbx.bones === 2, "the pivot FBX loads: " + JSON.stringify(fbx.clips));
    assert(fbx.activeClip === "Walk",
           "the REAL clip is active, not the zero-length T-pose the file also carries");
    assert(avatar.setMeshVisible(true) && avatar.setSkeletonVisible(false), "mesh only");

    avatar.setTime(0);
    var boneRest = avatar.bones()[1].position;
    var restShot = avatar.snapshot("fbx_rest.png", 160, 160, [{ x: 0.5, y: 0.5 }]);
    avatar.setTime(0.5);
    var boneMid = avatar.bones()[1].position;
    var midShot = avatar.snapshot("fbx_mid.png", 160, 160, [{ x: 0.5, y: 0.5 }]);

    var boneMoved = Math.abs(boneMid.x - boneRest.x) + Math.abs(boneMid.y - boneRest.y);
    console.log("FBX pivot rig — jointTip t=0 " + JSON.stringify(boneRest) +
                "  t=0.5 " + JSON.stringify(boneMid));
    assert(boneMoved > 0.05,
           "R1: the engine's evaluated bone moved, so the pivot chain composed (moved " +
           boneMoved.toFixed(3) + ")");

    var dCentre = Math.abs(restShot.center.r - midShot.center.r) +
                  Math.abs(restShot.center.g - midShot.center.g) +
                  Math.abs(restShot.center.b - midShot.center.b);
    console.log("FBX pivot rig — centre pixel t=0 " + JSON.stringify(restShot.center) +
                "  t=0.5 " + JSON.stringify(midShot.center) + "  delta " + dCentre);
    assert(dCentre > 30,
           "R1: and the PIXELS moved with it — a pivot-preserving FBX animates end to end");

    assert(avatar.clearPreview(), "the FBX preview clears");
    assert(!!loadRig(RIG), "reload the glTF rig for the remaining checks");
}

// ---- HEIGHT: the unit fix, normalization, and the ceiling -----------------
// Owner report 2026-09-08: "Dreyar is massively huge, head touches the
// ceiling". Two faults, one visible symptom — FBX unit scale (fixed at the
// importer) and a package whose unit DECLARATION is wrong (fixed here, by
// scaling the subject). This runs the whole thing through the verbs.
{
    var here = avatar.preview();          // the 2 m glTF rig, reloaded above
    assert(Math.abs(here.height - 2.0) < 0.02,
           "the 2 m rig measures " + here.height.toFixed(3) + " m");
    assert(here.normalized === false && Math.abs(here.normalizeFactor - 1) < 1e-6,
           "a plausible character is left EXACTLY as authored");

    var giant = loadRig(GIANT);
    assert(Math.abs(giant.sourceHeight - 17.25) < 0.05,
           "the giant fixture imports at " + giant.sourceHeight.toFixed(2) + " m (Dreyar's size)");
    assert(giant.normalized === true && Math.abs(giant.height - 1.75) < 0.02,
           "... and is normalized to " + giant.height.toFixed(3) + " m (x" +
           giant.normalizeFactor.toFixed(4) + ")");
    // THE OWNER'S ORACLE (the debug-runner's REPRO script): head vs ceiling.
    assert(giant.ceilingHeight > giant.height,
           "head " + giant.height.toFixed(2) + " m clears the ceiling at " +
           giant.ceilingHeight.toFixed(2) + " m");

    var tall = avatar.setCharacterHeight(2.4);
    assert(Math.abs(tall.height - 2.4) < 0.02,
           "avatar.setCharacterHeight(2.4) -> " + tall.height.toFixed(3) + " m");
    assert(Math.abs(tall.sourceHeight - 17.25) < 0.05,
           "... with the report still anchored to the file's height");
    var back = avatar.setCharacterHeight(0);
    assert(Math.abs(back.height - 1.75) < 0.02, "avatar.setCharacterHeight(0) re-runs AUTO");

    // The FBX half, through the real app: pivot_rig.fbx DECLARES metres
    // (UnitScaleFactor 100), so the unit fix leaves it at metre scale — a file
    // declaring centimetres would arrive 100x smaller.
    var fbx = loadRig(PIVOT_FBX);
    assert(fbx.height > 0.5 && fbx.height < 3.0,
           "the metre-declared FBX imports at " + fbx.height.toFixed(3) + " m");
    assert(fbx.normalized === false, "... so it is not normalized either");
    assert(!!loadRig(RIG), "reload the glTF rig for the remaining checks");
}

// ---- clear ----
assert(avatar.clearPreview(), "avatar.clearPreview()");
assert(!avatar.preview(), "nothing is loaded again");

// ===========================================================================
// AVATAR_LOCOMOTION_SPEC Stage 2 — the movement component's verbs (§10),
// driven from outside the app against a REAL project, a REAL library asset and
// the production instantiation route. The physics of the component is gated by
// the avatar.movement suite; what is proved here is the API-first half: the
// verbs exist, they are undoable, they refuse what they should, and the knobs
// SURVIVE A SAVE AND REOPEN (the src/io serialization).
//
// Everything above this line is Part 0, the viewer, and needs no project. This
// section creates one, which is why it comes last.
// ===========================================================================

var proj = project.create("locomotion-" + Date.now());
assert(proj && proj.length > 0, "project.create -> " + proj);

var rigGuid = assets.import(RIG);
assert(rigGuid.length > 10, "assets.import(rig2.glb) -> " + rigGuid);
assert(assets.addToProject(rigGuid) === rigGuid, "assets.addToProject");

// ---- avatar.spawn ----
var avatarId = avatar.spawn(rigGuid, { position: { x: 0, y: 0, z: 0 } });
assert(avatarId && avatarId.length > 10, "avatar.spawn -> " + avatarId);

var knobs = avatar.movement(avatarId);
console.log("avatar.movement: " + JSON.stringify(knobs));
assert(!!knobs && knobs.walkSpeed === 2, "avatar.movement reports the §6.2 defaults (walkSpeed 2)");
assert(knobs.runSpeed === 5.5, "... runSpeed 5.5");
assert(knobs.jumpCount === 1 && knobs.coyoteTime > 0.11 && knobs.coyoteTime < 0.13,
       "... jumpCount 1, coyoteTime 0.12");
assert(knobs.orientRotationToMovement === true, "... orient-to-movement on");
// R4: the capsule is FITTED to the character's bounds, not left at the default.
assert(knobs.capsuleAuto === true, "... and the capsule auto-fitted");
assert(knobs.capsuleHeight > 0 && knobs.capsuleRadius > 0,
       "... to real dimensions: r=" + knobs.capsuleRadius + " h=" + knobs.capsuleHeight);
// The height contract on the SCENE side: a plausible character spawns untouched.
assert(Math.abs(knobs.characterHeight - 2.0) < 0.02,
       "... and avatar.movement reports the character's height: " + knobs.characterHeight);
assert(knobs.normalized === false && Math.abs(knobs.normalizeFactor - 1) < 1e-6,
       "... unnormalized, because 2 m is a plausible character");

// The spawn installed the module's built-in sockets on the rigged mesh inside.
var socketed = 0;
var spawned = scene.nodes({ subtree: avatarId });
for (var si = 0; si < spawned.length; ++si)
    if (spawned[si].type === "mesh")     // node.sockets throws on anything else
        socketed += node.sockets(spawned[si].id).length;
console.log("sockets under the spawned avatar: " + socketed);

// An ordinary node carries no component, and says so by being empty rather
// than by throwing.
var rootId = scene.root();
var none = avatar.movement(rootId);
assert(!none || Object.keys(none).length === 0,
       "avatar.movement on a non-avatar node is empty, not an error");

// ---- avatar.setMovement: partial writes, clamping, refusals ----
var out = avatar.setMovement(avatarId, { walkSpeed: 3.25, jumpVelocity: 9 });
assert(out.walkSpeed === 3.25 && out.jumpVelocity === 9, "avatar.setMovement writes the knobs");
assert(out.runSpeed === 5.5, "... and leaves the ones it was not given alone (partial write)");

var clamped = avatar.setMovement(avatarId, { walkSpeed: -4, airControl: 8, walkableFloorAngle: 120 });
console.log("clamped: " + JSON.stringify({ w: clamped.walkSpeed, a: clamped.airControl,
                                           f: clamped.walkableFloorAngle }));
assert(clamped.walkSpeed === 0, "... a negative walkSpeed clamps to 0 rather than being refused");
assert(clamped.airControl === 1, "... airControl clamps to 1");
assert(clamped.walkableFloorAngle === 89, "... walkableFloorAngle caps at 89, never 90");

// An explicit capsule dimension is a DECISION and clears the auto-fit.
var manual = avatar.setMovement(avatarId, { capsuleRadius: 0.42 });
assert(Math.abs(manual.capsuleRadius - 0.42) < 1e-5, "... an explicit capsuleRadius takes");
assert(manual.capsuleAuto === false, "... and clears capsuleAuto");

var refused = false;
try { avatar.setMovement(avatarId, { wlakSpeed: 3 }); } catch (e) { refused = true; }
assert(refused, "avatar.setMovement REFUSES an unknown knob rather than swallowing it");

// Put it back to something recognisable for the round trip.
var pinned = avatar.setMovement(avatarId, {
    walkSpeed: 3.5, runSpeed: 7.25, jumpVelocity: 8.5, jumpCount: 2,
    maxStepHeight: 0.55, walkableFloorAngle: 52, rotationRate: 300,
    orientRotationToMovement: false, capsuleRadius: 0.35, capsuleHeight: 1.95
});
assert(pinned.jumpCount === 2, "the round-trip values are in place");

// ---- node.setCollision (§6.3 option C) ----
var groundId = scene.find("Ground");
assert(groundId, "the default scene's Ground is there");
assert(node.collision(groundId) === true, "node.collision: a MESH defaults to collidable");
assert(node.collision(rootId) === false, "... and a non-mesh node does not");
assert(node.setCollision(groundId, false), "node.setCollision(false)");
assert(node.collision(groundId) === false, "... takes");

// ---- SAVE, CLOSE, REOPEN: the src/io serialization round trip ----
assert(project.save(), "project.save");
assert(project.close(), "project.close");
// BY GUID, not by name: the scratch HOME persists between ctest runs, so a
// name lookup starts matching several projects on the second run.
assert(project.open(proj), "project.open reopens it");

// The node keeps its guid across the save, so the same id addresses it.
var after = avatar.movement(avatarId);
console.log("after reopen: " + JSON.stringify(after));
assert(!!after && Object.keys(after).length > 0,
       "the AVATAR COMPONENT survived the save/reopen (it is a serialized component block)");
assert(after.walkSpeed === 3.5 && after.runSpeed === 7.25, "... walkSpeed/runSpeed round-tripped");
assert(after.jumpVelocity === 8.5 && after.jumpCount === 2, "... jumpVelocity/jumpCount");
assert(Math.abs(after.maxStepHeight - 0.55) < 1e-5 &&
       Math.abs(after.walkableFloorAngle - 52) < 1e-4, "... maxStepHeight/walkableFloorAngle");
assert(after.orientRotationToMovement === false && Math.abs(after.rotationRate - 300) < 1e-4,
       "... orientRotationToMovement/rotationRate");
assert(after.capsuleAuto === false &&
       Math.abs(after.capsuleRadius - 0.35) < 1e-5 &&
       Math.abs(after.capsuleHeight - 1.95) < 1e-5,
       "... and the capsule, including capsuleAuto being OFF");

var groundAfter = scene.find("Ground");
assert(node.collision(groundAfter) === false,
       "the COLLISION flag round-tripped too (written only when the user overrode the default)");

// ---- spawn HEIGHT normalization (the Dreyar case, in the scene) -----------
// Last, so nothing above sees the extra avatars.
{
    var gGuid = assets.import(GIANT);
    assert(assets.addToProject(gGuid) === gGuid, "the 17.25 m character joins the project");

    var big = avatar.spawn(gGuid, { position: { x: 4, y: 0, z: 0 } });
    var bigKnobs = avatar.movement(big);
    console.log("spawned giant: " + JSON.stringify(bigKnobs));
    assert(bigKnobs.normalized === true && Math.abs(bigKnobs.sourceHeight - 17.25) < 0.05,
           "avatar.spawn normalized the 17.25 m character");
    assert(Math.abs(bigKnobs.characterHeight - 1.75) < 0.02,
           "... to " + bigKnobs.characterHeight.toFixed(3) + " m");
    assert(Math.abs(bigKnobs.capsuleHeight - 1.75) < 0.02,
           "... and the CAPSULE was fitted to the normalized body, not the raw one");

    var exact = avatar.spawn(gGuid, { position: { x: 6, y: 0, z: 0 }, height: 2.2 });
    assert(Math.abs(avatar.movement(exact).characterHeight - 2.2) < 0.02,
           "avatar.spawn({height: 2.2}) sets an exact height");

    var raw = avatar.spawn(gGuid, { position: { x: 8, y: 0, z: 0 }, normalize: false });
    var rawKnobs = avatar.movement(raw);
    assert(rawKnobs.normalized === false && rawKnobs.characterHeight > 17,
           "avatar.spawn({normalize: false}) takes the file's size as authored: " +
           rawKnobs.characterHeight.toFixed(2) + " m");
}

console.log("e2e_avatar: OK");
