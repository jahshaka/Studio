// scripting.e2e.avatar — AVATAR_MODULE_SPEC PART 0, S8: the Avatar page's
// whole surface driven from OUTSIDE the app, through the same verbs the
// buttons call. Runs inside the real binary (--script, engine viewport up,
// scratch HOME), which is the only way a script — or an MCP session — can
// prove the skeleton-only view.
//
// Note what is NOT here: no project is created, no asset imported, no scene
// touched. Part 0 is a viewer.

function assert(cond, msg) {
    if (!cond) throw new Error("assert failed: " + msg);
    console.log("ok: " + msg);
}
function isGreen(c) { return c.g > 110 && c.g > c.r * 1.8 && c.g > c.b * 1.8; }
function isRed(c) { return c.r > 40 && c.r > c.g * 1.8 && c.r > c.b * 1.8; }

var RIG = "@SOURCE_DIR@/tests/avatar/fixtures/rig2.glb";
var WALK = "@SOURCE_DIR@/tests/avatar/fixtures/rig2_walk_anim.glb";
var MISMATCH = "@SOURCE_DIR@/tests/avatar/fixtures/rig_mismatch_anim.glb";

// ---- the space exists and the window switches to it ----
assert(app.space("avatar"), "app.space('avatar')");

// ---- load, with no project open at all ----
assert(!avatar.preview(), "nothing is loaded to begin with");
var info = avatar.loadPreview(RIG);
assert(!!info, "avatar.loadPreview -> " + JSON.stringify(info));
assert(info.bones === 2, "the rig reports 2 bones");
assert(info.meshes === 1, "one mesh (the single-mesh path ITEM ZERO fixed)");
assert(info.influences === 4, "4 influences per vertex");
assert(info.clips.length === 2, "two clips");

// ---- display names: every Mixamo clip is called "mixamo.com" ----
var junk = null;
for (var i = 0; i < info.clips.length; ++i)
    if (info.clips[i].rawName === "mixamo.com") junk = info.clips[i];
assert(junk !== null, "the fixture carries a clip named 'mixamo.com'");
assert(junk.name === "rig2", "a junk clip name displays as the file's base name");

// ---- the pose reaches the document (ITEM ZERO, from a script) ----
assert(avatar.setClip("Idle"), "avatar.setClip('Idle')");
avatar.setTime(0);
var tip0 = avatar.bones()[1];
assert(tip0.name === "jointTip" && tip0.parent === "jointRoot",
       "avatar.bones() reports the nearest-bone-ancestor link");
avatar.setTime(0.5);
var tipHalf = avatar.bones()[1];
var moved = Math.abs(tipHalf.position.x - tip0.position.x) +
            Math.abs(tipHalf.position.y - tip0.position.y);
assert(moved > 0.05, "the bone moved between t=0 and t=0.5 (moved " + moved.toFixed(3) + ")");
avatar.setTime(0);

// ---- the four toggle combinations, at the pixel level ----
assert(avatar.setMeshVisible(true) && avatar.setSkeletonVisible(false), "mesh only");
var meshShot = avatar.snapshot("avatar_mesh.png", 160, 160, [{ x: 0.5, y: 0.5 }]);
console.log("mesh-only centre: " + JSON.stringify(meshShot.center));
assert(isRed(meshShot.center), "mesh on / skeleton off -> the mesh at the centre");

assert(avatar.setMeshVisible(false) && avatar.setSkeletonVisible(true), "skeleton only");
var boneShot = avatar.snapshot("avatar_skeleton.png", 160, 160, [{ x: 0.5, y: 0.5 }]);
console.log("skeleton-only centre: " + JSON.stringify(boneShot.center));
assert(isGreen(boneShot.center), "mesh off / skeleton on -> the bone overlay at the centre");
assert(!isRed(boneShot.center), "... and no mesh there");

assert(avatar.setSkeletonVisible(false), "neither");
var emptyShot = avatar.snapshot("avatar_none.png", 160, 160, []);
console.log("neither centre: " + JSON.stringify(emptyShot.center));
assert(!isRed(emptyShot.center) && !isGreen(emptyShot.center),
       "neither toggle -> background only");

// ---- transport ----
assert(avatar.playClip("Idle"), "avatar.playClip('Idle')");
assert(avatar.preview().playing === true, "the transport is running");
assert(avatar.pause(), "avatar.pause()");
assert(avatar.preview().playing === false, "paused");
avatar.setTime(0.4);
assert(avatar.stop(), "avatar.stop()");
assert(avatar.time() === 0, "stop rewinds to 0");

// ---- cross-file clips: the Mixamo workflow, from a script ----
// The character is already loaded; WALK is an ANIMATION-ONLY file (zero
// meshes) for the same rig, MISMATCH one for a different rig.
var clipsBefore = avatar.clips().length;
var added = avatar.loadAnimation(WALK);
assert(!!added && added.added === 1, "avatar.loadAnimation added one clip -> " + JSON.stringify(added.match));
assert(added.match.matched === added.match.boneChannels && added.match.matched > 0,
       "every bone channel of the clip matched the loaded rig");
var clipsAfter = avatar.clips();
assert(clipsAfter.length === clipsBefore + 1, "the clip list ACCUMULATED");
var external = clipsAfter[clipsAfter.length - 1];
assert(external.external === true && external.name === "rig2_walk_anim",
       "the new clip is named after the ANIMATION file, and knows it is external");
assert(avatar.preview().activeClip !== external.name,
       "loading an animation does not switch what is playing");

assert(avatar.setClip(external.name), "avatar.setClip(<cross-file clip>)");
avatar.setTime(0);
var xr = avatar.bones()[1].position;
avatar.setTime(0.25);
var xm = avatar.bones()[1].position;
var xMoved = Math.abs(xm.x - xr.x) + Math.abs(xm.y - xr.y);
assert(xMoved > 0.05, "the FOREIGN clip moves the character's bones (moved " + xMoved.toFixed(3) + ")");

// the switch keeps the transport coherent
assert(avatar.playClip(), "playing the cross-file clip");
assert(avatar.setClip("Idle") && avatar.preview().playing === true && avatar.time() === 0,
       "switching while playing keeps playing, from t=0");
assert(avatar.stop(), "stop");

// a clip for a DIFFERENT rig is refused by name, not silently loaded
var refusedRig = "";
try { avatar.loadAnimation(MISMATCH); } catch (e) { refusedRig = String(e); }
assert(refusedRig.indexOf("hips") >= 0, "a foreign rig is refused, naming the bone: " + refusedRig);
assert(avatar.clips().length === clipsBefore + 1, "... and nothing was added");

// root motion is a preview policy, and it is OFF by default
assert(avatar.preview().rootMotion === false, "root motion is off by default (walk in place)");
assert(avatar.setRootMotion(true) && avatar.preview().rootMotion === true, "avatar.setRootMotion(true)");
assert(avatar.setRootMotion(false) && avatar.preview().rootMotion === false, "avatar.setRootMotion(false)");

// the session list the left column shows
var hist = avatar.history();
assert(hist.length === 1 && hist[0].loaded === true, "avatar.history() lists the loaded character");
assert(avatar.forget(hist[0].file), "avatar.forget() drops it (the left column's Delete)");
assert(avatar.history().length === 0 && !avatar.preview(),
       "... and clears the preview, because it was the loaded file");
assert(!!avatar.loadPreview(RIG), "reload for the remaining checks");

// ---- refusals are clean errors, never crashes ----
var refusedBadClip = false;
try { avatar.setClip("no such clip"); } catch (e) { refusedBadClip = true; }
assert(refusedBadClip, "avatar.setClip refuses an unknown clip");
var refusedBadFile = false;
try { avatar.loadPreview("/nowhere/at/all.fbx"); } catch (e) { refusedBadFile = true; }
assert(refusedBadFile, "avatar.loadPreview refuses a missing file");

// ---- clear ----
assert(avatar.clearPreview(), "avatar.clearPreview()");
assert(!avatar.preview(), "nothing is loaded again");

console.log("e2e_avatar: OK");
