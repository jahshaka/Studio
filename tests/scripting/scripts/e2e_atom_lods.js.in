// scripting.e2e.atom_lods — ATOM STAGE 1, DETERMINISTIC LEVEL SELECTION
// (SPECS/NANITE_SPEC.md §7.3, gate row 2).
//
// THE CLAIM UNDER TEST, in one sentence: the machine built a LOD chain at
// import, the renderer picks a level from the BAKED, MEASURED GEOMETRIC BOUND,
// and a level change costs no extra draw call.
//
// `bound` AND NOT `error` DRIVES EVERY NUMBER HERE (ATOM P1's AT-A5). The bake
// stores two lengths per level: `bound`, the measured two-sided distance between
// that level and level 0, which is what the renderer's thresholds ARE; and
// `error`, the simplifier's own quadric, which nothing selects on. They differ by
// up to 2x on a curved mesh and by 100x on a flat one, so a suite that computed a
// switch bias from `error` would ask for a level and get another.
//
// It is the LOD BIAS that makes this assertable at all. The dial multiplies the
// PIXEL BUDGET the strategy spends, so sweeping it walks the same camera through
// every level of the chain in a fixed pose: bias 0 pins the finest level (which
// is also how a user turns automatic LOD off), and each level's own
// `switchPixels` — reported by assets.meshLods: the on-screen radius at which
// the renderer takes it — says exactly which bias selects it at a known pose.
// Nothing here waits on wall-clock time or eyeballs a picture.
//
// AND SECTION 5 IS WHY THE RULE CHANGED (ATOM-3, the render audit's A1): the
// switch is a REAL screen-space pixel error at the live lens and the live
// render target, so the same object switches at a DIFFERENT DISTANCE on a
// shorter window and a narrower lens — and at the same pixel error. Before
// ATOM-3 it switched at one distance for every window and every lens, which
// gave a 2376-line VR eye twice the error the desktop had.
//
// THE FIXTURE is the shipped gizmo sphere: 960 triangles, no skeleton, and
// measured to simplify to two clean levels (480 and 240). A primitive cube
// cannot be used — 12 triangles is far below the point where a level saves
// anything, and the bake correctly refuses to build a chain for it, which this
// suite also asserts.

function assert(cond, msg) {
    if (!cond) throw new Error("assert failed: " + msg);
    console.log("ok: " + msg);
}

var SPHERE = "@SOURCE_DIR@/app/models/axis_sphere.obj";

var proj = project.create("Atom LODs " + Date.now());
assert(proj.length > 10, "project.create -> " + proj);

// ---------------------------------------------------------------------------
// 1. THE CHAIN IS IN THE BAKE, and assets.meshLods reports it.
var guid = assets.importFile(SPHERE);
assert(guid && guid.length > 10, "assets.importFile(axis_sphere.obj) -> " + guid);

var rows = assets.meshLods(guid);
assert(rows.length >= 2, "assets.meshLods reports a chain (" + rows.length + " rows)");

// One mesh in this file, so the rows are its levels in order.
var levels = [];
for (var i = 0; i < rows.length; ++i) {
    assert(rows[i].mesh === 0, "row " + i + " is mesh 0");
    assert(rows[i].level === i, "row " + i + " is level " + i);
    levels.push(rows[i]);
}
assert(levels[0].triangles === 960, "level 0 is the authored 960 triangles");
assert(levels[0].error === 0, "level 0 has no error, by definition");
assert(levels[0].switchPixels === 0, "and no switch size");

for (var L = 1; L < levels.length; ++L) {
    assert(levels[L].triangles < levels[L - 1].triangles,
           "level " + L + " has fewer triangles than level " + (L - 1) +
           " (" + levels[L].triangles + " < " + levels[L - 1].triangles + ")");
    // NON-DECREASING is the contract (`Mesh::lodBounds`), not strictly increasing:
    // the running max that keeps the array sorted, and the precision floor under it,
    // can both leave two levels on the same length — the flat default floor does
    // exactly that, at its floor value, on all four of its levels.
    assert(levels[L].bound >= levels[L - 1].bound,
           "level " + L + "'s MEASURED BOUND is no smaller (" + levels[L].bound.toFixed(6) + ")");
    // The simplifier's own number is reported beside it and NOTHING selects on it
    // (ATOM P1's AT-A5). It is monotone too — the bake accumulates it — but it is
    // not the currency, and on a flat mesh it is not even the same order of
    // magnitude as the bound. Asserted as the diagnostic it is.
    assert(levels[L].error >= levels[L - 1].error,
           "...and the simplifier's quadric is non-decreasing too (" +
           levels[L].error.toFixed(6) + ", a diagnostic, not the currency)");
    // Level 0 reports 0 ("not applicable — the authored geometry is what an
    // object of any size starts from"), so the ordering is asserted from the
    // first REAL threshold onwards.
    if (L > 1)
        assert(levels[L].switchPixels < levels[L - 1].switchPixels,
               "level " + L + " is taken at a SMALLER size on screen (" +
               levels[L].switchPixels.toFixed(1) + " px radius, under level " + (L - 1) +
               "'s " + levels[L - 1].switchPixels.toFixed(1) + ")");
    else
        assert(levels[L].switchPixels > 0,
               "level 1 has a real switch size (" + levels[L].switchPixels.toFixed(1) +
               " px radius)");
    // The projection is linear in the BOUND: twice the deviation, half the size.
    // (`switchPixels` is derived from `bound`, because the bound is what the
    // renderer's thresholds are — AT-A5.)
    var ratio = levels[L].switchPixels * levels[L].bound;
    var ratio1 = levels[1].switchPixels * levels[1].bound;
    assert(Math.abs(ratio / ratio1 - 1) < 1e-3,
           "every level's switch size comes from ONE budget (" + ratio.toFixed(3) + ")");
}

// The chain is HALVING triangles per level, which is what makes the far
// distance cheap; the last level is at most a quarter of the first.
assert(levels[levels.length - 1].triangles <= levels[0].triangles * 0.5,
       "the coarsest level is at most half the authored triangle count");

// ---------------------------------------------------------------------------
// 2. A MESH TOO SMALL TO SIMPLIFY GETS NO CHAIN — and says so with an empty
//    list rather than a fake level. (The primitives are scene nodes, not
//    library assets, so this is asserted on the verb's other refusal path: an
//    asset that is not a model.)
var imageOnly = assets.list({ type: "texture", limit: 1 });
if (imageOnly.length > 0) {
    var none = assets.meshLods(imageOnly[0].guid);
    assert(none.length === 0, "a non-model asset has no LOD chain (an empty list, not an error)");
}

// ---------------------------------------------------------------------------
// 3. THE RENDERER PICKS THE LEVEL THE ERROR ASKS FOR.
assets.addToProject(guid);
var nodeId = assets.addToScene(guid, { position: { x: 0, y: 0, z: 0 } });
assert(nodeId && ("" + nodeId).length > 10, "assets.addToScene -> node " + nodeId);

// A fixed pose: the object at the origin, the camera 4 m away on +Z. Every
// reading below is taken from THIS pose — only the dial moves.
var EYE = 4.0;
editor.setCamera({ position: { x: 0, y: 0, z: EYE }, lookAt: { x: 0, y: 0, z: 0 } });

// The geometry counters are LAZY (reading the verb is what switches them on),
// so prime them before measuring anything.
app.renderStats();
editor.frame(4);

// PIXEL EVIDENCE, not just counters: a level that reaches the triangle counter
// and not the picture would pass every assertion above. The fixture's own
// silhouette is where a simplified level differs, so the probes are a GRID over
// the middle of the frame — deliberately not a computed limb radius, which
// would depend on the model's extent, its imported fit scale and the lens, all
// of which are somebody else's decision. MEASURED at this pose: the coarsest
// level moves 122 pixels inside a 22x11 box at the image centre, worst channel
// delta 189/255. The shot is the "plain" grade — no post-processing, the same
// pixels on every machine and in every frame.
var LIMB = [];
for (var gy = 0; gy < 7; ++gy)
    for (var gx = 0; gx < 7; ++gx)
        LIMB.push({ x: 0.44 + gx * 0.02, y: 0.43 + gy * 0.02 });

function measure(tag, bias) {
    editor.setLodBias(bias);
    editor.frame(4);
    var rs = app.renderStats();
    var shot = editor.screenshot("atom_lod_" + tag + ".png", 480, 270, LIMB, "plain");
    var probes = [];
    for (var p = 0; p < shot.probes.length; ++p)
        probes.push(shot.probes[p].r + "," + shot.probes[p].g + "," + shot.probes[p].b);
    console.log("   bias " + bias + ": triangles " + rs.submittedTriangles + ", draws " + rs.draws +
                ", limb [" + probes.join(" | ") + "] -> " + shot.path);
    return { triangles: rs.submittedTriangles, draws: rs.draws, limb: probes.join("|") };
}

// bias 0 pins level 0. Then, for each level, the smallest bias that selects it.
// The strategy's value is the world error one pixel covers at this pose,
// (distance - radius) * 2 * bias / (proj11 * viewportHeight), and it selects a
// level once that reaches the level's error — so the bias that puts the object
// exactly at level k's threshold is error_k / valueAtBiasOne. 5% past it
// selects the level without ambiguity. The two live terms come from the app
// itself (the viewport's height, the camera's lens), which is the point.
var pinned = measure("pinned", 0);
assert(pinned.triangles > 0, "the pinned level draws triangles");

var readings = [pinned];
for (var k = 1; k < levels.length; ++k) {
    // The sphere is a unit ball (radius ~1 in mesh units and placed unscaled),
    // so (EYE - radius) is the strategy's value at bias 1. Being generous with
    // the radius only makes the bias LARGER, i.e. it cannot select a finer
    // level than intended.
    var vp = editor.viewportState();
    var proj11 = 1.0 / Math.tan(0.5 * editor.camera().fov * Math.PI / 180.0);
    var valueAtBiasOne = (EYE - 1.0) * 2.0 / (proj11 * vp.height);
    var bias = (levels[k].bound / valueAtBiasOne) * 1.05;
    readings.push(measure("level" + k, bias));
}

for (var r = 1; r < readings.length; ++r) {
    assert(readings[r].triangles < readings[r - 1].triangles,
           "raising the dial drew FEWER triangles (" + readings[r - 1].triangles +
           " -> " + readings[r].triangles + ")");
    // FINDING B: the levels share one vertex buffer and one index pool, so they
    // share a vaoName and the render queue advances numDraws instead of
    // emitting a second draw command. A level change that split a draw call
    // would defeat the whole point.
    assert(readings[r].draws === pinned.draws,
           "and no extra draw call (draws " + readings[r].draws + ")");
}

// The whole point, as one number: the object's own triangles fell by at least
// the difference between its finest and coarsest level.
// The coarsest level must LOOK different at the limb — otherwise the level
// reached the counters and not the picture.
assert(readings[readings.length - 1].limb !== pinned.limb,
       "the coarsest level changes the silhouette (the limb probes moved)");

var drop = pinned.triangles - readings[readings.length - 1].triangles;
var expected = levels[0].triangles - levels[levels.length - 1].triangles;
assert(drop >= expected,
       "the scene shed at least the chain's own triangles (" + drop + " >= " + expected + ")");

// ---------------------------------------------------------------------------
// 4. THE DIAL IS A DIAL: it reads back, it refuses nonsense, and 0 returns to
//    the finest level from wherever it was.
assert(editor.lodBias() > 0, "editor.lodBias reads back the applied value");
editor.setLodBias(0);
editor.frame(4);
assert(editor.lodBias() === 0, "0 reads back as 0");
var back = app.renderStats();
assert(back.submittedTriangles === pinned.triangles,
       "and the scene is back to its finest level, exactly (" + back.submittedTriangles + ")");

var refused = null;
try { editor.setLodBias(-1); } catch (e) { refused = "" + e; }
assert(refused !== null, "a negative bias is refused: " + refused);

// ---------------------------------------------------------------------------
// 5. THE SWITCH IS A PIXEL ERROR, NOT A DISTANCE (ATOM-3 A1). The same object,
//    the same lens, HALF the window height: the level switches at half the
//    distance from the bounding sphere, because half the lines is half the
//    pixels that error covers. Then the same window with a narrower lens: the
//    distance grows with proj[1][1]. Both are the SAME pixel error, which is
//    what a headset eye and a thumbnail need and what the reference-projection
//    rule could not give them.
editor.setLodBias(1);
// Ogre's world radius is the AABB's, and the fixture's is not a round number, so
// it is SOLVED FOR from the three arms rather than assumed: the rule is
//     switch distance = radius + c * proj[1][1] * viewport height
// with one c, so two arms give both unknowns and the third is the assertion.

// THE SCENE MUST HOLD THIS OBJECT AND NOTHING ELSE that can change its triangle
// count: the default floor carries a chain of its own since ATOM-3's bake floor,
// and anything entering or leaving the frustum as the camera dollies would be
// counted as a switch. (The sections above are unaffected by other objects —
// they move the DIAL at a fixed pose, so only chained objects can respond.)
var others = scene.nodes();
for (var o = 0; o < others.length; ++o) {
    if (others[o].id === nodeId) continue;
    try { node.remove(others[o].id); } catch (ignored) { /* the World root refuses */ }
}
editor.frame(4);

function resizeViewportTo(w, h) {
    for (var attempt = 0; attempt < 8; ++attempt) {
        var vp = editor.viewportState(), win = app.window();
        if (vp.width === w && vp.height === h) return true;
        app.resizeWindow(win.width + (w - vp.width), win.height + (h - vp.height));
        editor.frame(4);
    }
    var got = editor.viewportState();
    return got.width === w && got.height === h;
}

// The distance at which the FIRST level change happens, found by DOLLYING
// OUTWARDS — never by bisection. With ogre-patch 0075's hysteresis band the
// level depends on where the camera came from, by design, so a probe sequence
// that jumps about measures the probe order; a monotone approach measures the
// switch (and shifts it by the band, identically in every arm, which is why the
// RATIOS below are still exact).
var RESET = 1.6;    // close enough that no arm's band can hold a coarse level here

function switchDistance(fov) {
    function trianglesAt(d) {
        editor.setCamera({ position: { x: 0, y: 0, z: d }, lookAt: { x: 0, y: 0, z: 0 } });
        editor.frame(2);
        // submittedTriangles: what the renderer handed the GPU, which is the
        // number an LOD switch moves (STATS-1 renamed it from `triangles`;
        // `sceneTriangles` is the AUTHORED count and deliberately does not
        // move with the camera).
        return app.renderStats().submittedTriangles;
    }
    editor.setCamera({ position: { x: 0, y: 0, z: RESET }, lookAt: { x: 0, y: 0, z: 0 }, fov: fov });
    editor.frame(4);
    // THE RESET POSE MUST REALLY BE AT LEVEL 0. The band holds the level the
    // camera arrived with, so a measurement that started from the previous
    // arm's far pose would measure the NEXT threshold instead — which is
    // exactly what a first version of this section did.
    var base = trianglesAt(RESET);
    editor.setLodBias(0);
    var finest = trianglesAt(RESET);
    editor.setLodBias(1);
    trianglesAt(RESET);
    assert(base === finest, "the sweep starts at the authored level (" + base + ")");
    var d = RESET, coarse = -1;
    for (var i = 0; i < 200; ++i) {           // 1.6 -> 51.6 m in 0.25 m steps
        d += 0.25;
        if (trianglesAt(d) < base) { coarse = d; break; }
    }
    if (coarse < 0) return -1;
    trianglesAt(RESET);                       // back to level 0, then walk in finely
    var fine = coarse - 0.25;
    for (var j = 0; j < 60; ++j) {
        fine += 0.005;
        if (trianglesAt(fine) < base) return fine;
    }
    return coarse;
}

if (resizeViewportTo(1920, 1080)) {
    var tall = switchDistance(45);
    var narrowD = switchDistance(30);
    var shortD = resizeViewportTo(960, 540) ? switchDistance(45) : -1;
    console.log("   switch distances: 1080/45 " + tall.toFixed(3) + " m, 1080/30 " +
                narrowD.toFixed(3) + " m, 540/45 " + shortD.toFixed(3) + " m");
    assert(tall > 0 && narrowD > 0 && shortD > 0, "every arm found a switch");
    var P45 = 1.0 / Math.tan(22.5 * Math.PI / 180.0), P30 = 1.0 / Math.tan(15 * Math.PI / 180.0);
    // Two arms fix the line (the metres per pixel-of-error, and the object's
    // own bounding radius)...
    var c = (narrowD - tall) / ((P30 - P45) * 1080);
    var radius = tall - c * P45 * 1080;
    // ...and the THIRD arm is the claim: a different window height lands on the
    // same line, i.e. the switch is one pixel error everywhere.
    var predictShort = radius + c * P45 * 540;
    assert(Math.abs(predictShort - shortD) < 0.05,
           "ONE PIXEL ERROR ON EVERY WINDOW AND EVERY LENS — 540 lines predicted " +
           predictShort.toFixed(3) + " m, measured " + shortD.toFixed(3) + " m (radius " +
           radius.toFixed(3) + " m)");
    // And the same statement the other way round, which is the reading a person
    // wants: half the lines, half the distance from the bounding sphere.
    var heightRatio = (tall - radius) / (shortD - radius);
    assert(Math.abs(heightRatio - 2.0) < 0.05,
           "HALF THE WINDOW HEIGHT SWITCHES AT HALF THE DISTANCE (" + heightRatio.toFixed(3) + ")");
    resizeViewportTo(1920, 1080);
}

// ---------------------------------------------------------------------------
// 6. A CAPTURE IS EXACT — THE POLICY (SHOT-BAND-1, owner-sequenced 2026-09-18;
//    ATOM-3's queued question, ledger §647).
//
// THE TWO FACTS THAT MAKE THE QUESTION. The LOD switch carries a 10 % HYSTERESIS
// BAND (patch 0075, engine.lod_hysteresis): a level held against a small move
// of the WATCHED view, so an object parked on a threshold does not flicker as
// the camera breathes. A band is a MEMORY OF THE DIRECTION OF TRAVEL — inside
// it the level drawn depends on where the value came from. And the band is
// granted to a view a person watches over time and to no other: every capture
// (a screenshot, a thumbnail, a probe face, a planar reflector, a VR eye
// control) renders at band 0.
//
// THE POLICY, decided: CAPTURES ARE EXACT. A picture taken of a scene is the
// picture the scene's own numbers ask for, not the picture the last few frames
// of somebody's camera motion left behind — because a capture is a MEASUREMENT
// (the pixel corpus, a thumbnail sweep, a probe) and a measurement that depends
// on the history of a window is not one. The cost is stated rather than hidden:
// a Scene-grade shot of an object parked INSIDE the band may draw a different
// level from the viewport it was taken beside, by exactly the band's width.
//
// THE GUARD is the assertion the policy needs and the one thing a script can
// see: the same parked bias approached from BELOW and from ABOVE must give the
// same picture. It passes today (a capture has no band to remember with) and it
// REDS the moment a capture is given one — `View::setLodHysteresisOffscreen`
// left on, a per-view band field defaulted the wrong way, or a future "match
// the viewport" idea.
//
// WHAT IT CANNOT SEE, measured and stated so nobody reads more into it (the
// fix-round read, item 3): in a `--script` run there is NO on-screen view, so
// there is no band ANYWHERE — every view is offscreen and the band is granted
// only to a view a person watches over time (OgreView::chainDesc, and since
// LOD-LATCH-1 the opt-in is the per-view `setLodHysteresisOffscreen` rather
// than an environment variable). The two arms therefore agree in this run
// because nothing held a level, not because a capture declined to. That is the
// honest scope of a script-side guard: the band's EXISTENCE is
// engine.lod_hysteresis's subject, which grants it to an offscreen view on
// purpose to be able to measure it at all; this section pins the POLICY on the
// door a user and a suite actually take, and its arms are the capture's own
// frame (the counters are read after the shot, not off the viewport's last
// frame before it — which was the first cut's mistake and would have been
// vacuous even with a band in the run).
console.log("---- 6. a capture is exact ----");
{
    // A bias inside the band around level 1's threshold: 4 % past it, which is
    // what engine.lod_hysteresis parks at for the same reason (the band is
    // 10 %, so 4 % is inside it from either side).
    var vp6 = editor.viewportState();
    var proj6 = 1.0 / Math.tan(0.5 * editor.camera().fov * Math.PI / 180.0);
    var valueAtBiasOne6 = (EYE - 1.0) * 2.0 / (proj6 * vp6.height);
    var threshold = levels[1].bound / valueAtBiasOne6;
    var park = threshold * 1.04;
    editor.setCamera({ position: { x: 0, y: 0, z: EYE }, lookAt: { x: 0, y: 0, z: 0 } });

    // ONE ARM, AND WHAT IT READS. `measure` above takes its renderStats from
    // the VIEWPORT's last frame, before the shot — which is the wrong picture
    // for this section and, in a --script run, a picture with no band in it at
    // all. So the arms here read the counters AFTER the capture, where they
    // describe the capture's own frame, and the shot's probes are the primary
    // observable either way.
    function bandArm(tag, approachBias) {
        editor.setLodBias(approachBias);
        editor.frame(4);
        editor.setLodBias(park);
        editor.frame(4);
        var shot = editor.screenshot("atom_lod_" + tag + ".png", 480, 270, LIMB, "plain");
        var rs = app.renderStats();          // AFTER the shot: the CAPTURE's frame
        var probes = [];
        for (var p = 0; p < shot.probes.length; ++p)
            probes.push(shot.probes[p].r + "," + shot.probes[p].g + "," + shot.probes[p].b);
        console.log("   " + tag + " (parked at " + park.toFixed(4) + " from " +
                    approachBias.toFixed(4) + "): capture triangles " + rs.submittedTriangles +
                    ", limb [" + probes.join(" | ") + "]");
        return { triangles: rs.submittedTriangles, limb: probes.join("|") };
    }
    // FROM BELOW: pin the finest level, then step up into the band.
    var fromBelow = bandArm("band-from-below", 0);
    // FROM ABOVE: well past the band, then step back down into it.
    var fromAbove = bandArm("band-from-above", threshold * 1.5);

    assert(fromBelow.limb === fromAbove.limb,
           "A CAPTURE IS EXACT: at a bias 4 % inside the switch band, a shot " +
           "approached from below and one approached from above are the SAME " +
           "picture — a capture has no memory of the direction of travel");
    assert(fromBelow.triangles === fromAbove.triangles,
           "...and the CAPTURE's own frame drew the same level both ways (" +
           fromBelow.triangles + " triangles)");
    editor.setLodBias(0);
    editor.frame(4);
}

console.log("ALL ATOM LOD CHECKS PASSED");
