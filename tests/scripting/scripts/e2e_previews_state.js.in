// scripting.e2e.previews_state — PREVIEWS-1 stage 1: EVERY ROW'S STORED PREVIEW, AGAINST WHAT IT
// DEPICTS, BY KEYS (previews.state; services/previewservice.h, services/previewkey.h). Headless: the
// NULL render system draws no engine picture, so what this proves is the KEY, never a picture:
//
//   1. every library row is listed ONCE with its type; a row with nothing to draw reads 'none' with
//      no key (Mesh and Sky have no preset until stages 2 and 4; platform furniture; a builtin row);
//      every other row carries a 16-hex key;
//   2. materials.create reads 'missing' (headless no tile is drawn); materials.addTexture into a slot
//      and a graph edit saved by graph.save each MOVE its key while storedKey stays empty (a texture
//      added with no slot changes no picture: the key stays);
//   3. a Texture import reads 'ok' once previews.settle returns (stage 2: the import's commit writes no
//      tile; its picture goes to the one writer WITH ITS KEY - the base's import tile carried none and
//      read 'stale', storedKey ''), and still 'ok' after previews.render (its CPU branch); A RENAME
//      (assets.rename) of the material and of the texture moves NEITHER key nor state: no name is in
//      what a preview depicts;
//   4. previews.render of a MATERIAL headless fails by name and changes nothing ('missing' still);
//   5. `type` filters to one type; `scope: "project"` lists only the open project's pinned rows;
//   6. A SCRIPT THAT WRITES, THEN previews.renderAll over more rows than the writer's cap (8): 12
//      textures, settled 'ok', then PINNED into the project (the pin is in the key: 'stale'); the run's
//      batch is stood down when the verb starts and the sweep waits at the cap, so the writer's
//      high-water mark (peakQueued) never passes the cap, and every row lands 'ok'. RED when the
//      batch stood down only after the sweep and the queue had no cap: peakQueued = every row.
// RED ON THE BASE: there is no `previews` module (a TypeError at the first call).

function assert(cond, msg) {
    if (!cond) throw new Error("assert failed: " + msg);
    console.log("ok: " + msg);
}
function J(x) { return JSON.stringify(x); }
function rowOf(guid, rows) {
    rows = rows || previews.state();
    var hit = rows.filter(function (r) { return r.guid === guid; });
    return hit.length === 1 ? hit[0] : null;
}
function hex16(k) { return typeof k === "string" && /^[0-9a-f]{16}$/.test(k); }

var PNG = "@JAH_PREVIEWS_PNG@";
var stamp = Date.now();
var proj = project.create("Previews State " + stamp);
assert(proj.length > 10, "project.create");

// ---- 1. EVERY ROW, ONCE, WITH ITS TYPE -------------------------------------------------------
var all = previews.state();
var seen = {};
var duplicates = 0;
all.forEach(function (r) { if (seen[r.guid]) ++duplicates; seen[r.guid] = true; });
assert(all.length > 0 && duplicates === 0, "every library row listed once (" + all.length + " rows)");
assert(all.every(function (r) { return typeof r.type === "string" && r.type.length > 0; }), "every row names its type");
var byType = {};
all.forEach(function (r) { var k = r.type + ":" + r.state; byType[k] = (byType[k] || 0) + 1; });
console.log("the fresh library, type:state -> rows: " + J(byType));
var none = all.filter(function (r) { return r.state === "none"; });
assert(none.every(function (r) { return r.key === ""; }), "a 'none' row carries no key (" + none.length + " rows)");
assert(all.filter(function (r) { return r.state !== "none"; }).every(function (r) { return hex16(r.key); }),
       "every row with something to draw carries a 16-hex key");
assert(all.filter(function (r) { return r.type === "mesh" || r.type === "sky"; })
          .every(function (r) { return r.state === "none"; }),
       "Mesh and Sky rows read 'none' (no preset until stages 2 and 4)");
var platform = all.filter(function (r) { return r.type === "texture" && r.state === "none"; });
assert(platform.length >= 1, "platform furniture (the floor's checker texture) reads 'none': " + platform.length);

// ---- 2. A MATERIAL: MISSING, AND ITS KEY FOLLOWS ITS DEFINITION -------------------------------
var m = materials.create("Preview Probe " + stamp);
var m0 = rowOf(m);
assert(m0 && m0.type === "material" && m0.state === "missing", "materials.create reads 'missing': " + J(m0));
assert(hex16(m0.key) && m0.storedKey === "", "...with a key and no stored key");
materials.addTexture(m, PNG);
var mPinned = rowOf(m);
assert(mPinned.key === m0.key, "materials.addTexture with NO slot (a member that changes no picture) leaves the key: " + J(mPinned));
materials.addTexture(m, PNG, { slot: "baseColorMap" });
var m1 = rowOf(m);
assert(m1.key !== m0.key && m1.storedKey === "", "materials.addTexture into a slot MOVES the key; storedKey stays: " + J(m1));
var g = materials.create("Preview Graph " + stamp, { graph: true });   // its graph opens as the current one
var g0 = rowOf(g);
assert(g0 && g0.state === "missing" && hex16(g0.key), "a graph material reads 'missing' with a key: " + J(g0));
var master = graph.nodes().filter(function (n) { return n.master; })[0];
var f = graph.addNode("float");
assert(graph.setValue(f, 0.73) === true && graph.connect(f, 0, master.id, "Roughness") === true
       && graph.save() === true, "a graph edit saved by graph.save");
var g1 = rowOf(g);
assert(g1.key !== g0.key && g1.storedKey === "", "graph.save MOVES the key; storedKey stays: " + J(g1));
var m2 = rowOf(m);

// ---- 3. A TEXTURE: STALE AT IMPORT, OK AFTER ITS RENDER ---------------------------------------
var t = assets.importFile(PNG);
var settled = previews.settle();
assert(settled.ok === true, "previews.settle: the writer has nothing pending: " + J(settled));
var t0 = rowOf(t);
assert(t0 && t0.type === "texture" && t0.state === "ok" && hex16(t0.storedKey) && t0.storedKey === t0.key,
       "a Texture import reads 'ok' after previews.settle: its picture went to the one writer WITH ITS KEY "
       + "(the base: 'stale', no stored key): " + J(t0));
var rendered = previews.render(t);
assert(rendered.ok === true, "previews.render(texture) headless: " + J(rendered));
var t1 = rowOf(t);
assert(t1.state === "ok" && t1.key === t1.storedKey && t1.key === t0.key, "...now 'ok', key == storedKey: " + J(t1));
assert(assets.rename(t, "Renamed Texture " + stamp) === true, "assets.rename(texture)");
var t2 = rowOf(t);
assert(t2.key === t1.key && t2.state === "ok", "a RENAME moves neither the texture's key nor its state: " + J(t2));
var mBefore = rowOf(m);
assert(assets.rename(m, "Renamed Probe " + stamp) === true, "assets.rename(material)");
var mAfter = rowOf(m);
assert(mAfter.key === mBefore.key && mAfter.state === mBefore.state,
       "a RENAME moves neither the material's key nor its state: " + J(mAfter));

// ---- 4. A MATERIAL HEADLESS: A NAMED FAILURE THAT CHANGES NOTHING -----------------------------
var failed = previews.render(m);
assert(failed.ok === false && typeof failed.reason === "string" && failed.reason.length > 0,
       "previews.render(material) headless fails by name: " + J(failed));
var m3 = rowOf(m);
assert(m3.state === "missing" && m3.key === m2.key && m3.storedKey === "", "...and changes nothing: " + J(m3));

// ---- 5. THE FILTERS ---------------------------------------------------------------------------
var mats = previews.state({ type: "material" });
assert(mats.length >= 1 && mats.every(function (r) { return r.type === "material"; }) && rowOf(m, mats),
       "type: 'material' lists only materials, ours among them (" + mats.length + ")");
var inProject = previews.state({ scope: "project" });
var libraryNow = {};
previews.state().forEach(function (r) { libraryNow[r.guid] = true; });
assert(inProject.every(function (r) { return libraryNow[r.guid] === true; }),
       "every project row is a library row (" + inProject.length + " pinned)");
assert(rowOf(m, inProject) === null, "the library-only material is not in the project's rows");
var refused = false;
try { previews.state({ scope: "elsewhere" }); } catch (e) { refused = true; }
assert(refused, "an unknown scope is refused");

// ---- 6. A WRITE, THEN A SWEEP OVER MORE ROWS THAN THE WRITER'S CAP ----------------------------
var CAP = 8;
var many = [];
for (var i = 0; i < 12; ++i) many.push(assets.importFile(PNG));
var distinct = {};
many.forEach(function (g) { distinct[g] = true; });
assert(Object.keys(distinct).length === 12, "12 Texture rows imported");
assert(previews.settle().ok === true && many.every(function (g) { return rowOf(g).state === "ok"; }),
       "...each 'ok' once settled (the import's pictures, keyed)");
many.forEach(function (g) { assets.addToProject(g); });
assert(many.every(function (g) { return rowOf(g).state === "stale"; }),
       "a PIN moves the key: the 12 pinned textures read 'stale'");
assert(assets.createDrawer("Batch " + stamp) > 0, "the script WRITES: the run's batch is live");
var swept = previews.renderAll({ projectOnly: true });
// The project's template pins model rows too: an engine kind fails headless by name, never one of ours.
assert(swept.rendered >= 12 && swept.failed.every(function (f) { return !distinct[f.guid]; }),
       "renderAll over the project renders every pinned texture; none of them fails: " + J(swept));
assert(swept.peakQueued >= 1 && swept.peakQueued <= CAP,
       "the writer's high-water mark stays within its cap of " + CAP + ": " + swept.peakQueued);
assert(many.every(function (g) { return rowOf(g).state === "ok"; }), "every row reads 'ok' after the sweep");

console.log("previews_state: all assertions passed");
