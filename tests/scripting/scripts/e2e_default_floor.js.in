// scripting.e2e.default_floor — THE DEFAULT FLOOR AND material.reset (owner,
// 2026-09-12: "the floor is a unique asset; it should have a unique material
// only it has; since users can add a material to it, it needs a reset that
// clears the user-added material").
//
//   1. a new scene stands on THE default floor — found by its document flag
//      (node.property(id, "defaultFloor")), never by its name — wearing its
//      OWN material: the checker (the shipped tile, pinned), textureScale 4,
//      roughness 1, metallic 0; the tile is a tray tile, the floor is not;
//   2. a user's edits to that material are undone by material.reset — ONE
//      undo step;
//   3. a LIBRARY material applied to the floor (material.apply) joins the
//      project as a use (the tray lists it); the reset clears it from the
//      floor — the floor's own default is back, ONE undo step — and does NOT
//      touch project membership: the material stays in the project, the
//      library row is untouched, another mesh wearing it keeps it, and a
//      texture deleted from the library meanwhile keeps its row (undo is
//      proven across run boundaries in mcp.e2e);
//   4. a node with no default of its own answers false and changes nothing;
//      a duplicate or a PASTE of the floor is an ordinary mesh;
//   5. the flag survives save + reopen, and the reset still works after it.
//
// Document verbs only -> --headless.

function assert(cond, msg) {
    if (!cond) throw new Error("assert failed: " + msg);
    console.log("ok: " + msg);
}
function J(x) { return JSON.stringify(x); }
function near(a, b) { return Math.abs(a - b) < 1e-4; }
function trayGuids() {
    return assets.list({ scope: "project", tray: true }).map(function (r) { return r.guid; });
}
function theFloors() {
    return scene.nodes().filter(function (r) {
        return r.type === "mesh" && node.property(r.id, "defaultFloor") === true;
    }).map(function (r) { return r.id; });
}
function isFloorDefault(id, tag) {
    var m = material.get(id);
    assert(("" + m.baseColorMap).length > 0 && near(m.textureScale, 4) && near(m.roughness, 1)
           && near(m.metallic, 0),
           tag + ": the floor wears its own default — the checker, textureScale 4, roughness 1, "
           + "metallic 0 (" + J({ map: ("" + m.baseColorMap).length > 0, textureScale: m.textureScale,
                                   roughness: m.roughness, metallic: m.metallic }) + ")");
    return m;
}

var fixtures = "@SOURCE_DIR@/tests/scripting/fixtures";

// A LIBRARY material, imported before any project exists (nothing pins it).
var redMat = assets.importFile(fixtures + "/pinned_red.material");
assert(redMat && redMat.length > 10, "a library material: pinned_red.material");

var proj = project.create("Default Floor " + Date.now());
assert(proj.length > 10, "project.create");

// ---- 1. the default floor ---------------------------------------------------
var floors = theFloors();
assert(floors.length === 1, "a new scene has exactly ONE default floor (" + floors.length + ")");
var floor = floors[0];
assert(scene.find("Ground") === floor, "... and it is the Ground the outliner shows");
var base = isFloorDefault(floor, "a new scene");
var tile = assets.list({ scope: "project", type: "texture", query: "Tile.png" });
assert(tile.length === 1 && trayGuids().indexOf(tile[0].guid) >= 0,
       "the floor's checker is a tray tile (the scene uses it)");
assert(trayGuids().indexOf(floor) < 0, "... and the floor itself is not (a node, not a library asset)");

// ---- 2. the user's edits, reset ---------------------------------------------
assert(material.set(floor, { roughness: 0.25, metallic: 0.6, textureScale: 1, baseColor: "#ff2020" }),
       "the user customises the floor's own material");
assert(near(material.get(floor).roughness, 0.25), "... roughness 0.25 took");
var pushes = editor.undoState().pushes;
assert(material.reset(floor) === true, "material.reset(the floor)");
assert(editor.undoState().pushes === pushes + 1,
       "the reset recorded exactly ONE undo step (" + pushes + " -> " + editor.undoState().pushes + ")");
var back = isFloorDefault(floor, "after the reset");
assert(back.baseColor === base.baseColor, "... and its base colour is the default again (" + back.baseColor + ")");

// ---- 3. a library material, applied then cleared ----------------------------
assert(material.apply(floor, redMat) === true, "material.apply(the floor, the library material)");
assert(trayGuids().indexOf(redMat) >= 0, "applying a library material is a USE: it joins the project (tray)");
assert(material.get(floor).baseColor !== base.baseColor, "the floor wears the applied material now ("
       + material.get(floor).baseColor + ")");
pushes = editor.undoState().pushes;
assert(material.reset(floor) === true, "material.reset clears the applied material from the floor");
assert(editor.undoState().pushes === pushes + 1, "... as ONE undo step");
isFloorDefault(floor, "after clearing the applied material");
assert(trayGuids().indexOf(redMat) >= 0,
       "project membership is NOT touched: the applied material is still in the project (the tray)");
var meta = assets.metadata(redMat);
assert(meta && meta.guid === redMat && meta.listed === true, "the LIBRARY row is untouched");

// Another mesh wearing the same material is not the reset's business.
var cube = scene.addPrimitive("cube", { position: { x: 3, y: 1, z: 0 } });
assert(material.apply(cube, redMat) === true && material.apply(floor, redMat) === true,
       "the same library material on a cube AND the floor");
var cubeRed = J(material.get(cube));
assert(material.reset(floor) === true, "reset the floor");
assert(J(material.get(cube)) === cubeRed, "the cube keeps its material");
isFloorDefault(floor, "the floor alone was reset");

// A TEXTURE DELETED FROM THE LIBRARY while its material is applied: the reset
// must not take it with it (a library delete of a pinned asset only UNLISTS it,
// and the row has to survive for undo — scripted in mcp.e2e, where a run
// boundary lets undo reach the reset).
var tex = assets.importFile(fixtures + "/tiny.png");
var texMat = materials.createFromImage(tex);
assert(texMat && texMat.length > 10, "a material with a texture: materials.createFromImage(tiny.png)");
assert(material.apply(floor, texMat) === true, "applied to the floor");
assert(assets.remove(tex) === true && assets.metadata(tex).listed === false,
       "tiny.png deleted from the library: it is pinned, so it is UNLISTED");
assert(material.reset(floor) === true, "reset the floor");
var texMeta = assets.metadata(tex);
assert(texMeta && texMeta.guid === tex, "the unlisted texture's row still exists after the reset");
assert(trayGuids().indexOf(texMat) >= 0, "... and its material is still in the project");

// A PASTED floor is a copy: the scene keeps ONE default floor.
var frag = node.serialize(floor);
var pasted = node.deserialize(frag, "", -1);
assert(pasted && pasted !== floor, "node.deserialize(the floor's fragment) — a paste");
assert(node.property(pasted, "defaultFloor") === false, "the pasted floor is an ordinary mesh");
assert(theFloors().length === 1 && theFloors()[0] === floor, "still exactly ONE default floor");
assert(material.reset(pasted) === false, "... and it has no reset");
node.remove(pasted);

// ---- 4. no default, no reset ------------------------------------------------
var cubeBefore = J(material.get(cube));
assert(material.reset(cube) === false, "a node with no default of its own: material.reset answers false");
assert(("" + app.lastError()).indexOf("no default material") >= 0, "... and says why: " + app.lastError());
assert(J(material.get(cube)) === cubeBefore, "... and changed nothing");
var copy = node.duplicate(floor);
assert(copy && copy !== floor, "node.duplicate(the floor)");
assert(node.property(copy, "defaultFloor") === false, "a copy of the floor is an ordinary mesh");
assert(material.reset(copy) === false, "... with no reset");
assert(theFloors().length === 1, "still ONE default floor");
node.remove(copy);

// ---- 5. save + reopen -------------------------------------------------------
assert(material.set(floor, { roughness: 0.4 }), "customise once more");
assert(project.save() === true, "save");
assert(project.close() === true, "close");
assert(project.open(proj) === true, "reopen");
var after = theFloors();
assert(after.length === 1 && after[0] === floor, "the flag survived the round trip (same node)");
assert(near(material.get(floor).roughness, 0.4), "... and so did the customisation");
assert(material.reset(floor) === true, "material.reset after the reopen");
isFloorDefault(floor, "after reopen + reset");

console.log("e2e_default_floor: all sections passed");
