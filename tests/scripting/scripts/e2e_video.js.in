// scripting.e2e.video — video assets end to end (ASSET_MEDIA_SPEC §1):
// assets.importFile(mp4) creates a first-class Video library row with a
// frame-grab thumbnail and a probed "metadata" block (duration/resolution/
// frame rate through Qt Multimedia's ffmpeg backend — verified headless-safe,
// so this runs --headless like the drawers/metadata suites). HOME is a
// scratch dir; throwing exits non-zero.
//
// The fixture is tests/scripting/fixtures/tiny.mp4: 64x64, 16 frames at
// 8 fps (2.0 s), MPEG-4 Part 2 video, generated by Qt itself
// (QVideoFrameInput + QMediaRecorder).

function assert(cond, msg) {
    if (!cond) throw new Error("assert failed: " + msg);
    console.log("ok: " + msg);
}
function mustThrow(fn, msg) {
    var threw = false;
    try { fn(); } catch (e) { threw = true; }
    assert(threw, msg);
}

// ---- import: a Video row, filed like images/audio ----
var vid = assets.importFile("@SOURCE_DIR@/tests/scripting/fixtures/tiny.mp4");
assert(typeof vid === "string" && vid.length > 0, "importFile(mp4) returns a guid");

var rows = assets.list({ type: "video" });
var found = false;
for (var i = 0; i < rows.length; ++i) if (rows[i].guid === vid) found = true;
assert(found, "assets.list({type:'video'}) contains the imported row");

// ---- metadata: probed at import time (duration/resolution/fps) ----
var meta = assets.metadata(vid);
assert(meta.kind === "video", "metadata kind is video");
assert(meta.format === "mp4", "container format recorded");
assert(meta.type === "video", "row type is video");
assert(meta.width === 64 && meta.height === 64, "resolution 64x64");
assert(meta.duration >= 1500 && meta.duration <= 2500,
       "duration ~2s (" + meta.duration + " ms)");
if (meta.frameRate !== undefined)
    assert(meta.frameRate > 6 && meta.frameRate < 10,
           "frame rate ~8 fps (" + meta.frameRate + ")");
assert(meta.fileSize > 0, "file size > 0");
assert(typeof meta.imported === "string" && meta.imported.length >= 10,
       "import date present");

// ---- stability: second call serves the persisted block ----
var again = assets.metadata(vid);
assert(again.duration === meta.duration && again.fileSize === meta.fileSize,
       "metadata is stable across calls (persisted, not recomputed)");

// ---- refreshThumbnail: the frame re-grab path is document-only ----
assert(assets.refreshThumbnail(vid) === true, "refreshThumbnail(video) headless");

// ---- drawer filing works for video like any library type ----
var drawer = assets.createDrawer("clips");
assert(assets.moveToDrawer(vid, drawer) === true, "video filed in a drawer");
var listed = assets.list({ type: "video" });
for (var j = 0; j < listed.length; ++j)
    if (listed[j].guid === vid)
        assert(listed[j].drawer === drawer, "row reports its drawer");

// ---- errors: non-video files still refuse cleanly ----
mustThrow(function () { assets.importFile("@SOURCE_DIR@/tests/scripting/scripts/e2e_video.js.in"); },
          "unsupported extension refuses");

console.log("e2e video: all assertions passed");
