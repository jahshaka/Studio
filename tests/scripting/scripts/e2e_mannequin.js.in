// scripting.e2e.mannequin — the DEFAULT AVATAR fixture is a real humanoid.
//
// beta_mannequin.dae is GENERATED at build time (tests/avatar/fixtures/
// make_beta_mannequin.py) from the shipped Skeletal Animation sample: Mixamo's
// "Beta" character, full ~65-joint standard Mixamo skeleton with BARE joint
// names, centimeter units, and — the whole point — its baked dance clip
// STRIPPED. This suite is the contract for that fixture:
//
//   1. it imports and spawns as an avatar,
//   2. the bare-named Mixamo skeleton RESOLVES (the positive complement of
//      sockets.e2e's rig2 fail-soft case, which proves only the negative),
//   3. the cm unit scale was honored — a ~1.7 m human, not a 170 m one,
//   4. it is NEUTRAL: zero clips, zero locomotion roles bound, an empty
//      state machine — nothing to loop, nothing to spin (the rig2 lesson:
//      its bend-test clip named "Idle" auto-bound and looped forever).
//
// Every verb is Needs::Document -> --headless.

var RIG = "@JAHSHAKA_MANNEQUIN_DAE@";

function assert(cond, msg) {
    if (!cond) throw new Error("assert failed: " + msg);
    console.log("ok: " + msg);
}

project.create("mannequin");

// ---- 1. import + spawn ----------------------------------------------------
var guid = assets.import(RIG);
assert(guid.length > 10, "assets.import(beta_mannequin.dae) -> " + guid);
assert(assets.addToProject(guid) === guid, "the mannequin joins the project");

var av = avatar.spawn(guid, { position: { x: 0, y: 0, z: 0 } });
assert(av && av.length > 10, "avatar.spawn -> " + av);

// ---- 2. the Mixamo skeleton resolves --------------------------------------
// Beta ships as THREE skinned mesh pieces (limbs/torso/joints), each bound to
// a SUBSET of the one skeleton — so the full joint count is the UNION across
// the rig-carrying nodes, and sockets go on the richest piece.
var rig = null, rigBones = 0;
var union = {}, unionCount = 0;
var rows = scene.nodes({ subtree: av });
for (var i = 0; i < rows.length; i++) {
    var b = node.boneNames(rows[i].id);
    if (!b || b.length === 0) continue;
    if (b.length > rigBones) { rig = rows[i].id; rigBones = b.length; }
    for (var j = 0; j < b.length; j++)
        if (!union[b[j]]) { union[b[j]] = true; unionCount++; }
}
assert(rig !== null, "the spawned avatar carries a rig in its subtree");

var bones = Object.keys(union);
// 53 of the rig's ~65 joints carry skin weights — the _End effectors and
// fingertip leaves influence no vertices, so the controllers omit them.
assert(unionCount >= 50, "a full Mixamo skeleton (" + unionCount + " skinned joints across "
       + "the pieces >= 50)");
var expect = ["Hips", "Spine2", "Head", "LeftHand", "RightHand", "LeftFoot", "RightFoot"];
for (var e = 0; e < expect.length; e++)
    assert(bones.indexOf(expect[e]) >= 0, "joint present: " + expect[e]);

// SPAWN ALREADY RESOLVED THE SOCKETS (D1, fixed 2026-09-06). The sweep used to
// run on the FIRST skinned mesh depth-first, which on Beta is the limbs piece
// (46 bones, no Head, no Shoulder): it failed soft and a spawned character came
// out with ZERO sockets. Nothing below calls addSockets first — these are the
// sockets avatar.spawn installed, wherever in the subtree they landed.
var haveHead = null, haveShoulder = null;
for (var q = 0; q < rows.length; q++) {
    // Sockets live on rigged MESH nodes; node.sockets refuses anything else.
    var qb = node.boneNames(rows[q].id);
    if (!qb || qb.length === 0) continue;
    var socks = node.sockets(rows[q].id);
    for (var w = 0; w < socks.length; w++) {
        if (socks[w].name === "head") haveHead = { node: rows[q].id, bone: socks[w].bone };
        if (socks[w].name === "shoulder") haveShoulder = { node: rows[q].id, bone: socks[w].bone };
    }
}
console.log("spawn sockets: head=" + JSON.stringify(haveHead) +
            " shoulder=" + JSON.stringify(haveShoulder));
assert(haveHead !== null, "avatar.spawn resolved the `head` socket with NO manual addSockets");
assert(haveHead.bone === "Head", "the head socket sits on the Head joint");
assert(haveShoulder !== null, "avatar.spawn resolved the `shoulder` socket too");

// Bare names must canonicalize: the built-in socket sweep, which FAILED SOFT
// on rig2's jointRoot/jointTip, must actually MAP on this rig. Called on the
// CHARACTER (a wrapper, not a mesh) it walks the subtree; every built-in is
// already there, so every row must come back `existed`.
var report = avatar.addSockets(av);
var mapped = 0;
for (var s = 0; s < report.length; s++) if (report[s].mapped) mapped++;
console.log("addSockets mapped " + mapped + "/" + report.length + ": " + JSON.stringify(report));
assert(mapped === 2, "avatar.addSockets on the CHARACTER maps both built-ins (" + mapped + ")");
for (var s2 = 0; s2 < report.length; s2++) {
    assert(report[s2].existed, report[s2].socket + ": spawn's socket is left alone, not replaced");
    assert(report[s2].node && report[s2].node.length > 10,
           report[s2].socket + ": the report names the piece it lives on");
}

// ---- 2b. the capsule is METRES, and shaped like a person (D2) -------------
// It used to be measured in the WRAPPER's local frame, which divides the cm
// unit scale back out (height 180.71) while every consumer — step-up, the
// follow camera — is world-space; and its radius came from AABB corners, so a
// T-posed body measured its ARM SPAN (0.81 m, a barrel).
var mv = avatar.movement(av);
console.log("avatar.movement capsule: height=" + mv.capsuleHeight + " radius=" + mv.capsuleRadius);
assert(mv.capsuleHeight > 1.6 && mv.capsuleHeight < 2.0,
       "capsuleHeight " + mv.capsuleHeight.toFixed(3) + " m is a human height (1.6..2.0)");
assert(mv.capsuleRadius > 0.15 && mv.capsuleRadius < 0.5,
       "capsuleRadius " + mv.capsuleRadius.toFixed(3) + " m is a human radius (0.15..0.5)");

// The follow camera sizes itself off that capsule and off the shoulder socket
// (possession.cpp captureOffsetReference), so a wrong capsule put the camera
// 397 m away and the viewport went black.
assert(avatar.possess(av), "avatar.possess(the mannequin)");
var cam = avatar.followCamera();
console.log("avatar.followCamera: " + JSON.stringify(cam));
assert(cam.armLength < 10, "follow arm " + cam.armLength.toFixed(2) + " m frames the character");
assert(cam.heightOffset > 1.0 && cam.heightOffset < 2.0,
       "the shoulder socket set the pivot height (" + cam.heightOffset.toFixed(3) + " m)");
assert(avatar.unpossess(), "avatar.unpossess()");

// ---- 3. centimeter units were honored -------------------------------------
// Ray straight down from 10 m above the origin: the first hit is the top of
// the head. Mixamo Beta stands ~1.7-1.9 m; a missed unit scale reads ~170.
var hits = scene.raycast({ x: 0, y: 10, z: 0 }, { x: 0, y: -1, z: 0 });
assert(hits.length >= 1, "a ray down through the mannequin hits it");
var top = hits[0].point.y;
assert(top > 1.2 && top < 2.2,
       "head top at y=" + top.toFixed(3) + " m — cm unit scale honored (1.2 < y < 2.2)");

// ---- 4. neutral: no clips, no roles, no machine ---------------------------
var roles = avatar.clipRoles(av);
console.log("avatar.clipRoles: " + JSON.stringify(roles));
assert(roles.clips.length === 0, "the animation strip held: ZERO clips survive import");
assert(!roles.idle && !roles.walk && !roles.run,
       "no locomotion role auto-bound on a clipless body");

var asset = avatar.locomotionAsset(av);
console.log("avatar.locomotionAsset: " + JSON.stringify(asset));
assert(asset.states.length === 0,
       "the default asset degrades to an EMPTY machine — nothing loops, nothing spins");

console.log("mannequin: all assertions passed");
