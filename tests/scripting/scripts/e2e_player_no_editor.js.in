// scripting.e2e.player_no_editor — THE PLAYER OVER AN EDITOR THAT WAS NEVER
// SHOWN (lane SMOKE-FIX-1, 2026-09-18; the second half of the owner's smoke of
// push #50: "it says the Player is selected but I only see the desktop").
//
// THE DEFECT THIS PINS. The Player page is a second VIEW on the EDITOR'S engine
// Scene (lane PLAYER-1), and that scene was built only in the editor viewport's
// SHOW event. A session that reaches the Player without ever showing the editor
// — the desktop tile's Play button, a `--vr` boot that starts on the Desktop
// page — therefore asked for a scene that did not exist: EnginePlayerScene::
// attach returned false, `view()->setEnabled(true)` ran anyway, and an enabled
// View with no scene draws and presents NOTHING. The window kept showing
// whatever the X server had under it — the page the user came from.
//
// Two rules hold it shut now: the editor's scene is created ON DEMAND
// (EngineSceneViewport::ensureEngineScene, which no longer waits for its own
// widget's View — the engine's own startup-order law answers for itself), and a
// page that cannot bind REFUSES instead of enabling an empty View
// (EnginePlayerView::start -> MainWindow::bounceFromPlayer).
//
// The route is the tile's Play button, as the verb it never had:
// `project.openAsync(guid, {play:true})`.
//
// AND THE BOOT IS THE PERSON'S, NOT THE SCRIPT HARNESS'S. A windowed `--script`
// run normally shows the editor page before the first line of the script, so
// the editor's scene would already exist and this suite would prove nothing:
// it runs with JAHSHAKA_TEST_NO_EDITOR_BOOT=1 (app/cli/scriptrunner.cpp), which
// is the shape a person's launch has — window up, Desktop page, editor page
// never shown. That also means there is no editor viewport to draw with until
// something opens one, so the poll below never calls editor.frame().
var SCENES = "@CMAKE_SOURCE_DIR@/scenes";

var failures = 0;
function ok(cond, msg) {
    if (cond) { console.log("ok:   " + msg); }
    else { console.log("FAIL: " + msg); ++failures; }
}

ok(app.columns().space === "desktop", "the process boots on the desktop");

// An import that does NOT open: the editor page stays unshown.
var imported = project.importArchive(SCENES + "/Matcaps.zip");
ok(!!imported && !!imported.guid, "the Matcaps sample imported");
ok(app.columns().space === "desktop",
   "still on the desktop — the editor page has never been shown (space = "
   + app.columns().space + ")");

// THE SUITE ONLY MEANS SOMETHING IF THE SCENE REALLY IS NOT THERE YET. The
// editor's engine scene is built when a page that DRAWS it asks — the editor
// viewport being shown, the Player page being entered, a VR session beginning —
// and by nothing else, so in a process that has shown neither page there must
// be no engine scene of the editor's at all. (A count of engine scenes would
// not do: the import renders thumbnails, which have scenes of their own.)
ok(editor.viewportState().engineScene === false,
   "the editor's engine scene does NOT exist yet — nothing has asked for it");

// ---- straight into the Player ---------------------------------------------
ok(project.openAsync(imported.guid, { play: true }) === true,
   "project.openAsync({play:true}) started (" + app.lastError() + ")");
// A poll that lets the loop turn but draws NOTHING — there is no editor view to
// draw with yet, which is the whole point of this boot. The install drives the
// renderer itself at every slice boundary (OPEN-FRAMES-1), so the open
// completes either way.
var turns = 0;
while (project.openState() === "opening") { app.openStats(); if (++turns > 200000) break; }
ok(project.openState() === "idle", "the open finished (" + turns + " frames)");

// If the player could not be bound the shell BOUNCES, so being here at all is
// half the assertion; the other half is that it draws.
ok(app.columns().space === "player",
   "the window is on the Player (space = " + app.columns().space + ")");
ok(editor.viewportState().engineScene === true,
   "…and it exists now: the PLAYER ASKING is what built it");
ok(player.state().active === true, "the Player page is active");
// player.frame returns FALSE when the view could not be attached to the
// editor's scene — the exact state that used to present nothing, silently.
ok(player.frame(5) === true, "the Player DREW five frames (" + app.lastError() + ")");
ok(player.screenshot("player-no-editor.png", { width: 64, height: 64 }).ok !== false,
   "…and it can be read back");

// ---- and the editor, shown for the first time AFTER the player, still works -
ok(app.space("editor") === true, "the editor takes the screen (" + app.lastError() + ")");
ok(app.columns().space === "editor", "space = " + app.columns().space);
ok(editor.frame(3) === true, "the editor draws its own frames");
var vs = editor.viewportState();
ok(vs.state === "presenting" || vs.state === "loading",
   "the editor viewport is bound to the same one scene (" + vs.state + ")");
ok(scene.nodes().length > 0, "the world is the one that was opened");

if (failures) throw new Error(failures + " assertion(s) failed");
console.log("player_no_editor: all assertions passed");
