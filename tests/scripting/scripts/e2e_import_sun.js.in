// pool.doc_assets::import_sun — THE FILE'S SUN IS THE SUN (BISTRO-IMPORT-1 stage 3b; the
// owner's answer 7). A model that brings its own directional light (our FBX scene
// fixture: tests/importer/fixtures/make_scene_fbx.py, "SunLight") placed into a template
// scene REPLACES the template's default sun (one undo macro with the placement) and
// the import summary says so. Before stage 3b the two tied at priority 0, creation order
// kept the template's, and the file's sun lit the street shadowless beside it (base:
// sun "Directional Light", 1 secondary). Also: importAndPlace's `projectGuid` is the
// PROJECT's (it returned the asset's).
function assert(cond, msg) {
    if (!cond) throw new Error("assert failed: " + msg);
    console.log("ok: " + msg);
}
var fixture = "@SOURCE_DIR@/tests/importer/fixtures/scene_features.fbx";
var proj = project.create("Import Sun " + Date.now(), { template: "basic" });
var before = world.sun();
assert(before.name === "Directional Light", "the template scene's sun is its default (" + before.name + ")");

var placed = assets.importAndPlace(fixture, { position: { x: 0, y: 0, z: 0 } });
assert(placed.nodeId && placed.nodeId.length > 10, "assets.importAndPlace -> node " + placed.nodeId);
assert(placed.projectGuid === proj, "projectGuid is the project's (" + placed.projectGuid + " vs " + proj + ")");
var after = world.sun();
var secondaries = (after.secondaries || []).length;
assert(after.name === "SunLight" && secondaries === 0,
       "the scene's ONE sun is the file's (" + after.name + ", " + secondaries + " secondaries)");
assert(placed.summary && String(placed.summary.sun).indexOf("replaced") >= 0,
       "the summary says the default was replaced (" + (placed.summary ? placed.summary.sun : "") + ")");
assert(placed.summary.lightUnits && placed.summary.animatedNodes === 1,
       "the summary says the light units and the one animated node (" + placed.summary.animatedNodes + ")");

// The default is GONE, not demoted (an in-script undo cannot reach the placement: the
// run's own macro is still open — editor.undo's doc — so the one undo step is the
// command's, asserted by reading, not by undoing).
var defaults = scene.nodes().filter(function (n) { return n.name === "Directional Light"; });
assert(defaults.length === 0, "the template's default sun is removed (" + defaults.length + " left)");
