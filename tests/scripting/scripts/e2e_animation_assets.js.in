// scripting.e2e.animation_assets — ANIMATION CLIPS AS A LIBRARY TYPE
// (ModelTypes::Animation), end to end through the verbs.
//
// The owner's finding: 10 of his 23 Mixamo downloads are animation-only FBX
// ("without skin") and the library refused every one of them, with a message
// that blamed Draco compression. This run is the proof of the fix — import,
// listing, the avatar consumers, and the ARCHIVE, because a clip that cannot
// ride an export is not really an asset.
//
// The export half writes an archive that the SECOND test
// (scripting.e2e.animation_assets_import) imports into a completely fresh
// library: an exported project must arrive complete somewhere else, and that
// is not something one library can prove about itself.
//
// FIXTURES (generated by tests/avatar from the shipped Skeletal Animation
// sample): beta_mannequin.dae = Mixamo's Beta with its clip stripped;
// beta_walk.dae = the same export with the BODY stripped — an animation-only
// file, the exact shape this type exists for.
//
// --headless: every verb here is Needs::Document.

function assert(cond, msg) {
    if (!cond) throw new Error("assert failed: " + msg);
    console.log("ok: " + msg);
}

var RIG     = "@JAHSHAKA_MANNEQUIN_DAE@";
var WALK    = "@JAHSHAKA_BETA_WALK_DAE@";
var ARCHIVE = "@JAHSHAKA_ANIMATION_ARCHIVE@";

project.create("animation assets");

// ---- 1. the import ---------------------------------------------------------

var clip = assets.import(WALK);
assert(clip.length > 10, "an animation-only file imports (it was refused outright before)");

var meta = assets.metadata(clip);
console.log("clip metadata: " + JSON.stringify({ kind: meta.kind, clips: meta.clips,
                                                 duration: meta.duration, bones: meta.bones,
                                                 rigId: meta.rigId }));
assert(meta.kind === "animation", "its metadata kind is 'animation', not 'model'");
assert(meta.clips && meta.clips.length >= 1, "the clip table came out of the file");
assert(meta.clips[0].name === "Walking", "...naming the clip Walking");
assert(meta.clips[0].length > 0, "...with a length in seconds (" + meta.clips[0].length + ")");
assert(meta.bones > 40, "...and the bones its channels drive (" + meta.bones + ")");
assert(typeof meta.rigId === "string" && meta.rigId.length > 0,
       "the clip advertises a RIG ID — which rigs it fits, without opening it");

// ---- 2. the listing --------------------------------------------------------

var animations = assets.list({ type: "animation" });
assert(animations.length === 1 && animations[0].guid === clip,
       "assets.list({type:'animation'}) finds exactly the clip");
assert(animations[0].type === "animation", "...and reports the type by name");
var objects = assets.list({ type: "object" });
assert(objects.filter(function (a) { return a.guid === clip; }).length === 0,
       "the clip is NOT an object row (a zero-mesh file never was one)");

// A file with meshes stays an Object even though it also has a skeleton.
var rig = assets.import(RIG);
assert(assets.metadata(rig).kind === "model", "the character file is still a MODEL asset");
assert(assets.list({ type: "object" }).filter(function (a) { return a.guid === rig; }).length === 1,
       "...listed as an object");

// ---- 3. the avatar consumers ----------------------------------------------

assert(assets.addToProject(rig) === rig, "the character joins the project");
var av = avatar.spawn(rig);
assert(av && av.length > 10, "avatar.spawn -> " + av);

// THE ASSET GUID, not a path: the whole reason a clip is a library row.
var loaded = avatar.loadClip(av, clip);
console.log("avatar.loadClip(animation guid): " + JSON.stringify(loaded));
assert(loaded.added === 1, "one clip landed on the character");
assert(loaded.asset === clip, "...from the Animation ASSET, reusing its row (no re-import)");
assert(loaded.match.matched === loaded.match.boneChannels,
       "every one of its " + loaded.match.boneChannels + " bone channels exists on this rig");
assert(avatar.clipRoles(av).walk === "Walking",
       "the walk role bound itself from the clip's name");

var listedClips = avatar.animations();
console.log("avatar.animations: " + JSON.stringify(listedClips));
assert(listedClips.length === 1 && listedClips[0].guid === clip,
       "avatar.animations lists the library's clip files (what Load Animation... shows)");
assert(listedClips[0].clips[0] === "Walking" && listedClips[0].duration > 0,
       "...with the clip names and the duration");
assert(listedClips[0].rigId === meta.rigId, "...and the same rig id the metadata carries");
assert(listedClips[0].bones === meta.bones, "...and the same bone count");

// The clip is PINNED: an archive carries pins, so this is what makes it ride.
var pinned = assets.list({ scope: "project" }).filter(function (a) { return a.guid === clip; });
assert(pinned.length === 1, "loading the clip pinned it to the project");

// ---- 4. the archive --------------------------------------------------------

var exported = project.exportArchive(ARCHIVE);
console.log("project.exportArchive: " + JSON.stringify(exported));
assert(exported.path === ARCHIVE && exported.assets >= 2,
       "the project exported (" + exported.assets + " assets, " + exported.objects + " objects)");
assert(exported.objects >= 2,
       "...carrying object bytes for the character AND the clip");

console.log("PASS e2e_animation_assets");
