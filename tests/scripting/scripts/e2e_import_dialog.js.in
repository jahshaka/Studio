// scripting.e2e.import_dialog — THE IMPORT DIALOG, DRIVEN
// (SPECS/IMPORT_DIALOG_SPEC.md §8/§9).
//
// ui.import_dialog pins the record the widgets produce; scripting.e2e.
// import_settings pins the verbs. THIS pins the JOIN — that the dialog's own
// OK button, in the real binary, on a real library asset, actually re-bakes
// the asset, and that what it produces is what the verbs produce:
//
//   import a cm-declared cube  -> 0.01 m
//   open the dialog on it      -> it comes up pre-filled with the stored record
//   set {units:"m"} and press OK (app.dialog's `accept`, which IS the button)
//                              -> the asset re-bakes at 1 m
//   a node placed BEFORE the reimport follows, still at scale 1,1,1
//   the record the dialog wrote reads back identical from the verb
//
// The dialog needs the editor window, so this runs WITHOUT --headless.

function assert(cond, msg) {
    if (!cond) throw new Error("assert failed: " + msg);
    console.log("ok: " + msg);
}
function near(a, b, tol) { return Math.abs(a - b) <= (tol === undefined ? 1e-3 : tol); }
function mustThrow(fn, msg) {
    var threw = false;
    try { fn(); } catch (e) { threw = true; }
    assert(threw, msg);
}

var CUBE = "@SOURCE_DIR@/tests/importer/fixtures/unit_cube_cm.fbx";

var proj = project.create("Import Dialog " + Date.now());
assert(proj.length > 10, "project.create");

// A run-unique origin shift, for the reason e2e_import_settings documents: this
// suite's library persists between runs and a bake is content-addressed, so a
// fresh bake per run keeps the assertions about NEW bakes honest.
var UNIQ = [0, 0, (Date.now() % 100000) / 1e9];

// ---- 0. the dialog is in the catalog --------------------------------------
var names = app.dialogs().map(function (d) { return d.name; });
assert(names.indexOf("importSettings") >= 0,
       "app.dialogs() lists importSettings (so the theme walk opens it too)");

// Opened with NO asset it is an inspection-only dialog, like newProject's.
var bare = app.dialog("importSettings");
assert(bare.open === true, "app.dialog('importSettings') opens with nothing selected");
assert(bare.settings !== undefined && bare.settings.scale === 1,
       "…showing the identity record");
app.dialog("importSettings", false);

// ---- 1. an asset to reopen the decision on --------------------------------
var guid = assets.import(CUBE, { translate: UNIQ });
assert(guid.length > 10, "assets.import(unit_cube_cm.fbx)");
var meta = assets.metadata(guid);
assert(near(meta.extent.y, 0.01, 1e-4),
       "the file declares centimetres, so it imports at 0.01 m (" + meta.extent.y + ")");

assets.addToProject(guid);
var placed = assets.addToScene(guid, { position: [0, 0, 0] });
assert(near(node.size(placed).height, 0.01, 1e-4), "the placed node measures the same");
assert(near(node.transform(placed).scale.y, 1, 1e-6), "and it is placed at scale 1");

// ---- 2. the dialog opens PRE-FILLED on that asset -------------------------
var opened = app.dialog("importSettings", { guid: guid });
assert(opened.open === true, "app.dialog('importSettings', {guid}) opens on the asset");
assert(opened.settings !== undefined, "…and reports the record it holds");
assert(opened.settings.units === "auto" && opened.settings.scale === 1,
       "…pre-filled from assets.importSettings: the record this asset was imported with");
assert(near(opened.settings.translate[2], UNIQ[2], 1e-12),
       "…including the translation the import carried");

// ---- 3. OK re-bakes, through the verb -------------------------------------
var before = assets.importSettings(guid).sourceOid;
var accepted = app.dialog("importSettings", { settings: { units: "m" }, accept: true });
assert(accepted.accepted === true, "pressing OK with {units:'m'} accepts the dialog");
assert(accepted.settings.units === "m", "…and the record it committed says so");

var after = assets.importSettings(guid);
assert(after.settings.units === "m",
       "the ASSET now carries the dialog's record (assets.importSettings reads it back)");
assert(after.sourceOid === before,
       "…and the source content id did not move: a reimport is not a new import");
assert(near(assets.metadata(guid).extent.y, 1.0, 1e-3),
       "the cube re-baked at 1 m (" + assets.metadata(guid).extent.y + ")");

// ---- 4. the open scene followed, and nothing was rescaled -----------------
assert(near(node.size(placed).height, 1.0, 1e-3),
       "the node already in the scene measures the new size (" + node.size(placed).height + ")");
assert(near(node.transform(placed).scale.y, 1, 1e-6),
       "…with its transform untouched: every placement is at scale 1");

// ---- 5. the dialog's record IS the verb's record --------------------------
// The whole point of the dialog being a record producer: the same decision made
// through the verb keys the same bake, so the two paths can never fork.
var byDialog = JSON.stringify(after.settings);
assets.reimport(guid, { units: "m" });
assert(JSON.stringify(assets.importSettings(guid).settings) === byDialog,
       "assets.reimport with the same values records a byte-identical record");

// ---- 6. refusals ----------------------------------------------------------
app.dialog("importSettings", false);
mustThrow(function () { app.dialog("importSettings", { settings: { scale: 0 } }); },
          "a record the pipeline refuses is refused by the dialog verb too");
app.dialog("importSettings", false);
mustThrow(function () { app.dialog("noSuchDialog"); }, "an unknown dialog name is refused");

console.log("scripting.e2e.import_dialog: all assertions passed");
