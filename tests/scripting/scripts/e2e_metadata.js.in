// scripting.e2e.metadata — rich asset metadata end to end (ASSET_DRAWERS_SPEC
// addendum): assets.importFile / assets.import write the per-type "metadata"
// block at import time, and assets.metadata(guid) serves it (and backfills it
// for rows that lack one). Runs the real binary --script --headless with HOME
// redirected to a scratch dir — a fresh JahLibrary.db, never the user's.
// Throwing exits non-zero.

function assert(cond, msg) {
    if (!cond) throw new Error("assert failed: " + msg);
    console.log("ok: " + msg);
}
function mustThrow(fn, msg) {
    var threw = false;
    try { fn(); } catch (e) { threw = true; }
    assert(threw, msg);
}

// ---- image: resolution from the header, format, size, import date ----
var png = assets.importFile("@SOURCE_DIR@/tests/scripting/fixtures/tiny.png");
var pngMeta = assets.metadata(png);
assert(pngMeta.kind === "image", "png metadata kind is image");
assert(pngMeta.format === "png", "png format recorded");
assert(pngMeta.width === 8 && pngMeta.height === 8, "png resolution 8x8");
assert(pngMeta.fileSize > 0, "png file size > 0");
assert(typeof pngMeta.imported === "string" && pngMeta.imported.length >= 10,
       "png import date present (" + pngMeta.imported + ")");
assert(pngMeta.type === "texture", "png row type is texture");

// ---- audio: wav header fields ----
var wav = assets.importFile("@SOURCE_DIR@/tests/scripting/fixtures/tiny.wav");
var wavMeta = assets.metadata(wav);
assert(wavMeta.kind === "audio", "wav metadata kind is audio");
assert(wavMeta.format === "wav", "wav format recorded");
assert(wavMeta.sampleRate === 8000, "wav sample rate 8000");
assert(wavMeta.channels === 1, "wav mono");
assert(wavMeta.duration === 50, "wav duration 50 ms");
assert(wavMeta.fileSize === 844, "wav file size 844");

// ---- model: counts from the assimp scene loaded during import ----
var obj = assets.import("@SOURCE_DIR@/app/content/primitives/cube.obj");
var objMeta = assets.metadata(obj);
assert(objMeta.kind === "model", "obj metadata kind is model");
assert(objMeta.format === "obj", "obj source format recorded");
assert(objMeta.triangles === 12, "cube has 12 triangles");
assert(objMeta.vertices > 0, "cube vertex count > 0");
assert(objMeta.meshes >= 1, "cube mesh count >= 1");
assert(objMeta.materials >= 1, "cube material count >= 1");
assert(objMeta.textures === 0, "cube references no textures");
assert(objMeta.fileSize > 0, "obj file size > 0");
assert(objMeta.type === "object", "obj row type is object");

// ---- stability: a second call serves the persisted block unchanged ----
var again = assets.metadata(obj);
assert(again.triangles === objMeta.triangles && again.fileSize === objMeta.fileSize,
       "metadata is stable across calls (persisted, not recomputed)");

// ---- refreshThumbnail: document-only types work headless now ----
assert(assets.refreshThumbnail(png) === true, "refreshThumbnail(image) headless");
assert(assets.refreshThumbnail(wav) === true, "refreshThumbnail(audio) headless");

// ---- NAME + TAGS (2026-09-06 verb-coverage audit F3) ----
//
// Both live in one library row and are written by one statement, so the rule
// under test is that changing either carries the other through. Before these
// verbs the tag field existed only on the Assets page, and no script could
// rename an asset at all.
assert(pngMeta.tags.length === 0, "a fresh import has no tags");
assert(assets.tags(png).length === 0, "assets.tags agrees");

// Tags are RUN-UNIQUE: the suite's scratch HOME survives between ctest runs,
// so a fixed tag would accumulate rows from every previous run.
var run = "run" + Date.now();
var kitchenTag = run + "-kitchen";
var soloTag = run + "-solo";

var tagged = assets.setTags(png, ["Kitchen", "wood", "  ", "kitchen"]);
assert(tagged.length === 2, "blanks dropped, case-insensitive duplicate collapsed: " +
       JSON.stringify(tagged));
assert(tagged[0] === "Kitchen" && tagged[1] === "wood", "the stored list is returned");
assert(assets.metadata(png).tags.length === 2, "assets.metadata reports the tags too");

assert(assets.rename(png, "Kitchen Tile") === true, "assets.rename");
assert(assets.metadata(png).name === "Kitchen Tile", "the name changed");
assert(assets.tags(png).length === 2, "…and the RENAME kept the tags (one write, two fields)");

assert(assets.setTags(png, [soloTag]).length === 1, "tags replaced, not merged");
assert(assets.metadata(png).name === "Kitchen Tile",
       "…and the RE-TAG kept the name (the other half of the same rule)");

// The listing filter — the point of having tags at all.
assert(assets.setTags(wav, [kitchenTag]).length === 1, "tag the wav too");
var kitchen = assets.list({ tag: kitchenTag });
assert(kitchen.length === 1 && kitchen[0].guid === wav,
       "assets.list({tag}) returns only the tagged row: " + JSON.stringify(kitchen));
assert(assets.list({ tag: kitchenTag.toUpperCase() }).length === 1,
       "the tag filter is case-insensitive");
assert(assets.list({ tag: run + "-kitch" }).length === 0,
       "…and EXACT: a tag filter is not a substring search (that is `query`)");
assert(assets.list({ tag: kitchenTag, type: "texture" }).length === 0,
       "tag composes with the other filters");
assert(assets.list({ tag: soloTag, type: "texture" }).length === 1, "…both ways");

// Clearing.
assert(assets.setTags(png, []).length === 0, "an empty array clears the tags");
assert(assets.list({ tag: soloTag }).length === 0, "…and the filter sees it");

// ---- importFile {typeHint} (F18) ----
// The hint reaches the pipeline's importer SELECTION: a hint the file cannot
// satisfy fails instead of filing the bytes under the wrong kind.
var hinted = assets.importFile("@SOURCE_DIR@/tests/scripting/fixtures/implane_wide.png",
                               -1, { typeHint: "texture" });
assert(hinted.length > 10, "importFile with a matching typeHint imports");
assert(assets.metadata(hinted).type === "texture", "…as the hinted type");
mustThrow(function () {
    assets.importFile("@SOURCE_DIR@/tests/scripting/fixtures/implane_tall.png", -1,
                      { typeHint: "music" });
}, "a typeHint the file cannot satisfy FAILS (never mis-files the bytes)");
mustThrow(function () {
    assets.importFile("@SOURCE_DIR@/tests/scripting/fixtures/implane_tall.png", -1,
                      { typeHint: "pancake" });
}, "an unknown typeHint name is refused");
mustThrow(function () {
    assets.importFile("@SOURCE_DIR@/tests/scripting/fixtures/implane_tall.png", -1,
                      { typeHnt: "texture" });
}, "an unknown option key is refused");

// ---- errors ----
mustThrow(function () { assets.metadata("no-such-guid"); }, "unknown guid throws");
mustThrow(function () { assets.refreshThumbnail("no-such-guid"); },
          "refreshThumbnail unknown guid throws");
mustThrow(function () { assets.rename("no-such-guid", "x"); }, "rename unknown guid throws");
mustThrow(function () { assets.rename(png, "   "); }, "rename to an empty name is refused");
mustThrow(function () { assets.setTags("no-such-guid", ["x"]); },
          "setTags unknown guid throws");
mustThrow(function () { assets.tags("no-such-guid"); }, "tags unknown guid throws");
mustThrow(function () { assets.list({ scope: "session", tag: "kitchen" }); },
          "a tag filter on scope 'session' is refused (registrations carry no tags)");

console.log("e2e metadata: all assertions passed");
