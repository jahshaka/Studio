// atom.occlusion_exact_app — THE ID PASS'S OCCLUSION IS EXACT IN THE PRODUCT (ATOM-OCCLUSION-1,
// the script half of atom.occlusion_exact): on the DEFAULT SCENE and SHOWROOM 2, at three
// poses each, the editor's own shots with the occlusion on (the default) and with its
// measuring door shut (world.setAtomOcclusion(false): the id pass frustum-only) are the
// same picture, pixel for pixel —
//   * the 'triangles' Atom view (every triangle its own colour by object, cluster and
//     triangle: the id image itself, painted), and
//   * the ordinary picture ('off'): THREE occluding arms against THREE frustum-only ones,
//     alternating, each cross-route pair held to what the SAME route's shots differ by
//     (the bar below), after the scene has settled and walked its poses once.
// A shot is its own view, settled over many frames (the GI settle), so its last frame
// culls against the previous frame's pyramid and tests the rejected set again: the
// two-pass form. Every pixel of a 240 x 135 shot is probed (its centre).
// Also: the verb's answers, world.atomStatus()'s 'occlusion' / 'occluded' /
// 'disoccluded' in the viewport, and the door restored.
// Frames, never time: every shot renders until the scene is at rest.

function assert(cond, msg) {
    if (!cond) throw new Error("assert failed: " + msg);
    console.log("ok: " + msg);
}
function J(x) { return JSON.stringify(x); }

var SHOWROOM = "@JAH_OCCLUSION_SHOWROOM@";
var W = 240, H = 135;
var probes = [];
for (var y = 0; y < H; ++y)
    for (var x = 0; x < W; ++x) probes.push({ x: (x + 0.5) / W, y: (y + 0.5) / H });

function shot(name) {
    var r = editor.screenshot("atom_occlusion_" + name + ".png", W, H, probes, "scene");
    assert(r && r.probes && r.probes.length === W * H, "shot " + name + " read every pixel");
    return r.probes;
}
function changed(a, b) {
    var n = 0;
    for (var i = 0; i < a.length; ++i)
        if (a[i].r !== b[i].r || a[i].g !== b[i].g || a[i].b !== b[i].b) ++n;
    return n;
}
// THE PICTURE'S BAR (ATOM-OCC-1CODE-1; the PHOTON-I-1 merge read): the picture with the
// occlusion against the frustum-only one may differ by no more pixels than two shots of
// the SAME route differ by — the largest count over THREE same-route pairs of EACH route
// (on1/on2, on2/on3, on1/on3, off1/off2, off2/off3, off1/off3) — and by at most 1 code in
// any channel. A scene whose same-route shots agree pixel for pixel (the default scene)
// therefore holds the cross-route pictures pixel for pixel too. The id image (the
// 'triangles' view) is held pixel for pixel always.
function worstCode(a, b) {
    var w = 0;
    for (var i = 0; i < a.length; ++i)
        w = Math.max(w, Math.abs(a[i].r - b[i].r), Math.abs(a[i].g - b[i].g), Math.abs(a[i].b - b[i].b));
    return w;
}
// Where two shots differ, for the log: up to `n` pixels as (x, y) a -> b.
function diffList(a, b, n) {
    var out = [];
    for (var i = 0; i < a.length && out.length < n; ++i)
        if (a[i].r !== b[i].r || a[i].g !== b[i].g || a[i].b !== b[i].b)
            out.push("(" + (i % W) + "," + Math.floor(i / W) + ") " + a[i].r + "," + a[i].g + "," + a[i].b + "->" +
                     b[i].r + "," + b[i].g + "," + b[i].b);
    return out.join(" ");
}

// SETTLED BEFORE THE FIRST ARM, IN FRAMES: the GI at rest and no probe owing a capture
// (the one settle predicate), then the poses walked once with their shots thrown away —
// a scene just opened is still converging, and the first arm's shots of it differed
// from a later identical arm's by thousands of pixels (Showroom 2 pose 0: 5793).
function settleGi() {
    for (var i = 0; i < 60; ++i) {
        editor.frame(10, 1 / 60);
        var st = world.giStatus();
        if (st.giAtRest !== false && !st.staleProbes) return i;
    }
    return -1;
}

function waitSplit() {
    var st = world.atomStatus();
    for (var i = 0; i < 90 && (st.pending > 0 || st.atomItems < 1 || !st.cutValid); ++i) {
        editor.frame(2);
        st = world.atomStatus();
    }
    return st;
}

// THE POSES: the scene's own camera and two moves of it (a step back and up, and a
// step to the side turned across the room), set identically in both arms.
function posesFrom(cam) {
    var p = cam.position;
    return [
        { position: { x: p.x, y: p.y, z: p.z }, rotation: cam.rotation },
        { position: { x: p.x, y: p.y + 1.5, z: p.z + 4.0 }, lookAt: { x: 0, y: 0.5, z: 0 } },
        { position: { x: p.x + 5.0, y: p.y, z: p.z - 2.0 }, lookAt: { x: -2.0, y: 0.8, z: -2.0 } },
    ];
}

function arm(label, poses) {
    var out = [];
    for (var i = 0; i < poses.length; ++i) {
        editor.setCamera(poses[i]);
        editor.frame(4);
        world.setAtomView("off");
        var lit = shot(label + "_pose" + i + "_off");
        assert(world.setAtomView("triangles") === true, label + " pose " + i + ": the 'triangles' view");
        var tri = shot(label + "_pose" + i + "_triangles");
        world.setAtomView("off");
        out.push({ lit: lit, tri: tri });
    }
    return out;
}

function exactOn(sceneName) {
    var st = waitSplit();
    console.log(sceneName + " atomStatus: " + J(st));
    assert(st.live && st.on && st.atomItems >= 1, sceneName + ": the split is live");
    assert(world.setAtomOcclusion(true) === true, sceneName + ": world.setAtomOcclusion(true) answers true");
    editor.frame(8);
    st = waitSplit();
    assert(st.occlusion === true, sceneName + ": atomStatus().occlusion is true with the door open");
    console.log(sceneName + " occlusion in the viewport: occluded " + st.occluded + ", disoccluded " +
                st.disoccluded + ", cutTriangles " + st.cutTriangles);
    var poses = posesFrom(editor.camera());
    console.log(sceneName + " settle: " + settleGi() + " rounds");
    arm(sceneName + "_warm", poses);   // thrown away (the header of settleGi)
    // SIX ARMS, ALTERNATING: the door open (on), shut (off: every chain rebuilt
    // frustum-only), open, shut, open, shut.
    var on = [], off = [];
    for (var k = 1; k <= 3; ++k) {
        assert(world.setAtomOcclusion(true) === true, sceneName + " arm " + k + ": the door opens");
        editor.frame(8);
        assert(waitSplit().occlusion === true, sceneName + " arm " + k + ": the view culls against the depth");
        on.push(arm(sceneName + "_on" + k, poses));
        assert(world.setAtomOcclusion(false) === false, sceneName + " arm " + k + ": the door shuts");
        editor.frame(8);
        st = waitSplit();
        assert(st.occlusion === false && st.occluded === 0 && st.disoccluded === 0,
               sceneName + " arm " + k + ": with the door shut the view culls frustum-only (" +
               J({ occlusion: st.occlusion, occluded: st.occluded, disoccluded: st.disoccluded }) + ")");
        off.push(arm(sceneName + "_off" + k, poses));
    }
    assert(world.setAtomOcclusion(true) === true, sceneName + ": the door is left open");
    var pairs = [[0, 1], [1, 2], [0, 2]];
    for (var i = 0; i < poses.length; ++i) {
        var same = [], sameWorst = 0;
        for (var q = 0; q < pairs.length; ++q) {
            var a0 = pairs[q][0], a1 = pairs[q][1];
            same.push(changed(on[a0][i].lit, on[a1][i].lit));
            same.push(changed(off[a0][i].lit, off[a1][i].lit));
            sameWorst = Math.max(sameWorst, worstCode(on[a0][i].lit, on[a1][i].lit),
                                 worstCode(off[a0][i].lit, off[a1][i].lit));
        }
        var bar = Math.max.apply(null, same);
        console.log(sceneName + " pose " + i + ": same-route pairs (on, off) " + J(same) + " px, worst " + sameWorst +
                    " code(s); the bar " + bar + " px");
        for (var k = 0; k < 3; ++k) {
            var dTri = changed(on[k][i].tri, off[k][i].tri);
            var dLit = changed(on[k][i].lit, off[k][i].lit);
            var worst = worstCode(on[k][i].lit, off[k][i].lit);
            console.log(sceneName + " pose " + i + " arm " + (k + 1) + ": triangles on/off " + dTri + " px; picture on/off " +
                        dLit + " px, worst " + worst + (dLit ? " — " + diffList(on[k][i].lit, off[k][i].lit, 16) : ""));
            assert(dTri === 0, sceneName + " pose " + i + " arm " + (k + 1) + ": the id image (the 'triangles' view) " +
                   "is the frustum-only one, pixel for pixel (" + dTri + " differ)");
            assert(dLit <= bar && worst <= 1,
                   sceneName + " pose " + i + " arm " + (k + 1) + ": the picture with the occlusion is the frustum-only " +
                   "one within what two shots of one route differ by (" + dLit + " px against the bar " + bar +
                   ", worst " + worst + " code, bar 1)");
        }
    }
}

// ---- THE DEFAULT SCENE -------------------------------------------------------
var proj = project.create("Atom Occlusion " + Date.now());
assert(proj.length > 10, "project.create");
exactOn("default");

// ---- SHOWROOM 2 --------------------------------------------------------------
app.engineErrors(true);
var imported = project.importArchive(SHOWROOM);
assert(imported && imported.guid, "importArchive(Showroom 2)");
assert(project.open(imported.guid) === true, "project.open(Showroom 2)");
editor.frame(60);
exactOn("showroom2");
