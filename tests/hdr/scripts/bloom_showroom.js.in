// hdr.bloom_showroom — NO FULL-WIDTH BAND IN SHOWROOM 2 (lane BLOOM-1; the app half of
// hdr.bloom_isotropic (archived: archive/tests/hdr)). The defect (spikes/light-band-1): the old bloom blurred a fixed
// 256x256 target 65 taps across and 11 down, so every highlight became a band across
// the whole frame at its own height — Showroom 2, from its own camera, showed two (the
// torus' highlight, the spheres' tops), present with bloom and gone at bloomAmount 0.
//
// THE CLAIM: at both ends of EVERY row of the editor's own picture ("scene" grade), the
// bloomed picture equals the bloomAmount 0 picture within 2 codes — except where the
// end pixel lies inside a halo's own radius, i.e. within kHaloReach of a pixel bright
// enough to bloom. "Bright enough" is read off the scene's own radiance (the plain
// grade's float readback, times the grade's exposure multiplier, against the bloom
// threshold: below it the prefilter passes nothing).
// A halo is a disc; a band is a row. The disc's reach is the ladder's (measured by
// hdr.bloom_isotropic (archived: archive/tests/hdr) at 960 wide: a saturated hot spot's halo stays >= 1 code out to
// ~1/4 of the width); kHaloReach is set wider than that.
// THE SECOND BAR (worstAll): that exemption is wide (Showroom 2 has ~76 hot grid points and
// it skips ~928 of the 1080 row ends), so a band or a widened halo on an exempt row would
// pass it. EVERY row end - bar the ones sitting on a hot point itself (within kCoreReach,
// where the highlight's own core legitimately moves) - over kWorstAllBar (4) codes is judged
// as a BAND: a band is the whole row's (the base's measured 40, its band rows +19..+38), a
// halo is local to its highlight, so the row must come back within 2 codes of the bloomAmount
// 0 picture somewhere along it (kAcross points a row). RESTATED (PHOTON-7 stage 11, the
// lead's ruling): the fixed 4-code halo bar was the old picture's (worst 1); a lamp with a
// size (the sphere-light glint) makes a bigger highlight and a wider halo (worst 9, rows
// 251-258 right) - the halo's reach follows the actual highlight; the row ends over 4 are
// printed.
//
// Frames, never time: the shots are the picture at rest (editor.screenshot settles).

function assert(cond, msg) {
    if (!cond) throw new Error("assert failed: " + msg);
    console.log("ok: " + msg);
}
function J(x) { return JSON.stringify(x); }

var SHOWROOM = "@JAH_BLOOM_SHOWROOM@";
var W = 960, H = 540;
var kHaloReach = 0.30 * W;          // px: wider than the ladder's measured reach
var kStep = 8;                      // the hot-pixel grid, px
var kCoreReach = 2 * kStep;         // px: a row end this close to a hot point is ON the highlight
var kWorstAllBar = 4;               // codes, every row end not on a highlight (see THE SECOND BAR)

var proj = project.create("Bloom Showroom " + Date.now());
assert(proj.length > 10, "project.create");
var imported = project.importArchive(SHOWROOM);
assert(imported && imported.guid, "importArchive(Showroom 2)");
assert(project.open(imported.guid) === true, "project.open(Showroom 2)");
editor.frame(60);
assert(world.override({ id: "bloom", value: 1 }).value === 1, "bloom is on");
world.postFx({ bloomAmount: 1 });
var fx = world.postFx();
console.log("postFx: threshold " + fx.bloomThreshold + " knee " + fx.bloomKnee +
            " multiplier " + fx.exposureMultiplier);

// The two ends of every row.
var ends = [];
for (var y = 0; y < H; ++y) {
    ends.push({ x: 0.5 / W, y: (y + 0.5) / H });
    ends.push({ x: (W - 0.5) / W, y: (y + 0.5) / H });
}
// ...AND EACH ROW ACROSS (PHOTON-7 stage 11, the second bar's law): kAcross points along every row, so a row end's excess
// can be followed along its own row - a halo falls off away from its highlight, a band does not.
var kAcross = 16;
for (var y = 0; y < H; ++y)
    for (var k = 0; k < kAcross; ++k)
        ends.push({ x: (W * (k + 0.5) / kAcross) / W, y: (y + 0.5) / H });
// THE PAIR IS ONE PICTURE (PHOTON-7 stage 10, the giAtRest contract): both shots settle AT REST - never at the cap - and
// the surface cache relights nothing between them (its relights differenced across the second shot), so the pair differs
// by the bloom alone. Before the contract a shot settled with the cards' rounds still relighting: two bloom-on shots
// back to back read 7 codes apart.
var shotOn = editor.screenshot("bloom_showroom_on.png", W, H, ends, "scene");
var between = world.giStatus().cards;
world.postFx({ bloomAmount: 0 });
var shotOff = editor.screenshot("bloom_showroom_off.png", W, H, ends, "scene");
var after = world.giStatus().cards;
world.postFx({ bloomAmount: 1 });
console.log("the first settle: " + shotOn.settleFrames + " frames (at rest " + shotOn.atRest + "), the second: " +
            shotOff.settleFrames + " (at rest " + shotOff.atRest + "); the cards' rest decisions " + after.restDecisions);
assert(shotOn.atRest === true && shotOff.atRest === true, "both shots settled AT REST, never at the cap");
var relitBetween = after.relights - between.relights;
assert(relitBetween === 0, "the cards relit nothing between the two shots (" + relitBetween + " relights, " +
       (after.visibleRelights - between.visibleRelights) + " visible)");
var on = shotOn.probes, off = shotOff.probes;
assert(on.length === (2 + kAcross) * H && off.length === (2 + kAcross) * H, "both shots read both ends of every row and its across points");

// The pixels bright enough to bloom.
var grid = [];
for (var gy = kStep / 2; gy < H; gy += kStep)
    for (var gx = kStep / 2; gx < W; gx += kStep) grid.push({ x: gx / W, y: gy / H });
var shotRad = editor.screenshot("bloom_showroom_radiance.png", W, H, grid, "plain", { radiance: true });
console.log("the radiance shot's settle: " + shotRad.settleFrames + " frames (at rest " + shotRad.atRest + ")");
assert(shotRad.atRest === true, "the radiance shot settled AT REST");
var rad = shotRad.probes;
var mult = fx.exposureMultiplier > 0 ? fx.exposureMultiplier : 1;
var hot = [];
for (var i = 0; i < rad.length; ++i) {
    var r = rad[i].radiance;
    if (Math.max(r.r, r.g, r.b) * mult >= fx.bloomThreshold)
        hot.push({ x: rad[i].x * W, y: rad[i].y * H });
}
console.log("hot pixels (grid " + kStep + " px): " + hot.length);
assert(hot.length > 0, "the scene has highlights that bloom (the control)");

function withinOfHot(px, py, radius) {
    for (var k = 0; k < hot.length; ++k) {
        var dx = hot[k].x - px, dy = hot[k].y - py;
        if (dx * dx + dy * dy <= radius * radius) return true;
    }
    return false;
}
function nearHot(px, py) { return withinOfHot(px, py, kHaloReach); }

var checked = 0, exempt = 0, onCore = 0, bad = [], badAll = [], worstFar = 0, worstAll = 0;
// (a row's across points: the probes after the 2 H ends, kAcross a row)
function acrossMin(row) {
    var m = 1e9;
    for (var k = 0; k < kAcross; ++k) {
        var a = on[2 * H + row * kAcross + k], b = off[2 * H + row * kAcross + k];
        m = Math.min(m, Math.max(Math.abs(a.r - b.r), Math.abs(a.g - b.g), Math.abs(a.b - b.b)));
    }
    return m;
}
var bandRows = [];
for (var j = 0; j < 2 * H; ++j) {
    var a = on[j], b = off[j];
    var d = Math.max(Math.abs(a.r - b.r), Math.abs(a.g - b.g), Math.abs(a.b - b.b));
    var px = a.x * W, py = a.y * H;
    if (withinOfHot(px, py, kCoreReach)) {
        ++onCore;
    } else {
        worstAll = Math.max(worstAll, d);
        if (d > kWorstAllBar && badAll.length < 12)
            badAll.push("(" + (px < W / 2 ? "left" : "right") + " row " + Math.floor(py) + ": +" + d + ")");
        // THE BAND TEST on a row end over the halo bar: its excess must be a HALO - local to the highlight that throws
        // it, so somewhere along its own row the bloomed picture is the bloomAmount 0 one within 2 codes (a band, the
        // old ladder's defect, is the whole row's); its reach follows the actual highlight, never a fixed width
        if (d > kWorstAllBar && acrossMin(Math.floor(py)) > 2 && bandRows.length < 12)
            bandRows.push("(row " + Math.floor(py) + ": end +" + d + ", the row's least +" + acrossMin(Math.floor(py)) + ")");
    }
    if (Math.floor(py) % 30 === 0)
        console.log("  row " + Math.floor(py) + (px < W / 2 ? " left" : " right") + ": +" + d +
                    (nearHot(px, py) ? " (inside a halo's reach)" : ""));
    if (nearHot(px, py)) { ++exempt; continue; }
    ++checked;
    worstFar = Math.max(worstFar, d);
    if (d > 2 && bad.length < 12) bad.push("(" + (px < W / 2 ? "left" : "right") + " row " + Math.floor(py) + ": +" + d + ")");
}
console.log("row ends: " + checked + " checked, " + exempt + " inside a halo's reach; worst outside " +
            worstFar + " codes, worst anywhere " + worstAll + " (" + onCore + " on a highlight's core, not counted)");
assert(checked >= 100, "the control: at least 100 row ends are outside every halo's reach (" + checked + ")");
assert(worstFar <= 2, "no band: every row end outside a halo's reach is the bloomAmount 0 picture within 2 codes " +
       "(worst " + worstFar + ")" + (bad.length ? " " + bad.join(" ") : ""));
// THE SECOND BAR, RESTATED ON ITS LAW (PHOTON-7 stage 11, the lead's ruling): a row end over kWorstAllBar codes is
// printed - a bigger lamp makes a bigger highlight and a wider halo (the sphere-light glint) - and judged as a BAND: its
// row must return within 2 codes of the bloomAmount 0 picture somewhere along it.
console.log("row ends over the " + kWorstAllBar + "-code halo bar (printed): " + (badAll.length ? badAll.join(" ") : "none") +
            " (worst " + worstAll + ")");
assert(bandRows.length === 0, "no band anywhere: every row end over the halo bar is a halo - its own row returns within 2 " +
       "codes of the bloomAmount 0 picture" + (bandRows.length ? " " + bandRows.join(" ") : ""));
console.log("BLOOM_SHOWROOM_DONE");
