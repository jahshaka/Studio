// samples.archive_fidelity.Tornado (LIVE-PERSIST-1; TESTING-SPEED-B2) — THE SHIPPED ARCHIVE,
// opened on a clean machine, is COMPLETE: judged against its own invariants, never a picture.
//
// The gap this closes: TORNADO-2 measured the scene make_tornado.js builds IN
// MEMORY, never the archive the owner opens. Two of the three layers' live graph
// materials did not survive save -> export -> import (their graphs were left out
// of the archive, their baked cut-out map was written absent, their pieces were
// read from a per-user cache by file name), so the shipped sample opened smooth
// with no holes, and every gate stayed green.
//
// This script is the APP half (archive_fidelity.sh is the wrapper: a virgin data
// root, HOME and XDG_CACHE_HOME inside it, so no piece cache exists anywhere; the
// closure of the shipped archive is checked there before this runs):
//   * THE MEMBER COUNT: the import brings in the manifest's assets and the zip's objects;
//   * THE LIVE MATERIALS, by name: every layer comes back with its generated pieces
//     (re-emitted from its graph into THIS data root), and the two shells with their
//     baked cut-out map — after the import, and again after a close and a REOPEN;
//   * THE ROUND TRIP: the project exported again holds the same assets and objects
//     (the wrapper then checks that archive's closure, asset for asset).
// The reference still (tests/samples/data/tornado_reference.jpg) and its torn-silhouette
// metric are DELETED (forward-only: an old picture is not an invariant).

var ZIP = "@ZIP@";
var REEXPORT = "@REEXPORT@";
var ASSETS = @ASSETS@, OBJECTS = @OBJECTS@;

function assert(cond, msg) {
    if (!cond) throw new Error("assert failed: " + msg);
    console.log("ok: " + msg);
}
function J(x) { return JSON.stringify(x); }

var imported = project.importArchive(ZIP);
assert(imported && imported.guid && imported.guid.length > 10, "importArchive " + ZIP);
// (the import's `objects` counts what it STORED — derived outputs included — so the archive's file count,
// OBJECTS, is held against the re-export below, never against the import.)
assert(imported.assets === ASSETS,
       "the import brings in the manifest's " + ASSETS + " assets (" + imported.assets + "; " +
       imported.objects + " objects stored, the archive lists " + OBJECTS + " files)");
assert(!imported.bakeFailures || imported.bakeFailures.length === 0,
       "no bake failed on the import (" + J(imported.bakeFailures) + ")");
assert(project.open(imported.guid) === true, "project.open");
assert(world.photon().tier === "epic", "the sample's own row is Epic (" + world.photon().tier + ")");

// THE LAYERS, by name: the named node is the import's group; its mesh is the child.
function layers(when) {
    var meshes = {};
    var all = scene.nodes();
    var byId = {};
    all.forEach(function (n) { byId[n.id] = n; });
    all.forEach(function (n) {
        if (n.type !== "mesh") return;
        var p = byId[n.parent];
        var name = p && ["Main", "Top Shell", "Bottom Wave"].indexOf(p.name) >= 0 ? p.name : n.name;
        if (["Main", "Top Shell", "Bottom Wave"].indexOf(name) >= 0) meshes[name] = n.id;
    });
    ["Main", "Top Shell", "Bottom Wave"].forEach(function (name) {
        assert(!!meshes[name], when + ", " + name + ": the layer is in the archive");
        var m = material.get(meshes[name]);
        assert(typeof m.customPiecePixel === "string" && m.customPiecePixel.length > 0 &&
               typeof m.customPieceVertex === "string" && m.customPieceVertex.length > 0,
               when + ", " + name + ": both generated pieces re-emitted from the graph, with an EMPTY piece cache");
        assert(String(m.customPiecePixel).indexOf("@HOME@") === 0,
               when + ", " + name + ": ...into the cache under this run's data root (" + m.customPiecePixel + ")");
        if (name !== "Main")
            assert(typeof m.baseColorMap === "string" && m.baseColorMap.length > 0,
                   when + ", " + name + ": the baked cut-out map came back (baseColorMap " + J(m.baseColorMap) + ")");
    });
}
layers("the import");

// THE ROUND TRIP: the project as imported, exported again, is the same archive.
var again = project.exportArchive(REEXPORT);
assert(again && again.assets === ASSETS && again.objects === OBJECTS,
       "re-exported: " + again.assets + " assets, " + again.objects + " objects — the shipped archive's " +
       ASSETS + " and " + OBJECTS);

// THE REOPEN: closed and opened again, the live materials are still whole.
var guid = imported.guid;
assert(project.close(), "closed");
assert(project.open(guid) === true, "project.open again");
layers("the reopen");
assert(project.close(), "closed again");
console.log("archive_fidelity: reopened");
