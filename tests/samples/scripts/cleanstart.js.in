// samples.cleanstart.<sample> — ONE shipped sample, ONE virgin HOME, EVERY
// claim the gate makes about that sample.
//
// It absorbed the other two sample suites on 2026-09-09 (TEST_GATE_AUDIT.md §2):
// scripting.e2e.samples, which re-imported five of the same archives into one
// SHARED home to probe their colours, and the seven samples.scale.* rows, which
// re-imported all seven headless to read scene.bounds and editor.camera. Both
// were paying a second (and third) import of content this suite has already
// imported into a virgin home — 68 s of gate for assertions that are cheaper
// and STRICTER here, because here they run against the owner's actual first
// run rather than against a session that had already opened four other
// projects.
//
// What this suite asks, in order: the clean-start journey, then the scene-scale
// convention, then material fidelity and exact colours.
//
//   * a FRESH HOME per sample (one ctest test each), because "it worked after
//     the previous sample had already populated the store" is not the owner's
//     first run,
//   * app.engineErrors() after 120 fixed-dt frames — the renderer swallows its
//     failures by design, so a sample can look fine and still be telling the
//     error sink that a texture would not decode. The pump is the truth serum;
//     a sample that records ANY unexpected engine error fails here,
//   * the SAVE / CLOSE / REOPEN field diff (scene.reopen_fidelity's technique,
//     applied to shipped content instead of a fresh default scene). This is
//     what caught the reader's keepTransform defect: every top-level node with
//     a scale other than 1 came back rotated, by up to 10 degrees per open on
//     Showroom, compounding forever because closing autosaves,
//   * assets.bakeAll then reopen — the mesh bake landed 2026-09-04 and the
//     samples are its first real content; a baked open must produce the same
//     document as an unbaked one,
//   * the SCENE-SCALE CONVENTION, in numbers — extents, signature-object
//     sizes, interior room dimensions, node identity and the saved lens,
//   * MATERIAL FIDELITY and EXACT COLOURS, per sample, including the fire
//     plume before AND after the save round trip.
//
// TWO PIXEL PASSES, on purpose. renderSanity() is the WIDE one and runs for
// every sample: Showroom, Particles, Physics and Skeletal are NOT open-to-open
// pixel-deterministic (particle RNG, GI, physics), so it asserts only "the
// frame is neither black nor blown out and carries colour". The FIDELITY table
// is the NARROW one and runs for the five samples whose colours are pinnable —
// the gold dragon must BE gold.

var SAMPLE = "@SAMPLE@";
var ZIP = "@SOURCE_DIR@/scenes/" + SAMPLE + ".zip";

function assert(cond, msg) {
    if (!cond) throw new Error("assert failed: [" + SAMPLE + "] " + msg);
    console.log("ok: [" + SAMPLE + "] " + msg);
}
function J(x) { return JSON.stringify(x); }

// ---------------------------------------------------------------------------
// What each sample is supposed to BE. Node counts are minima (a sample may
// grow), names are the ones the sample's design promises.
var EXPECTED = {
    "Matcaps": { nodes: 5, names: ["StanfordDragon", "Ground", "Directional Light"],
                 types: { mesh: 2, light: 2 } },
    "Particles": { nodes: 10, names: ["Fire Pit", "Ground", "Sphere"],
                   types: { mesh: 3, particles: 4 } },
    "Physics": { nodes: 16, names: ["Teapot", "ball", "pipe", "Ground"],
                 types: { mesh: 13, light: 2 } },
    // The GRAND SHOWROOM (2026-09-07) replaced the old 241-node import: a
    // sealed hall of primitives — 6 room slabs, 4 columns, a 4-sphere metal
    // roughness ladder, a torus and a teapot — under VCT + probes. 23 nodes,
    // and it is REGENERABLE (scenes/tools/make_grand_showroom.js), which the
    // world it replaced was not.
    "Showroom": { nodes: 23, names: ["Floor", "Sphere_r0", "GoldTorus", "GreenTeapot"],
                  types: { mesh: 17, light: 5 }, objects: 0 },
    // The Mirror Room: the reflections sample (scenes/tools/make_mirror_room.js).
    // 14 since a799312a removed the two stray default-scene lights the resize
    // pass had left behind (the expectation lagged the re-stage — three lanes
    // independently flagged it).
    "Mirror Room": { nodes: 14, names: ["RedWall", "MirrorPanel", "MirrorSphere", "GoldTorus"],
                     types: { mesh: 11, light: 2 }, objects: 0 },
    "Skeletal Animation": { nodes: 70, names: ["Beta_HighLimbsGeoMesh", "Hips", "Ground"],
                            types: { mesh: 4, light: 2 } },
    // The three dragons became Dragon / Dragon2 / Dragon3 on 2026-09-09: they
    // were all "SceneNode24" (an importer leftover) and the first had no guid
    // at all, so no by-name or by-id verb could tell them apart.
    "World Background": { nodes: 7, names: ["Dragon", "Dragon3", "Ground"],
                          types: { mesh: 4, light: 2 } }
};

// ENGINE ERRORS THE SUITE TOLERATES, each with the reason it is not this
// sample's fault. Anything else fails the gate — that is the whole point of
// reading the pump.
//
//   "setClipStates: the node has no clips" — SceneMirror::attachClipsFor
//   disables the previous clip set before attaching a new one
//   (irisgl/mirror/scenemirror.cpp:1703) and the engine refuses that call when
//   the node has no clips yet, which is exactly the first attach. One entry per
//   rigged character per open, purely cosmetic, and irisgl-side: reported
//   2026-09-04, not fixed in this lane.
var TOLERATED = ["setClipStates: the node has no clips"];

function errorsClean(tag) {
    var e = app.engineErrors(false);
    var bad = [];
    for (var i = 0; i < e.entries.length; i++) {
        var m = e.entries[i].message;
        var ok = false;
        for (var t = 0; t < TOLERATED.length; t++) if (m.indexOf(TOLERATED[t]) >= 0) ok = true;
        if (!ok) bad.push(e.entries[i]);
    }
    console.log("engineErrors " + tag + ": drains=" + e.drains + " recorded=" + e.recorded +
                " entries=" + J(e.entries));
    assert(e.drains > 0, tag + ": the frame loop ran (drains " + e.drains + ")");
    assert(bad.length === 0, tag + ": no unexpected engine errors " + J(bad));
}

// The document state a round trip has to preserve. Live RUNTIME counters are
// excluded on purpose: world.planarReflections.activeActors counts the
// reflectors the renderer has registered this session, which is 0 before the
// first frames and 2 after — a reading, not a document field.
function snapshot() {
    var w = world.get();
    if (w.planarReflections) delete w.planarReflections.activeActors;
    var nodes = scene.nodes();
    var arr = [];
    var keys = ["intensity", "color", "distance", "spotCutOff", "shadowType",
                "shadowAlpha", "shadowBias", "castShadow", "visible", "lightType"];
    for (var i = 0; i < nodes.length; i++) {
        var n = nodes[i];
        var rec = { name: n.name, type: n.type };
        for (var k = 0; k < keys.length; k++) {
            try {
                var v = node.property(n.id, keys[k]);
                if (v !== undefined && v !== null) rec[keys[k]] = v;
            } catch (e) { /* the node has no such property */ }
        }
        var inf = node.info(n.id);
        rec.pos = inf.position; rec.rot = inf.rotation; rec.scale = inf.scale;
        if (n.type === "mesh") rec.mat = material.get(n.id);
        arr.push(rec);
    }
    // node ids are minted per open for some node kinds — compare CONTENT.
    arr.sort(function (a, b) {
        var ka = a.name + "|" + a.type + "|" + J(a.pos), kb = b.name + "|" + b.type + "|" + J(b.pos);
        return ka < kb ? -1 : (ka > kb ? 1 : 0);
    });
    return { world: w, nodes: arr };
}

// Numbers compare with an epsilon, everything else exactly. FLOAT RESIDUE (a
// value that moves by ~1e-7 relative) is what a float32 -> JSON -> float32 trip
// legitimately costs; anything bigger is a field that CHANGED, which is the
// defect class this gate exists for (0.66 deg on a Showroom wall panel, per
// open, is 1e-2 relative — six orders of magnitude above this bar).
function diffs(a, b, path, out) {
    path = path || ""; out = out || [];
    if (out.length > 20) return out;
    var ta = typeof a, tb = typeof b;
    if (ta === "number" && tb === "number") {
        if (a !== b) {
            var mag = Math.abs(a - b);
            var rel = Math.abs(a) > 1e-4 ? mag / Math.abs(a) : mag;
            if (rel > 1e-5) out.push(path + ": " + a + " -> " + b);
        }
        return out;
    }
    if (a === null || b === null || ta !== "object" || tb !== "object") {
        if (J(a) !== J(b)) out.push(path + ": " + J(a) + " -> " + J(b));
        return out;
    }
    var keys = {}, k;
    for (k in a) keys[k] = 1;
    for (k in b) keys[k] = 1;
    for (k in keys) {
        if (!(k in a)) { out.push(path + "." + k + ": ADDED " + J(b[k])); continue; }
        if (!(k in b)) { out.push(path + "." + k + ": REMOVED " + J(a[k])); continue; }
        diffs(a[k], b[k], path + "." + k, out);
    }
    return out;
}

function structure() {
    var nodes = scene.nodes();
    var byType = {}, names = {};
    for (var i = 0; i < nodes.length; i++) {
        byType[nodes[i].type] = (byType[nodes[i].type] || 0) + 1;
        names[nodes[i].name] = true;
    }
    return { count: nodes.length, byType: byType, names: names };
}

// "Not obviously broken": 25 probes spread over the frame. A scene that failed
// to render is uniformly black; one whose materials all fell back to blown-out
// white has no colour anywhere. Both are caught without pinning a single pixel.
function renderSanity(tag) {
    editor.frame(120, 1.0 / 60.0);
    var pts = [];
    for (var y = 0; y < 5; y++) for (var x = 0; x < 5; x++)
        pts.push({ x: 0.1 + x * 0.2, y: 0.1 + y * 0.2 });
    var shot = editor.screenshot("cleanstart_" + SAMPLE.replace(/ /g, "_") + "_" + tag + ".png",
                                 640, 360, pts);
    var black = 0, mean = 0, spread = 0;
    for (var i = 0; i < shot.probes.length; i++) {
        var p = shot.probes[i], b = (p.r + p.g + p.b) / 3;
        mean += b;
        if (b < 2) black++;
        spread = Math.max(spread, Math.abs(p.r - p.b), Math.abs(p.g - p.b));
    }
    mean /= shot.probes.length;
    console.log(tag + " pixels: mean=" + Math.round(mean) + " black=" + black +
                " maxChannelSpread=" + spread);
    assert(black <= 12, tag + ": the frame is not mostly black (" + black + "/25 probes)");
    assert(mean > 4 && mean < 250, tag + ": the frame has usable exposure (mean " + Math.round(mean) + ")");
    return shot;
}

// ---- SELECTION MUST NOT LEAK INTO A REFLECTION (Mirror Room only) ---------
//
// Owner report 2026-09-08: "selecting the mirror panel turns it gold". The
// selection highlight is an INVERTED HULL — the same mesh, scaled a few percent,
// drawn back-faces-only in the selection colour — and it was born carrying
// kVisibleBit at RQ 10, i.e. as ordinary scene geometry. The planar-reflection
// RTT (mask kVisibleBit, RQ 0..199) and the PCC probe faces (visibility_mask
// 0x1, rq_last 200) therefore both captured it, and because a reflected pass
// inverts vertex winding the hull renders SOLID in there: the panel reflected
// its own gold shell and flooded.
//
// The fix is one call — SceneMirror marks the shell a helper at birth — and
// this is the gate that keeps it. The measurement is deliberately about the
// panel's INTERIOR, where only the reflection is visible: the outline band
// itself lives around the silhouette and is SUPPOSED to appear, so probing the
// edges would assert the opposite of what we want.
function fmt(p) { return "(" + p.r + "," + p.g + "," + p.b + ")"; }
function selectionStaysOutOfTheMirror() {
    var panel = scene.find("MirrorPanel");
    assert(!!panel, "the MirrorPanel is findable by name");
    // Interior probes, all well inside the panel and all OFF THE GIZMO. The
    // centre pixel is where the translate gizmo's origin ball is drawn the
    // moment the panel is selected, so a probe at (0.50, 0.50) measures the
    // GIZMO and reports "selecting the panel changed its reflection" — which is
    // what it did on this sample's re-stage (2026-09-09: red 250,40,40 ->
    // gizmo-ball blue 65,118,232, with every off-axis probe bit-identical).
    // The shipped probes only avoided it by accident: frameNode put the camera
    // outside the room, where they measured a dark wall and nothing moved.
    // These three sit on the reflected red wall and the reflected green teapot,
    // clear of the gizmo's origin ball and of both visible axis arrows.
    var probes = [{ x: 0.35, y: 0.62 }, { x: 0.35, y: 0.38 }, { x: 0.40, y: 0.45 }];
    editor.select(null);
    // AN EXPLICIT CAMERA, NOT frameNode (changed 2026-09-09 with the sample's
    // re-stage to 1 unit = 1 metre). frameNode fills the view with the node, so
    // for this 3 m panel at the convention's 45-degree lens it wants ~7 m of
    // distance — and 7 m does not exist inside an 8.5 m sealed room, so the
    // camera landed OUTSIDE the walls and the "panel interior" probes were
    // measuring the red wall through the back of the room (60,48,49). The pose
    // below stands 4.5 m out along the panel's own normal (it is turned 28
    // degrees about Y), inside the room, with the panel filling ~78% of the
    // frame height: the centre probes are on the panel and nowhere else.
    editor.setCamera({ position: { x: 2.11, y: 1.75, z: 1.76 },
                       lookAt: { x: 0.0, y: 1.75, z: -2.2 }, fov: 45 });
    editor.frame(30, 1.0 / 60.0);
    var before = editor.screenshot("mirror_selection_unselected.png", 320, 240, probes);
    editor.select(panel);
    assert(editor.selection() === panel, "the panel is selected");
    editor.frame(30, 1.0 / 60.0);
    var after = editor.screenshot("mirror_selection_selected.png", 320, 240, probes);
    for (var i = 0; i < probes.length; i++) {
        var b = before.probes[i], a = after.probes[i];
        var dr = Math.abs(a.r - b.r), dg = Math.abs(a.g - b.g), db = Math.abs(a.b - b.b);
        console.log("  mirror probe " + i + ": " + fmt(b) + " -> " + fmt(a) +
                    "  delta " + dr + "," + dg + "," + db);
        // 40/255 per channel. The flood this gate exists for moved the green
        // channel by ~133 and the blue by ~46 in the diagnosis (86 -> 219 and
        // 76 -> 30), so the tolerance leaves room for a probe re-capture
        // landing between the two shots without leaving room for the defect.
        assert(dr <= 40 && dg <= 40 && db <= 40,
               "probe " + i + ": selecting the panel did not change its reflection (" +
               fmt(b) + " -> " + fmt(a) + ")");
    }
    editor.select(null);
}


// ===========================================================================
// THE SCENE-SCALE CONVENTION (folded in from samples.scale.*, 2026-09-09).
//
// Seven ctest rows — one per sample, each booting the binary headless for four
// seconds to import a sample this suite has ALREADY imported two lines above —
// bought nothing that could not be asserted here (TEST_GATE_AUDIT.md §2). The
// verbs are document verbs, so they run identically in this engine-up session;
// the display-free proof that scene.bounds and editor.camera need no GPU lives
// in scripting.e2e.scene_bounds.
//
// THE CONVENTION (owner, 2026-09-08, after the Showroom "looked zoomed and its
// gizmo huge"): "we need a default scene size and to respect it for all sample
// scenes we make so the sample scenes don't make things go weird". It reads:
//
//   * 1 unit = 1 METRE. Rooms are human-scale, objects are the size the same
//     object is in the world.
//   * the SAVED editor camera uses the default explorer lens — 45 degrees
//     VERTICAL, which is already 72.7 degrees horizontal at 16:9 (a 24 mm
//     equivalent). The free-camera framing policy renders the authored vertical
//     angle exactly at or below 16:9 and holds the 16:9 horizontal extent
//     beyond it (CLAUDE.md), so this number is what the picture is.
//   * one fly speed therefore feels the same in every sample, and a gizmo is
//     the same size on screen in every sample — which is what the convention
//     was asked for.
//
// WHY NUMBERS AND NOT PIXELS. The samples drifted to 2x and 4x life size one
// edit at a time (a 23.5 m hall with 3.4 m display spheres, a 7.2 m dancer),
// and each drift was invisible on its own because the SAVED CAMERA was widened
// or pulled back to compensate — the two errors hide each other in every
// screenshot. Numbers do not hide.
function near(actual, want, tol, what) {
    var lo = want * (1 - tol), hi = want * (1 + tol);
    assert(actual >= lo && actual <= hi,
           what + " = " + actual.toFixed(2) + " m, pinned at " + want +
           " +-" + Math.round(tol * 100) + "% [" + lo.toFixed(2) + ", " + hi.toFixed(2) + "]");
}

// THE ENVELOPE — the part that is true of EVERY shipped sample, with the reason
// each bound is where it is. These are limits, not pins: they say "this scene
// is authored in metres and photographed with a scene lens", and nothing else.
var ENVELOPE = {
    // 40..60 degrees VERTICAL. 45 is the default explorer lens; below 40 a
    // sample would ship a telephoto nobody can navigate, above 60 (= 100+
    // degrees horizontal at 16:9) is the fisheye the 2x rooms needed to fit
    // themselves in frame, which is exactly the drift this gate exists for.
    fovMin: 40, fovMax: 60,
    // The scene's own geometry, ground plane excluded, in metres. 40 m is a
    // city block: a SAMPLE bigger than that is not a sample of anything. The
    // floor of 0.5 m catches the opposite failure (an archive that opened
    // empty measures nothing).
    extentMax: 40.0, extentMin: 0.5,
    // The saved eye. Below 0.3 m the camera is in the floor; above 25 m it is
    // a satellite. (Physics deliberately watches a drop tower from 16 m.)
    cameraHeightMin: 0.3, cameraHeightMax: 25.0,
    // A saved camera has to be LOOKING AT its own scene: no further from the
    // content's centre than 4 radii. This is what catches "the room shrank and
    // the camera did not" — the failure mode where the numbers move but every
    // screenshot still looks plausible because the subject is a speck.
    cameraDistanceRadii: 4.0
};

// PER-SAMPLE PINS. Measured on the shipped archives (lane-samplescale,
// 2026-09-09) and re-measured after the re-stage. `extent` is the world AABB of
// the sample's geometry WITHOUT the built-in 1024 m ground plane; `objects`
// pins the size of each sample's signature object, which is where "human
// scale" is actually visible; `room` (the two built-from-primitives samples)
// pins the INTERIOR — wall to wall, floor top to ceiling bottom.
//
// A deliberate re-stage updates this table in the same commit that re-stages,
// with before/after numbers in the message. That is the whole contract.
var SCALE = {
    "Matcaps": {
        extent: { x: 4.78, y: 3.37, z: 2.14 }, cameraHeight: 5.69, fov: 45,
        objects: { "StanfordDragon": { y: 3.37 } }
    },
    "Mirror Room": {
        // Re-staged 2026-09-09: 1.75x -> 1x (an 8.5 m room, not 14.9 m).
        // The floor and ceiling slabs are 18 m squares that overhang the walls
        // — that is what makes the aggregate extent bigger than the room.
        extent: { x: 18.0, y: 5.5, z: 18.0 }, cameraHeight: 2.4, fov: 45,
        room: { width: 8.5, depth: 8.5, height: 3.5 },
        objects: { "MirrorSphere": { y: 3.0 }, "GreenTeapot": { x: 2.12 } }
    },
    "Particles": {
        extent: { x: 7.14, y: 4.99, z: 7.14 }, cameraHeight: 11.04, fov: 45,
        objects: { "Fire Pit": { x: 7.14 } }
    },
    "Physics": {
        // The drop tower: metric objects (2 m pipes, a 2.5 m ball) stacked to
        // 17 m so they can fall. Big, but every object in it is life size.
        extent: { x: 11.31, y: 12.0, z: 21.0 }, cameraHeight: 16.11, fov: 45,
        objects: { "ball": { y: 2.48 }, "pipe": { y: 2.0 } }
    },
    "Showroom": {
        // Re-staged 2026-09-09: 2x -> 1x (an 11.75 m gallery under a 3.25 m
        // ceiling, with 1.7 m display spheres), lens 75 -> 45 degrees.
        extent: { x: 24.0, y: 4.25, z: 24.0 }, cameraHeight: 2.45, fov: 45,
        room: { width: 11.75, depth: 11.75, height: 3.25 },
        objects: { "Sphere_r0": { y: 1.7 }, "GreenTeapot": { x: 1.93 } }
    },
    "Skeletal Animation": {
        // Re-staged 2026-09-09: the Collada rig is in CENTIMETRES and its root
        // carried scale 0.04, so the dancer stood 7.2 m tall. 0.01 is cm -> m.
        extent: { x: 1.94, y: 1.81, z: 0.31 }, cameraHeight: 1.28, fov: 45,
        objects: { "capoeira": { y: 1.81 } }
    },
    "World Background": {
        // Three dragon statues on the shared ground plane; the sample is about
        // the SKY behind them, so the statues are all the geometry there is.
        // They were three nodes all called "SceneNode24", the first with an
        // EMPTY guid (found by this gate 2026-09-09, repaired the same day:
        // the reader mints a guid for a node that has none, and the sample's
        // meshes are Dragon / Dragon2 / Dragon3).
        extent: { x: 8.78, y: 3.37, z: 10.14 }, cameraHeight: 4.14, fov: 45,
        objects: { "Dragon": { y: 3.37 } }
    }
};

// Pin tolerance. Tight enough that a 2x re-scale, a 4x rig-unit slip or a
// re-framed camera fails; loose enough that a rotated node's AABB, a mesh
// re-bake or a float32 round trip does not.
var SCALE_TOL = 0.15;

function checkScale() {
    var want = SCALE[SAMPLE];
    assert(!!want, "the suite knows what scale " + SAMPLE + " is authored at");

    // ---- the geometry ------------------------------------------------------
    // The ground plane is excluded by NAME here rather than by the built-in
    // mesh path the C++ side uses (services/sceneextents.h), because a script
    // has no window into meshPath — and every shipped sample calls it "Ground".
    // It is a 1024 m backdrop present in every scene: left in, it is the only
    // number any measurement would ever report.
    var rootId = scene.root();
    var roots = scene.nodes({ depth: 1 });   // the root itself plus its children
    var ids = [], i;
    for (i = 0; i < roots.length; i++) {
        if (roots[i].id === rootId) continue;          // measuring it measures everything
        if (roots[i].name === "Ground") continue;
        ids.push(roots[i].id);
    }
    assert(ids.length > 0, "the scene has something to measure (" + ids.length + " root nodes)");

    var b = scene.bounds({ nodes: ids });
    console.log("bounds: " + J(b));
    assert(b.nodes > 0, "scene.bounds measured geometry (" + b.nodes + " nodes)");

    // THE ENVELOPE, then the pins.
    var axes = ["x", "y", "z"];
    for (i = 0; i < axes.length; i++) {
        var a = axes[i];
        assert(b.size[a] <= ENVELOPE.extentMax,
               "extent." + a + " " + b.size[a].toFixed(2) + " m is inside the envelope (<= " +
               ENVELOPE.extentMax + " m)");
    }
    var biggest = Math.max(b.size.x, b.size.y, b.size.z);
    assert(biggest >= ENVELOPE.extentMin,
           "the scene has size at all (largest axis " + biggest.toFixed(2) + " m)");
    for (i = 0; i < axes.length; i++)
        near(b.size[axes[i]], want.extent[axes[i]], SCALE_TOL, "extent." + axes[i]);

    // ---- the signature objects ---------------------------------------------
    for (var name in (want.objects || {})) {
        var id = scene.find(name);
        assert(!!id, "the '" + name + "' node is in the scene");
        var ob = scene.bounds({ nodes: [id] });
        assert(ob.nodes > 0, name + " has geometry to measure");
        console.log("  " + name + " size: " + J(ob.size));
        for (var axis in want.objects[name])
            near(ob.size[axis], want.objects[name][axis], SCALE_TOL, name + "." + axis);
    }

    // ---- the room (the samples built from primitives) ----------------------
    // Interior, not outline: the floor and ceiling slabs overhang the walls, so
    // the only honest reading of "how big is this room" is wall face to wall
    // face and floor top to ceiling bottom. A room is human-scale when a person
    // fits in it — 2.4 m is a domestic ceiling, 4.5 m is a gallery, and
    // anything above that is the drift this gate exists to stop.
    if (want.room) {
        var floor = scene.bounds({ nodes: [scene.find("Floor")] });
        var ceiling = scene.bounds({ nodes: [scene.find("Ceiling")] });
        var height = ceiling.min.y - floor.max.y;
        console.log("  interior height: " + height.toFixed(2) + " m");
        assert(height >= 2.4 && height <= 4.5,
               "the ceiling is at a human height (" + height.toFixed(2) + " m, envelope 2.4-4.5)");
        near(height, want.room.height, SCALE_TOL, "room height");

        var wallNames = SAMPLE === "Showroom" ? ["WallW", "WallE", "WallS", "WallN"]
                                              : ["WallW", "WallE", "BlueWall", "RedWall"];
        var w = scene.bounds({ nodes: [scene.find(wallNames[0])] });
        var e = scene.bounds({ nodes: [scene.find(wallNames[1])] });
        var s = scene.bounds({ nodes: [scene.find(wallNames[2])] });
        var n = scene.bounds({ nodes: [scene.find(wallNames[3])] });
        var width = e.min.x - w.max.x, depth = n.min.z - s.max.z;
        console.log("  interior floor: " + width.toFixed(2) + " x " + depth.toFixed(2) + " m");
        near(width, want.room.width, SCALE_TOL, "room width");
        near(depth, want.room.depth, SCALE_TOL, "room depth");
    }

    // ---- IDENTITY: every node addressable, every sibling name unique -------
    //
    // Not scale, but the same class of thing and found by the same measuring
    // pass: a node with no guid cannot be reached by ANY verb (scene.find
    // returns "", node.* refuses, the MCP tools cannot name it, and the
    // per-node DB row has no key), and two SIBLINGS with one name are a coin
    // toss for every by-name lookup a script, a test or a user makes. Shipping
    // either in a sample is shipping a scene the editor cannot fully drive.
    // World Background shipped both.
    //
    // Siblings, deliberately: two nodes with the same name under DIFFERENT
    // parents are addressable by path and are how the Particles sample carries
    // a "Fire" on the sphere and a "Fire" on the fire pit.
    var all = scene.nodes();
    var byParent = {};
    for (i = 0; i < all.length; i++) {
        assert(typeof all[i].id === "string" && all[i].id.length > 10,
               "'" + all[i].name + "' has a real guid (" + J(all[i].id) + ")");
        var pkey = (all[i].parent || "<root>") + "|" + all[i].name;
        assert(!byParent[pkey],
               "no two siblings share the name '" + all[i].name + "' (parent " +
               (all[i].parent || "<root>") + ")");
        byParent[pkey] = true;
    }
    console.log("identity: " + all.length + " nodes, all addressable, sibling names unique");

    // ---- the saved camera --------------------------------------------------
    // editor.camera() is a DOCUMENT verb (lane-samplescale): the stand-in
    // viewport a headless run boots holds exactly the camera the scene file
    // loaded, lens included, which is the only way the saved lens can be
    // asserted without a GPU.
    var cam = editor.camera();
    console.log("camera: " + J(cam));
    assert(cam.projection === "perspective", "the saved camera is perspective");
    assert(cam.fov >= ENVELOPE.fovMin && cam.fov <= ENVELOPE.fovMax,
           "the saved lens is a scene lens (" + cam.fov + " deg, envelope " +
           ENVELOPE.fovMin + "-" + ENVELOPE.fovMax + ")");
    assert(cam.fov === want.fov, "the saved lens is the pinned " + want.fov + " deg (" + cam.fov + ")");

    assert(cam.position.y >= ENVELOPE.cameraHeightMin && cam.position.y <= ENVELOPE.cameraHeightMax,
           "the eye is at a usable height (" + cam.position.y.toFixed(2) + " m)");
    near(cam.position.y, want.cameraHeight, SCALE_TOL, "camera height");

    var dx = cam.position.x - b.center.x, dy = cam.position.y - b.center.y,
        dz = cam.position.z - b.center.z;
    var dist = Math.sqrt(dx * dx + dy * dy + dz * dz);
    var radius = 0.5 * Math.sqrt(b.size.x * b.size.x + b.size.y * b.size.y + b.size.z * b.size.z);
    console.log("  camera distance " + dist.toFixed(2) + " m, content radius " + radius.toFixed(2) + " m");
    assert(dist <= radius * ENVELOPE.cameraDistanceRadii,
           "the saved camera is looking at its own scene (" + dist.toFixed(2) + " m <= " +
           (radius * ENVELOPE.cameraDistanceRadii).toFixed(2) + " m)");
}

// ===========================================================================
// MATERIAL FIDELITY AND EXACT-COLOUR PROBES (folded in from
// scripting.e2e.samples, 2026-09-09).
//
// That suite imported five of these same archives into one shared home and one
// shared session and probed them — a second 37 s import of content this suite
// has already imported into a VIRGIN home two lines above (TEST_GATE_AUDIT.md
// §2). Every one of its claims lives here now, per sample, against the fresh
// install rather than against a session that had already opened four other
// projects:
//
//   * the materials the conversion owns (the dragons are the drawer's
//     Gold/Silver/Glass PBR presets — scenes/tools/convert_legacy_materials.py),
//   * texture properties resolve to store paths, never raw guids,
//   * PIXELS: an engine screenshot with colour probes (editor.screenshot's
//     5x5-averaged probe points) — the gold dragon must BE gold, the blue
//     character blue, the red pipe red. Probes are loose enough for driver
//     variation (lavapipe CI == GPU per the headless-vulkan spike).
//   * the SAVE ROUND TRIP for Particles (2026-09-03): the writer recovered a
//     texture's asset guid by matching its FILE NAME, and since the CAS an
//     object's file name is its sha256 — so one save wrote "" for every emitter
//     texture and the next open rendered the fire as large white squares.
//     Nothing that only imported ever caught it. The round trip this suite
//     already performs at step 5 is where those assertions now hang.
//
// These are the EXACT-colour probes. The wide-tolerance "not obviously broken"
// pass (renderSanity) stays as it is and runs for every sample; this runs for
// the five samples whose colours are pinnable. Showroom and Mirror Room have
// no entry because they never had one — they are not open-to-open pixel
// deterministic (VCT + planar actors), which is exactly why the Mirror Room's
// own gate below is a DELTA between two shots rather than an absolute colour.

function bright(p) { return (p.r + p.g + p.b) / 3; }
function isNeutral(p, tol) {
    var mx = Math.max(p.r, p.g, p.b), mn = Math.min(p.r, p.g, p.b);
    return (mx - mn) <= tol;
}
function assertTexturePath(matName, key, v) {
    assert(typeof v === "string" && v.length > 0 && !GUID_RE.test(v) && v.indexOf("/") >= 0,
           matName + "." + key + " resolves to a file path (" + v + ")");
}
function meshesByName(name) {
    var out = [];
    var ns = scene.nodes();
    for (var i = 0; i < ns.length; i++)
        if (ns[i].type === "mesh" && ns[i].name === name) out.push(ns[i]);
    return out;
}

// 15 wall-clock frames used to be enough for everything in these samples. It is
// not enough for a PARTICLE system: the engine simulates those now, charging
// each frame the time it actually took, and an offscreen frame takes about a
// millisecond — so 15 frames buy 15 ms of fire and photograph an empty pit.
// editor.frame(n, dt) pushes a FIXED step to the particle clock too, so 150
// frames at 1/60 s is a deterministic 2.5 s of warm-up: past the flame's 1.7 s
// lifetime, so the plume is full and steady.
//
// 960x540 is the size the probe boxes below were mapped at — do not change it
// without re-mapping them. And they are taken AFTER renderSanity("open")'s 120
// fixed-step frames plus this function's 150: t = 4.5 s of simulation, not the
// 2.5 s the old e2e_samples shot at. Fixed dt keeps that deterministic; change
// renderSanity's frame count and every fidelity probe moves (code review
// 2026-09-10).
function shoot(name, probePoints) {
    editor.frame(150, 1.0 / 60.0);
    var shot = editor.screenshot("samples_" + name + ".png", 960, 540, probePoints);
    assert(shot.probes && shot.probes.length === probePoints.length,
           name + ": screenshot with " + probePoints.length + " probes");
    var line = name + " probes:";
    for (var i = 0; i < shot.probes.length; i++) line += " " + fmt(shot.probes[i]);
    console.log(line);
    return shot.probes;
}

// ---- the fire-billboard probe (2026-09-03) ---------------------------------
// The "sphere renders yellow" probe below convicted nothing about the FIRE: it
// samples the emissive Sphere MESH, which keeps its colour whatever happens to
// the emitters. When the particle texture stopped reaching BillboardSet2 the
// sample rendered as large white additive squares over that same yellow sphere
// and the suite stayed green all day.
//
// So probe the PLUME itself, as a population rather than a pixel: particle
// simulation is stochastic, but its COLOUR is not. A textured fire is warm
// (red well above blue); an untextured additive quad is flat white, because
// the datablock falls back to its white vertex colour and the alpha cutout
// that shapes a flame is exactly what is missing.
//
// THE BOX MOVED (2026-09-03, ParticleFX2 adoption). The re-authored sample's
// flame is a real 1.7 s plume rising out of the pit instead of the legacy
// 24-second column, so it occupies a different part of the same frame. Mapped
// with a 20x20 warm-probe grid over the re-authored scene, warmed the same way
// shoot() warms it: the flame runs x 0.42-0.62, y 0.22-0.73, densest around
// y 0.32-0.58.
//
// Measured over the new box (960x540, 4080): healthy is 30 of 30 warm, 0 white
// — the box is inside the flame core, so the margin over the >= 8 threshold is
// the whole point. A lost texture turns an additive system into a saturated
// white slab rather than a plume, which the white counter catches.
function firePlumeProbePoints() {
    var pts = [];
    for (var yi = 0; yi < 6; yi++)
        for (var xi = 0; xi < 5; xi++)
            pts.push({ x: 0.472 + xi * 0.018, y: 0.36 + yi * 0.040 });
    return pts;
}
function assertFireIsFire(probes, when) {
    var warm = 0, white = 0;
    for (var i = 0; i < probes.length; i++) {
        var p = probes[i];
        var mx = Math.max(p.r, p.g, p.b), mn = Math.min(p.r, p.g, p.b);
        if (p.r > p.b + 25 && p.r > 60) warm++;
        if (mn > 140 && (mx - mn) <= 30) white++;
    }
    assert(warm >= 8, "Particles" + when + ": the plume is FIRE-coloured (" + warm +
                      "/" + probes.length + " warm probes)");
    assert(white <= 2, "Particles" + when + ": no untextured white billboards (" + white +
                       "/" + probes.length + " flat-white probes)");
}

// The per-sample fidelity pass, run on the freshly opened project.
var FIDELITY = {
    "Matcaps": function () {
        var dragons = meshesByName("StanfordDragon");
        assert(dragons.length === 1, "Matcaps: one dragon mesh");
        var m = material.get(dragons[0].id);
        assert(m.metallic === 1 && m.baseColor === "#ffd700",
               "Matcaps: dragon is the Gold PBR preset (metallic=" + m.metallic +
               " baseColor=" + m.baseColor + ")");
        assertTexturePath("Matcaps ground", "baseColorMap",
                          material.get(meshesByName("Ground")[0].id).baseColorMap);
        var p = shoot("matcaps", [ { x: 0.49, y: 0.49 }, { x: 0.50, y: 0.40 }, { x: 0.15, y: 0.85 } ]);
        // Gold reads gold even in shadow: strong red-over-blue at two body points.
        assert(p[0].r > 40 && p[0].r > p[0].b + 30, "Matcaps: dragon body 1 is gold " + fmt(p[0]));
        assert(p[1].r > 40 && p[1].r > p[1].b + 30, "Matcaps: dragon body 2 is gold " + fmt(p[1]));
        assert(isNeutral(p[2], 25) && bright(p[2]) > 15 && bright(p[2]) < 160,
               "Matcaps: checker ground is neutral grey " + fmt(p[2]));
    },
    "Particles": function () {
        var sphereMat = material.get(meshesByName("Sphere")[0].id);
        // The sphere used the EdgeMaterial builtin. It is a PbrMaterial now
        // (HLMS_ADOPTION P4b), so its authored colour lives on `baseColor` —
        // the fresnel rim EdgeMaterial also carried has no material-parameter
        // home and is documented as lost in src/io/builtinmaterials.cpp.
        assert(sphereMat.baseColor === "#ffcd37",
               "Particles: sphere keeps its edge-material colour (" + sphereMat.baseColor + ")");
        assertTexturePath("Particles ground", "baseColorMap",
                          material.get(meshesByName("Ground")[0].id).baseColorMap);
        assertTexturePath("Particles fire pit", "baseColorMap",
                          material.get(meshesByName("Fire Pit")[0].id).baseColorMap);
        var particleCount = 0;
        var ns = scene.nodes();
        for (var i = 0; i < ns.length; i++) if (ns[i].type === "particles") particleCount++;
        assert(particleCount >= 4, "Particles: particle systems present (" + particleCount + ")");
        var p = shoot("particles", [ { x: 0.49, y: 0.645 }, { x: 0.2, y: 0.9 } ]);
        assert(p[0].r > 120 && p[0].g > 90 && p[0].r > p[0].b + 60,
               "Particles: sphere renders yellow " + fmt(p[0]));
        assert(isNeutral(p[1], 25), "Particles: ground is neutral grey " + fmt(p[1]));
        assertFireIsFire(shoot("particles_plume", firePlumeProbePoints()), "");
    },
    "Skeletal Animation": function () {
        var limb = material.get(meshesByName("Beta_HighLimbsGeoMesh")[0].id);
        assert(limb.baseColor === "#5ebfe7",
               "Skeletal: character keeps its blue colour (" + limb.baseColor + ")");
        var p = shoot("skeletal", [ { x: 0.458, y: 0.363 }, { x: 0.2, y: 0.9 } ]);
        assert(p[0].b > 60 && p[0].b > p[0].r + 20, "Skeletal: character torso is blue " + fmt(p[0]));
        assert(isNeutral(p[1], 25), "Skeletal: ground is neutral grey " + fmt(p[1]));
    },
    "World Background": function () {
        // Dragon / Dragon2 / Dragon3 since 2026-09-09 — they were three meshes
        // all called "SceneNode24", the first of them with an empty guid.
        var dragons = meshesByName("Dragon").concat(meshesByName("Dragon2"))
                                            .concat(meshesByName("Dragon3"));
        assert(dragons.length === 3, "World: three dragon meshes");
        var byColor = {}, m;
        for (var i = 0; i < dragons.length; i++) {
            m = material.get(dragons[i].id);
            byColor[m.baseColor] = m;
        }
        assert(byColor["#f5f5f7"] && byColor["#f5f5f7"].metallic === 1,
               "World: Silver PBR dragon present");
        assert(byColor["#ffd700"] && byColor["#ffd700"].metallic === 1,
               "World: Gold PBR dragon present");
        assert(byColor["#eef4f8"] && byColor["#eef4f8"].alphaMode === 3 && byColor["#eef4f8"].alpha < 0.5,
               "World: Glass PBR dragon present (alphaMode 3, alpha " +
               (byColor["#eef4f8"] ? byColor["#eef4f8"].alpha : "?") + ")");
        assertTexturePath("World ground", "baseColorMap",
                          material.get(meshesByName("Ground")[0].id).baseColorMap);
        var p = shoot("world", [ { x: 0.45,  y: 0.478 },   // gold dragon body highlight
                                 { x: 0.194, y: 0.463 },   // silver dragon belly highlight
                                 { x: 0.829, y: 0.533 },   // glass dragon (floor shows through)
                                 { x: 0.512, y: 0.111 } ]); // cubemap sky: park foliage
        assert(p[0].r > p[0].b + 40 && p[0].g > p[0].b + 30, "World: gold dragon is gold " + fmt(p[0]));
        assert(bright(p[1]) > 100, "World: silver dragon renders bright " + fmt(p[1]));
        assert(bright(p[2]) > 70, "World: glass dragon area is translucent-bright " + fmt(p[2]));
        assert(p[3].g > p[3].b + 15 && p[3].g > 40, "World: cubemap sky shows the park foliage " + fmt(p[3]));
    },
    "Physics": function () {
        assert(material.get(meshesByName("pipe")[0].id).baseColor === "#c63030",
               "Physics: red pipe colour kept");
        assert(material.get(meshesByName("pipe 6")[0].id).baseColor === "#7872bf",
               "Physics: purple pipe colour kept");
        var p = shoot("physics", [ { x: 0.327, y: 0.322 },  // red pipe cap
                                   { x: 0.627, y: 0.841 },  // purple pipe band
                                   { x: 0.463, y: 0.53 } ]); // teapot
        // Red reads red even in shade: strong hue ratio (grey fallback has r==g==b).
        assert(p[0].r > 45 && p[0].r > p[0].g * 2 && p[0].r > p[0].b * 2,
               "Physics: red pipe cap is red " + fmt(p[0]));
        assert(p[1].b > 90 && p[1].b > p[1].g + 25, "Physics: purple pipe is purple " + fmt(p[1]));
        // RE-BASELINED for the Epic World Mode default (POST_CHAIN_SPEC §12
        // decision 8): a document with no worldMode — which is every shipped
        // sample — now reads as Epic, which turns VCT global illumination on and
        // softens/enlarges the shadow atlas. The teapot is the same white
        // teapot, a few percent dimmer for the indirect bounce; 110 keeps this a
        // real "bright and neutral" assertion while no longer being tuned to a
        // GI-off world.
        assert(bright(p[2]) > 110 && isNeutral(p[2], 35), "Physics: teapot is bright white " + fmt(p[2]));
    }
};

// The half that can only be asserted AFTER the save/close/reopen this suite
// already performs at step 5. Everything a save can silently drop lives here.
var REOPEN_FIDELITY = {
    "Particles": function () {
        // PIXELS FIRST: the emitters are what the owner sees, and the
        // document-level assertions below only say where the writer went wrong.
        assertFireIsFire(shoot("particles_plume_resaved", firePlumeProbePoints()),
                         " after save+reopen");
        assertTexturePath("Particles ground (reopened)", "baseColorMap",
                          material.get(meshesByName("Ground")[0].id).baseColorMap);
        assertTexturePath("Particles fire pit (reopened)", "baseColorMap",
                          material.get(meshesByName("Fire Pit")[0].id).baseColorMap);
        assertTexturePath("Particles fire pit (reopened)", "normalMap",
                          material.get(meshesByName("Fire Pit")[0].id).normalMap);
    }
};

// ---------------------------------------------------------------------------
var want = EXPECTED[SAMPLE];
assert(!!want, "the suite knows what " + SAMPLE + " should contain");
app.engineErrors(true);

// 1. INSTALL, through the same verb the sample dialog's double-click runs.
var imported = project.importArchive(ZIP);
assert(imported && imported.guid && imported.guid.length > 10, "importArchive -> " + (imported ? imported.guid : "null"));
assert(imported.assets > 0, "catalog rows imported (" + imported.assets + ")");
// OBJECTS: model files in the archive's CAS. The two script-built samples
// (Showroom, Mirror Room) are made of PRIMITIVES, whose meshes are app
// resources rather than library assets, so a correct import of those ingests
// none — `objects` is per-sample expectation, not a universal contract.
var wantObjects = want.objects === undefined ? 1 : want.objects;
assert(imported.objects >= wantObjects,
       "objects ingested (" + imported.objects + " >= " + wantObjects + ")");

// 2. OPEN and check the content is the content.
assert(project.open(imported.guid) === true, "project.open");
var s = structure();
console.log("structure: " + J(s.byType) + " total " + s.count);
assert(s.count >= want.nodes, "node count >= " + want.nodes + " (" + s.count + ")");
for (var i = 0; i < want.names.length; i++)
    assert(s.names[want.names[i]] === true, "the '" + want.names[i] + "' node is in the scene");
for (var t in want.types)
    assert((s.byType[t] || 0) >= want.types[t],
           "at least " + want.types[t] + " " + t + " nodes (" + (s.byType[t] || 0) + ")");

// 2b. THE SCENE-SCALE CONVENTION. Document verbs only, so it costs nothing on
//     top of the open that just happened.
checkScale();

// 3. MATERIALS resolve to files, never to bare guids or nothing.
var GUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
var textured = 0;
var nodes = scene.nodes();
for (i = 0; i < nodes.length; i++) {
    if (nodes[i].type !== "mesh") continue;
    var m = material.get(nodes[i].id);
    var maps = ["diffuseTexture", "normalTexture", "baseColorMap", "normalMap", "roughnessMap"];
    for (var k = 0; k < maps.length; k++) {
        var v = m[maps[k]];
        if (typeof v !== "string" || v.length === 0) continue;
        assert(!GUID_RE.test(v), nodes[i].name + "." + maps[k] + " is a path, not a raw guid (" + v + ")");
        textured++;
    }
}
console.log("resolved texture references: " + textured);

// 4. RENDER, then read the pump.
renderSanity("open");
// 4b. MATERIALS AND EXACT COLOURS, before the pump is drained: an error raised
//     while photographing the gold dragon is an error this sample caused.
if (FIDELITY[SAMPLE]) FIDELITY[SAMPLE]();
errorsClean("after open");
if (SAMPLE === "Mirror Room") selectionStaysOutOfTheMirror();
var s0 = snapshot();

// 5. SAVE / CLOSE / REOPEN — the field diff.
assert(project.save() === true, "project.save");
assert(project.close() === true, "project.close");
assert(project.open(imported.guid) === true, "project.open (REOPEN)");
var d = diffs(s0, snapshot());
assert(d.length === 0, "the document survived save/close/reopen unchanged: " + J(d));
renderSanity("reopen");
// 5b. THE HALF ONLY A ROUND TRIP CAN ASSERT: the writer once recovered a
//     texture's asset guid by matching its FILE NAME, and since the CAS a file
//     name is a sha256 — so one save wrote "" for every emitter texture and the
//     next open rendered the fire as white squares. Nothing that only imported
//     ever caught it.
if (REOPEN_FIDELITY[SAMPLE]) REOPEN_FIDELITY[SAMPLE]();
errorsClean("after reopen");

// 6. BAKE the sample's models, then reopen: an open that LOADS geometry must
//    produce the same document as one that parses it.
var dry = assets.bakeAll({ dryRun: true });
console.log("bakeAll dry run: " + J(dry));
var baked = assets.bakeAll({ dryRun: false });
console.log("bakeAll: " + J(baked));
assert(baked.failed === 0, "every bake succeeded (" + J(baked.errors) + ")");
assert(baked.baked === dry.needed, "the dry run counted what the real run baked (" +
       dry.needed + " vs " + baked.baked + ")");
var s1 = snapshot();
assert(project.close() === true, "project.close (after bake)");
assert(project.open(imported.guid) === true, "project.open (BAKED)");
d = diffs(s1, snapshot());
assert(d.length === 0, "the baked open produced the same document: " + J(d));
renderSanity("baked");
errorsClean("after baked reopen");

console.log("samples.cleanstart[" + SAMPLE + "]: ALL OK");
