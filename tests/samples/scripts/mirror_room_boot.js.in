// samples.mirror_room_boots.boot<k> — ONE boot (REFLECT-STATE-1): the Mirror Room sample opened
// into a virgin data root, settled on the fixed clock, one offscreen shot of the scene's own
// picture written where the runner put it. Two rows boot it once each, and boot 2 requires
// its picture byte-identical to boot 1's.
project.openSample("Mirror Room");
for (var i = 0; i < 4000 && project.archiveState() !== "idle"; ++i) editor.frame(1);
for (var i = 0; i < 4000 && project.openState() !== "idle"; ++i) editor.frame(1);
app.waitForTextures();
editor.frame(600, 1 / 60);
var s = editor.screenshot("@SHOT@", 960, 540, [], "scene");
if (!s || !s.width) throw new Error("the screenshot failed: " + app.lastError());
console.log("mirror_room_boot: shot @SHOT@");
// (the shot's settle and the cards' state, said - PHOTON-7 stage 10: a settle that ends at its cap is GI still moving,
// and two boots then photograph two pictures)
var c = world.giStatus().cards;
console.log("mirror_room_boot: the shot settled " + s.settleFrames + " frames, at rest " + s.atRest + "; the cards: " +
            c.restDecisions + " rest decision(s), " + c.relights + " relights (" + c.visibleRelights + " visible), " +
            c.cards + " resident");
// (the sky's deferred light reads, said - PHOTON-7 stage 10-3, item 0: a read taken at a GPU-paced frame was the boot
// pair's leading suspect; nonzero = the open took that path, now at a fixed due frame)
var sky = world.clouds().live || {};
console.log("mirror_room_boot: the sky's deferred reads: SH " + sky.skyShDeferredReads + ", cloud clear " +
            sky.cloudClearDeferredReads + "; scroll captures " + sky.scrollCaptures + ", change captures " +
            sky.changeCaptures);
// MEASURING ARM (DETERMINISM-1 stage 0): the compile mode's premise - captureDeferredDraws 0, nothing in the background
var as = app.asyncShaders();
console.log("DIAG APPASYNC captureDeferredDraws " + as.captureDeferredDraws + " placeholderDraws " + as.placeholderDraws +
            " pendingSkips " + as.pendingSkips + " compiledInBackground " + as.compiledInBackground);
if (s.atRest !== true) throw new Error("the shot settled to its cap, not to rest (" + s.settleFrames + " frames)");
"ok";
