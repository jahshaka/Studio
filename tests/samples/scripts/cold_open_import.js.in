// samples.cold_open.import (URGENT #48's follow-up, the lead's ruling (b), 2026-10-24; SPLIT BY PROOF, ORPHAN-REDS-1,
// 2026-11-03, URGENT #136's form) - THE OWNER'S FIRST RUN AFTER A WIPE, LAUNCH 1 OF 2: the smallest shipped sample
// (Showroom 2, 353 KB) imported from a VIRGIN home on a COLD shader cache - the row's home wiped before it, the shader
// cache with it (fresh_home.sh --setup without --warm) - so this boot compiles the startup set cold, the subject. Its
// laws: the archive imports (a guid, catalog rows) and the engine reports no error the suite does not tolerate. The
// launch quits cleanly, and the clean quit saves what this boot compiled: the home it leaves (FIXTURES_SETUP
// samplesColdOpen) is the one samples.cold_open.open boots on and opens the project in - the open's law, launch 2.
// WHY TWO LAUNCHES: the one-launch row (import, open, 120 frames) was 47.34 s quiet and 56.18 s at load and timed out
// at 60.08 s (§3667's cold compile at the cap); one launch a row, nothing cut.
var SAMPLE = "Showroom 2";
var ZIP = "@SOURCE_DIR@/scenes/" + SAMPLE + ".zip";
function assert(cond, msg) {
    if (!cond) throw new Error("assert failed: [" + SAMPLE + "] " + msg);
    console.log("ok: [" + SAMPLE + "] " + msg);
}
// the engine errors the suite tolerates (cleanstart.js.in's list, its reasons there)
var TOLERATED = ["setClipStates: the node has no clips"];
app.engineErrors(true);
var imported = project.importArchive(ZIP);
assert(imported && imported.guid && imported.guid.length > 10, "importArchive -> " + (imported ? imported.guid : "null"));
assert(imported.assets > 0, "catalog rows imported (" + imported.assets + ")");
var e = app.engineErrors(false);
var bad = [];
for (var i = 0; i < e.entries.length; i++) {
    var ok = false;
    for (var t = 0; t < TOLERATED.length; t++) if (e.entries[i].message.indexOf(TOLERATED[t]) >= 0) ok = true;
    if (!ok) bad.push(e.entries[i]);
}
console.log("engineErrors: drains=" + e.drains + " recorded=" + e.recorded + " entries=" + JSON.stringify(e.entries));
assert(bad.length === 0, "no unexpected engine errors " + JSON.stringify(bad));
console.log("samples.cold_open.import: PASS");
