// photon.view — THE PHOTON VIEW FROM THE SCRIPT SIDE (PHOTON-VIEW-1): world.setPhotonView
// paints the lighting's own debug pictures over the finished frame, and 'off' is the
// picture it was.
//
// Every picture is the editor's own shot ("scene" grade, the post chain the photon view
// paints in) at 160 x 90 with EVERY pixel probed (its centre), so "changed" is a pixel
// count and "the same picture" is every pixel equal.
//   (a) THE DEFAULT SCENE at the High Photon tier (deterministic, the atom.view rule):
//       every mode that can paint changes pixels, and 'off' after each is the 'off'
//       picture, pixel for pixel — the screen-probe discs restart the gather's rest and
//       the shot waits for it to settle again;
//   (b) SHOWROOM 2 at the High Photon tier, from an eye-level pose among the spheres:
//       each of the seven modes repaints more than 20 % of the picture against 'off';
//   (c) the refusals, each naming why: an unknown name; 'probes' with the irradiance
//       field off; 'cards' with the cards row off; 'hits' and 'screenProbes' with ray
//       tracing off; every mode at the Low world mode (its viewport draws no post
//       chain); 'voxels' with GI off — and world.giStatus() reports the view and the
//       reasons;
//   (d) the project's save (its thumbnail shot parks the view Off) leaves the view on.
// Frames, never time: every shot renders until the scene is at rest.

function assert(cond, msg) {
    if (!cond) throw new Error("assert failed: " + msg);
    console.log("ok: " + msg);
}
function J(x) { return JSON.stringify(x); }

var SHOWROOM = "@PHOTON_VIEW_SHOWROOM@";
var W = 160, H = 90;
var probes = [];
for (var y = 0; y < H; ++y)
    for (var x = 0; x < W; ++x) probes.push({ x: (x + 0.5) / W, y: (y + 0.5) / H });

function shot(name) {
    var r = editor.screenshot("photon_view_" + name + ".png", W, H, probes, "scene");
    assert(r && r.probes && r.probes.length === W * H, "shot " + name + " read every pixel");
    return r.probes;
}
function changed(a, b) {
    var n = 0;
    for (var i = 0; i < a.length; ++i)
        if (a[i].r !== b[i].r || a[i].g !== b[i].g || a[i].b !== b[i].b) ++n;
    return n;
}
function settle() {
    var st = world.giStatus();
    for (var i = 0; i < 200 && !st.giAtRest; ++i) { editor.frame(3); st = world.giStatus(); }
    return st;
}
// A change of row reaches the engine a few frames later: wait, in frames, until the
// scene says the view cannot paint (at most 180 frames), then ask the verb.
function refusedWith(view, pattern) {
    for (var i = 0; i < 60 && world.giStatus().viewRefusals[view] === ""; ++i) editor.frame(3);
    try { world.setPhotonView(view); } catch (e) { return pattern.test(String(e)); }
    return false;
}

var MODES = ["voxels", "probes", "cards", "screenProbes", "diffuse", "reflections", "hits"];

// ---- (a) the default scene: every mode that can paint, and 'off' exact ------------
var proj = project.create("Photon View " + Date.now());
assert(proj.length > 10, "project.create");
world.gi({ tier: "high" });
var st = settle();
assert(st.view === "off" && world.photonView() === "off", "a new scene starts with the view off");
console.log("default scene refusals: " + J(st.viewRefusals));
var off = shot("default_off");
var painted = 0;
for (var m = 0; m < MODES.length; ++m) {
    if (st.viewRefusals[MODES[m]] !== "") {
        console.log("default scene: '" + MODES[m] + "' cannot paint here — " + st.viewRefusals[MODES[m]]);
        continue;
    }
    assert(world.setPhotonView(MODES[m]) === true, "world.setPhotonView('" + MODES[m] + "')");
    assert(world.photonView() === MODES[m] && world.giStatus().view === MODES[m],
           "world.photonView and giStatus().view say " + MODES[m]);
    var pic = shot("default_" + MODES[m]);
    var n = changed(off, pic);
    console.log("default " + MODES[m] + ": " + (100 * n / (W * H)).toFixed(1) + " % of pixels changed");
    assert(n > 0, "default scene: '" + MODES[m] + "' paints something (" + n + " pixels)");
    ++painted;
    assert(world.setPhotonView("off") === true, "world.setPhotonView('off')");
    var back = shot("default_off_after_" + MODES[m]);
    assert(changed(off, back) === 0, "default scene: 'off' after '" + MODES[m] +
           "' restores the off picture exactly (" + changed(off, back) + " pixels differ)");
}
assert(painted >= 5, "the default scene painted at least five modes (" + painted + ")");

// ---- (c) the refusals ---------------------------------------------------------------
var unknown = false;
try { world.setPhotonView("wireframe"); } catch (e) { unknown = /unknown view/.test(String(e)); }
assert(unknown && world.photonView() === "off", "an unknown view is refused, by name, and changes nothing");

world.gi({ ddgi: "off" });
settle();
assert(refusedWith("probes", /irradiance field/) && world.photonView() === "off",
       "'probes' is refused with the irradiance field off, naming it");
world.gi({ ddgi: "auto" });
world.gi({ cards: "off" });
settle();
assert(refusedWith("cards", /surface cache/), "'cards' is refused with the cards row off, naming the cache");
world.gi({ cards: "auto" });
world.rayTracing("off");
editor.frame(6);
settle();
var noRays = world.giStatus().viewRefusals;
console.log("refusals without rays: " + J(noRays));
assert(refusedWith("hits", /traces reflections/), "'hits' is refused with ray tracing off");
assert(refusedWith("screenProbes", /gather/), "'screenProbes' is refused with ray tracing off");
world.rayTracing("auto");
editor.frame(6);
world.mode({ mode: "low" });
editor.frame(6);
settle();
for (var r = 0; r < MODES.length; ++r)
    assert(refusedWith(MODES[r], /post chain/), "at the Low world mode '" + MODES[r] + "' is refused");
world.mode({ mode: "epic" });
world.gi({ tier: "high" });
editor.frame(6);
settle();
world.photon({ enabled: false });
editor.frame(6);
settle();
assert(refusedWith("voxels", /voxel lighting/), "'voxels' is refused with GI off, naming the voxels");
world.photon({ enabled: true });
settle();

// ---- (b) Showroom 2 at the High tier: every mode repaints > 20 % ---------------------
var imported = project.importArchive(SHOWROOM);
assert(imported && imported.guid, "importArchive(Showroom 2)");
assert(project.open(imported.guid) === true, "project.open(Showroom 2)");
world.gi({ tier: "high" });
// EYE LEVEL AMONG THE SPHERES: the finest voxel cascade is a box of ten metres centred on
// the eye, so its voxels fill the frame only from where a person would stand.
editor.setCamera({ position: { x: 0, y: 1.5, z: -2.5 }, lookAt: { x: 0, y: 1.0, z: 3.0 } });
var ss = settle();
console.log("Showroom 2 refusals: " + J(ss.viewRefusals) + " cascades " + ss.cascades.length);
var srOff = shot("showroom_off");
for (var k = 0; k < MODES.length; ++k) {
    assert(ss.viewRefusals[MODES[k]] === "", "Showroom 2 at High can paint '" + MODES[k] + "' (" +
           ss.viewRefusals[MODES[k]] + ")");
    assert(world.setPhotonView(MODES[k]) === true, "Showroom 2: world.setPhotonView('" + MODES[k] + "')");
    var sp = shot("showroom_" + MODES[k]);
    var frac = changed(srOff, sp) / (W * H);
    console.log("Showroom 2 " + MODES[k] + ": " + (100 * frac).toFixed(1) + " % of pixels changed");
    assert(frac > 0.2, "Showroom 2: '" + MODES[k] + "' repaints more than 20 % (" + (100 * frac).toFixed(1) + " %)");
}

// ---- (d) the thumbnail parks the view ------------------------------------------------
assert(world.setPhotonView("probes") === true, "probes on for the save");
assert(project.save() === true, "project.save (its thumbnail shot parks the view)");
assert(world.photonView() === "probes", "the view is back on after the thumbnail shot");
assert(world.setPhotonView("off") === true, "off at the end");
"ok";
