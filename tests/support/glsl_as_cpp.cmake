# GLSL AS C++ - the build half of tests/support/glsl_as_cpp.h (MATERIAL-ENERGY-1 stage 1; shared with REFLECT-ESTIMATOR-1).
#
# include()d: defines jah_glsl_as_cpp( <target> OUT <name.h> PIECES <a_piece_all.any> ... OUT_PARAMS <n> ARRAYS <n> ) -
#   the ENGINE's own unwrap step (irisgl/cmake/WrapHlmsPiece.cmake -DUNWRAP=1) on the shipped pieces, then this file in
#   script mode on its output; <name.h> lands in <target>'s binary dir/generated, which is put on its include path, and
#   is rebuilt whenever a piece, the unwrap step or this file changes.
# -P (script mode): IN, OUT, OUT_PARAMS, ARRAYS - the two counted rewrites on an unwrapped text:
#   `out float `  -> `float & `           exactly OUT_PARAMS times
#   `float[N](`   -> `JAH_GLSL_ARRAY(`    exactly ARRAYS times
#   a miscount, or any other out / inout parameter left, FAILS THE BUILD: the shipped text changed its shape and the row
#   that compiles it must be looked at, never silently fed something else.
if(CMAKE_SCRIPT_MODE_FILE)
    if(NOT IN OR NOT OUT OR NOT DEFINED OUT_PARAMS OR NOT DEFINED ARRAYS)
        message(FATAL_ERROR "glsl_as_cpp: IN, OUT, OUT_PARAMS and ARRAYS are required")
    endif()
    file(READ "${IN}" _text)
    string(REGEX MATCHALL "out float " _outs "${_text}")
    list(LENGTH _outs _n_outs)
    string(REGEX MATCHALL "float\\[[0-9]+\\]\\(" _arrs "${_text}")
    list(LENGTH _arrs _n_arrs)
    if(NOT _n_outs EQUAL OUT_PARAMS OR NOT _n_arrs EQUAL ARRAYS)
        message(FATAL_ERROR "glsl_as_cpp: ${IN} holds ${_n_outs} `out float` parameter(s) and ${_n_arrs} array "
                            "constructor(s); its caller expects ${OUT_PARAMS} and ${ARRAYS} - the shipped text changed shape")
    endif()
    string(REPLACE "out float " "float & " _text "${_text}")
    string(REGEX REPLACE "float\\[[0-9]+\\]\\(" "JAH_GLSL_ARRAY(" _text "${_text}")
    string(REGEX MATCH "[(,][ \t\n]*(in)?out[ \t]+[A-Za-z_]" _left "${_text}")
    if(_left)
        message(FATAL_ERROR "glsl_as_cpp: ${IN} holds an out / inout parameter of another type ('${_left}'): "
                            "the shim has no rewrite for it")
    endif()
    file(WRITE "${OUT}" "// GENERATED by tests/support/glsl_as_cpp.cmake from ${IN} - never edited\n${_text}")
    return()
endif()

set(_JAH_GLSL_AS_CPP_SCRIPT "${CMAKE_CURRENT_LIST_FILE}")
function(jah_glsl_as_cpp target)
    cmake_parse_arguments(G "" "OUT;OUT_PARAMS;ARRAYS" "PIECES" ${ARGN})
    if(NOT G_OUT OR NOT G_PIECES OR NOT DEFINED G_OUT_PARAMS OR NOT DEFINED G_ARRAYS)
        message(FATAL_ERROR "jah_glsl_as_cpp(${target}): OUT, PIECES, OUT_PARAMS and ARRAYS are required")
    endif()
    set(_dir "${CMAKE_CURRENT_BINARY_DIR}/generated/${target}")
    get_filename_component(_stem "${G_OUT}" NAME_WE)
    set(_glsl "${_dir}/${_stem}.glsl")
    set(_ins "")
    set(_i 0)
    foreach(_p IN LISTS G_PIECES)
        list(APPEND _ins "-DIN${_i}=${_p}")
        math(EXPR _i "${_i} + 1")
    endforeach()
    set(_wrap "${CMAKE_SOURCE_DIR}/irisgl/cmake/WrapHlmsPiece.cmake")
    add_custom_command(
        OUTPUT "${_dir}/${G_OUT}"
        COMMAND ${CMAKE_COMMAND} -E make_directory "${_dir}"
        COMMAND ${CMAKE_COMMAND} -DUNWRAP=1 "-DOUT=${_glsl}" ${_ins} -P "${_wrap}"
        COMMAND ${CMAKE_COMMAND} "-DIN=${_glsl}" "-DOUT=${_dir}/${G_OUT}" "-DOUT_PARAMS=${G_OUT_PARAMS}"
                "-DARRAYS=${G_ARRAYS}" -P "${_JAH_GLSL_AS_CPP_SCRIPT}"
        DEPENDS ${G_PIECES} "${_wrap}" "${_JAH_GLSL_AS_CPP_SCRIPT}"
        COMMENT "The shipped GLSL of ${G_OUT} unwrapped and rewritten as C++ for ${target}"
        VERBATIM)
    target_sources(${target} PRIVATE "${_dir}/${G_OUT}")
    target_include_directories(${target} PRIVATE "${_dir}" "${CMAKE_SOURCE_DIR}/tests/support")
endfunction()
